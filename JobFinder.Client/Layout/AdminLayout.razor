@inherits LayoutComponentBase

<div style="min-height:100vh; background:#f9fafb; display:flex;">

    <AppSidebar Title="RecruitBoard"
                Subtitle="Administrare"
                Links="_links" />

    <main style="margin-left:256px; min-height:100vh; flex:1;">
        <div style="max-width:896px; margin:0 auto; padding:40px 32px;">
            @Body
        </div>
    </main>

</div>

@code {
    private readonly List<AppSidebar.SidebarLink> _links = new()
    {
        new() { Label = "Dashboard",   Href = "/admin/dashboard", Icon = "⊞" },
        new() { Label = "Utilizatori", Href = "/admin/users",     Icon = "◉" },
        new() { Label = "Anunțuri",    Href = "/admin/jobs",      Icon = "◈" },
        new() { Label = "Jurnal",      Href = "/admin/logs",      Icon = "≡" },
        new() { Label = "Configurări", Href = "/admin/settings",  Icon = "⚙" },
    };
}
