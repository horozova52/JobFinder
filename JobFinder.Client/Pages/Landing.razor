<style>
    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.4;
        }
    }
</style>

@code {
    private List<JobFeedItemDto> _recentJobs = new();
    private List<CategoryItem> _jobCategories = new();
    private bool _jobsLoading = true;
    private bool _statsLoading = true;
    private int _activeJobs = 0;
    private string _searchQuery = "";
    private string _filterCategory = "";
    private string _filterJobType = "";
    private string _filterEmploymentType = "";

    private readonly List<(string Icon, string Title, string Desc)> _benefits = new()
    {
        ("✓", "Matching automat pe competențe",
         "Algoritmul calculează compatibilitatea cu fiecare job în timp real"),
        ("⚡", "Statusuri în timp real",
         "Urmărești fiecare etapă a candidaturii — fără incertitudini"),
        ("🔒", "Date protejate — GDPR",
         "Confidențialitatea garantată prin mecanisme tehnice certificate"),
    };

    private readonly List<(string Icon, string Name, string Count)> _categories = new()
    {
        ("💻", "IT & Software",          "joburi IT"),
        ("🏢", "Administrativ / Oficiu", "joburi admin"),
        ("🚚", "Transport & Logistică",  "joburi transport"),
        ("📣", "Marketing & PR",         "joburi marketing"),
        ("👥", "HR & Recrutare",         "joburi HR"),
        ("⚙️", "Inginerie & Tehnic",     "joburi inginerie"),
        ("🩺", "Sănătate",              "joburi sănătate"),
        ("🎓", "Educație",              "joburi educație"),
        ("🛍️", "Vânzări & Retail",     "joburi vânzări"),
    };


    protected override async Task OnInitializedAsync()
    {
        try
        {
            var feedTask = Http.GetFromJsonAsync<List<JobFeedItemDto>>("api/jobfeed?pageSize=6");
            var statsTask = Http.GetFromJsonAsync<AdminStatsResponse>("api/jobfeed/count");
            var catsTask = Http.GetFromJsonAsync<List<CategoryItem>>("api/jobcategories");

            await Task.WhenAll(
                feedTask ?? Task.FromResult<List<JobFeedItemDto>?>(null),
                statsTask ?? Task.FromResult<AdminStatsResponse?>(null),
                catsTask ?? Task.FromResult<List<CategoryItem>?>(null));

            if (feedTask?.Result != null) _recentJobs = feedTask.Result;
            if (statsTask?.Result != null) _activeJobs = statsTask.Result.Count;
            if (catsTask?.Result != null) _jobCategories = catsTask.Result;
        }
        catch { }
        finally { _jobsLoading = false; _statsLoading = false; }
    }

    private void GoToSearch()
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(_searchQuery))
            parts.Add($"search={Uri.EscapeDataString(_searchQuery)}");

        if (!string.IsNullOrWhiteSpace(_filterJobType))
            parts.Add($"jobType={_filterJobType}");

        if (!string.IsNullOrWhiteSpace(_filterEmploymentType))
            parts.Add($"employmentType={_filterEmploymentType}");

        var url = parts.Count > 0
            ? "/jobs?" + string.Join("&", parts)
            : "/jobs";

        Navigation.NavigateTo(url);
    }

    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") GoToSearch();
    }

    private class CategoryItem
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
    }

    private class AdminStatsResponse { public int Count { get; set; } }
}
