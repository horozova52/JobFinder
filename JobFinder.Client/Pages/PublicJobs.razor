@page "/jobs"
@layout MainLayout

<PageTitle>Joburi disponibile - JobFinder</PageTitle>

<div style="max-width:1152px; margin:0 auto; padding:48px 32px;">
    <h1 style="font-size:24px; font-weight:700; letter-spacing:-0.5px;
               margin-bottom:8px; color:#111827;">
        Joburi disponibile
    </h1>
    <p style="font-size:14px; color:#6b7280; margin-bottom:32px;">
        Explorează oportunitățile de carieră. Creează un cont pentru a aplica.
    </p>
    <div style="border-bottom:1px solid #e5e7eb; margin-bottom:32px;"></div>

    @foreach (var job in _jobs)
    {
        <a href="/jobs/@job.Id"
           style="display:block; border-bottom:1px solid #e5e7eb;
                  padding:24px 16px; margin:0 -16px;
                  text-decoration:none; color:inherit;
                  transition:background 0.15s;"
           onmouseover="this.style.background='#f9fafb'"
           onmouseout="this.style.background='transparent'">
            <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                <!-- Stânga -->
                <div>
                    <h2 style="font-size:14px; font-weight:700; color:#111827; margin:0 0 4px 0;">
                        @job.Title
                    </h2>
                    <p style="font-size:14px; color:#6b7280; margin:0 0 12px 0;">
                        @job.Company · @job.Location
                    </p>
                    <div style="display:flex; gap:8px; flex-wrap:wrap;">
                        @foreach (var tag in job.Tags)
                        {
                            <span style="font-size:11px; font-weight:600; letter-spacing:1px;
                                         color:#6b7280; border:1px solid #e5e7eb;
                                         padding:2px 8px;">
                                @tag
                            </span>
                        }
                    </div>
                </div>
                <!-- Dreapta -->
                <div style="text-align:right; flex-shrink:0; margin-left:24px;">
                    <StatusBadge Status="@job.Type" />
                    <p style="font-size:12px; color:#6b7280; margin-top:8px;">@job.Date</p>
                </div>
            </div>
        </a>
    }
</div>

@code {
    private record Job(int Id, string Title, string Company, string Location,
                       string Type, string[] Tags, string Date);

    private readonly List<Job> _jobs = new()
    {
        new(1, "Frontend Developer",  "TechCorp",    "București",   "Full-time",
            new[] {"React","TypeScript","CSS"},            "2025-01-15"),
        new(2, "Backend Engineer",    "DataFlow",    "Cluj-Napoca", "Remote",
            new[] {"C#",".NET","SQL Server"},              "2025-01-14"),
        new(3, "UX Designer",         "CreativeHub", "Timișoara",   "Hybrid",
            new[] {"Figma","UX Research","Prototyping"},   "2025-01-13"),
        new(4, "DevOps Engineer",     "CloudScale",  "Remote",      "Full-time",
            new[] {"Docker","Kubernetes","CI/CD"},         "2025-01-12"),
        new(5, "Data Analyst",        "InsightCo",   "Iași",        "Full-time",
            new[] {"Python","SQL","Power BI"},             "2025-01-11"),
    };
}
