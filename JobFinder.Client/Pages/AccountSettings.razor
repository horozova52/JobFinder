@page "/account/settings"
@layout MainLayout
@rendermode InteractiveWebAssembly

<PageTitle>Setări cont - JobFinder</PageTitle>

<div style="max-width:1152px; margin:0 auto; padding:48px 32px;">
    <PageHeader Title="Setări cont" Description="Schimbă parola sau adresa de email." />

    <div style="max-width:384px; display:flex; flex-direction:column; gap:32px;">

        <!-- Email -->
        <section>
            <h2 style="font-size:14px; font-weight:700; color:#111827; margin-bottom:16px;">
                Email
            </h2>
            <MudTextField @bind-Value="_form.Email"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Margin="Margin.Dense"
                          Style="border-radius:0;" />
        </section>

        <div style="border-bottom:1px solid #e5e7eb;"></div>

        <!-- Schimbare parolă -->
        <section>
            <h2 style="font-size:14px; font-weight:700; color:#111827; margin-bottom:16px;">
                Schimbare parolă
            </h2>
            <div style="display:flex; flex-direction:column; gap:16px;">
                <div>
                    <label style="display:block; font-size:11px; font-weight:600;
                                  letter-spacing:2px; text-transform:uppercase;
                                  color:#6b7280; margin-bottom:8px;">
                        Parola curentă
                    </label>
                    <MudTextField @bind-Value="_form.CurrentPassword"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Margin="Margin.Dense"
                                  Style="border-radius:0;" />
                </div>
                <div>
                    <label style="display:block; font-size:11px; font-weight:600;
                                  letter-spacing:2px; text-transform:uppercase;
                                  color:#6b7280; margin-bottom:8px;">
                        Parola nouă
                    </label>
                    <MudTextField @bind-Value="_form.NewPassword"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Margin="Margin.Dense"
                                  Style="border-radius:0;" />
                </div>
                <div>
                    <label style="display:block; font-size:11px; font-weight:600;
                                  letter-spacing:2px; text-transform:uppercase;
                                  color:#6b7280; margin-bottom:8px;">
                        Confirmă parola nouă
                    </label>
                    <MudTextField @bind-Value="_form.ConfirmPassword"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Margin="Margin.Dense"
                                  Style="border-radius:0;" />
                </div>
            </div>
        </section>

        <div>
            <MudButton Variant="Variant.Filled"
                       OnClick="HandleSave"
                       Style="background:#111827; color:#fff; border-radius:0;
                              font-size:11px; font-weight:600; letter-spacing:2px;
                              text-transform:uppercase; padding:12px 24px;">
                Salvează modificările
            </MudButton>
        </div>
    </div>
</div>

@code {
    private SettingsForm _form = new()
    {
        Email = "ion.popescu@email.com"
    };

    private void HandleSave() { /* logica vine mai târziu */ }

    private class SettingsForm
    {
        public string Email           { get; set; } = "";
        public string CurrentPassword { get; set; } = "";
        public string NewPassword     { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
    }
}
