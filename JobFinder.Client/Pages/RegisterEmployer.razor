@page "/register/employer"
@layout MainLayout

@using JobFinder.Shared.DTOs.Identity
@using JobFinder.Shared.Enums
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using System.Text.Json

@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Înregistrare Angajator - JobFinder</PageTitle>

<div style="max-width:1152px; margin:0 auto; padding:96px 32px;">
    <div style="max-width:384px;">
        <h1 style="font-size:24px; font-weight:700; letter-spacing:-0.5px;
                   margin-bottom:8px; color:#111827;">
            Înregistrare Angajator
        </h1>
        <p style="font-size:14px; color:#6b7280; margin-bottom:32px;">
            Creează un cont pentru a publica anunțuri.
        </p>

        <EditForm Model="_form" OnValidSubmit="HandleRegister">
            <DataAnnotationsValidator />

            <div style="display:flex; flex-direction:column; gap:16px;">
                <div>
                    <label style="display:block; font-size:11px; font-weight:600;
                                  letter-spacing:2px; text-transform:uppercase;
                                  color:#6b7280; margin-bottom:8px;">Numele companiei</label>
                    <InputText @bind-Value="_form.CompanyName"
                               style="width:100%; padding:8px; border:1px solid #d1d5db; border-radius:0;" />
                    <ValidationMessage For="@(() => _form.CompanyName)" style="color:#ef4444; font-size:12px;" />
                </div>
                
                <div>
                    <label style="display:block; font-size:11px; font-weight:600;
                                  letter-spacing:2px; text-transform:uppercase;
                                  color:#6b7280; margin-bottom:8px;">Email</label>
                    <InputText @bind-Value="_form.Email" type="email"
                               style="width:100%; padding:8px; border:1px solid #d1d5db; border-radius:0;" />
                    <ValidationMessage For="@(() => _form.Email)" style="color:#ef4444; font-size:12px;" />
                </div>
                
                <div>
                    <label style="display:block; font-size:11px; font-weight:600;
                                  letter-spacing:2px; text-transform:uppercase;
                                  color:#6b7280; margin-bottom:8px;">Parolă</label>
                    <InputText @bind-Value="_form.Password" type="password"
                               style="width:100%; padding:8px; border:1px solid #d1d5db; border-radius:0;" />
                    <ValidationMessage For="@(() => _form.Password)" style="color:#ef4444; font-size:12px;" />
                </div>
                
                <div>
                    <label style="display:block; font-size:11px; font-weight:600;
                                  letter-spacing:2px; text-transform:uppercase;
                                  color:#6b7280; margin-bottom:8px;">Confirmă parola</label>
                    <InputText @bind-Value="_form.ConfirmPassword" type="password"
                               style="width:100%; padding:8px; border:1px solid #d1d5db; border-radius:0;" />
                    <ValidationMessage For="@(() => _form.ConfirmPassword)" style="color:#ef4444; font-size:12px;" />
                </div>

                <button type="submit" disabled="@_isLoading"
                        style="background:#111827; color:#fff; border:none; border-radius:0;
                               font-size:11px; font-weight:600; letter-spacing:2px;
                               text-transform:uppercase; padding:14px; margin-top:8px; cursor:pointer;
                               opacity:@(_isLoading ? 0.6 : 1);">
                    @if (_isLoading)
                    {
                        <span>Se încarcă...</span>
                    }
                    else
                    {
                        <span>Creează cont</span>
                    }
                </button>
            </div>
        </EditForm>

        <p style="font-size:12px; color:#6b7280; margin-top:24px;">
            Ai deja cont?&nbsp;
            <MudLink Href="/login" Style="color:#6366f1; font-size:12px;">
                Autentificare
            </MudLink>
        </p>
    </div>
</div>

@code {
    private RegisterForm _form = new();
    private bool _isLoading = false;

    private async Task HandleRegister()
    {
        _isLoading = true;
        try
        {
            var registerDto = new RegisterDto
            {
                Email = _form.Email,
                Password = _form.Password,
                ConfirmPassword = _form.ConfirmPassword,
                FullName = _form.CompanyName,
                UserType = UserType.Employer
            };

            var response = await Http.PostAsJsonAsync("api/auth/register", registerDto);

            if (response.IsSuccessStatusCode)
            {
                var jsonContent = await response.Content.ReadAsStringAsync();
                var result = JsonSerializer.Deserialize<AuthResponseDto>(jsonContent,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                Snackbar.Add("Înregistrare reușită! Redirecționare...", Severity.Success);
                await Task.Delay(1500);
                Navigation.NavigateTo("/employer/dashboard");
            }
            else
            {
                try
                {
                    var jsonContent = await response.Content.ReadAsStringAsync();
                    var errorResponse = JsonSerializer.Deserialize<Dictionary<string, object>>(jsonContent,
                        new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    var errorMessage = errorResponse?.ContainsKey("message") == true
                        ? errorResponse["message"]?.ToString()
                        : "Eroare la înregistrare. Încercați din nou.";

                    Snackbar.Add(errorMessage ?? "Eroare la înregistrare.", Severity.Error);
                }
                catch
                {
                    Snackbar.Add("Eroare la înregistrare. Încercați din nou.", Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Eroare: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private class RegisterForm
    {
        [Required(ErrorMessage = "Numele companiei este obligatoriu")]
        [StringLength(200)]
        public string CompanyName { get; set; } = "";

        [Required(ErrorMessage = "Email-ul este obligatoriu")]
        [EmailAddress(ErrorMessage = "Email invalid")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Parola este obligatorie")]
        [StringLength(100, MinimumLength = 6, ErrorMessage = "Parola trebuie să aibă între 6 și 100 caractere")]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Confirmare parolă obligatorie")]
        [Compare("Password", ErrorMessage = "Parolele nu coincid")]
        public string ConfirmPassword { get; set; } = "";
    }
}
