@page "/candidate/applications/{Id:int}"
@layout CandidateLayout

<PageTitle>Detalii aplicare - JobFinder</PageTitle>

<a href="/candidate/applications"
   style="font-size:12px; font-weight:600; letter-spacing:1px; text-transform:uppercase;
          color:#6b7280; text-decoration:none; display:inline-block; margin-bottom:24px;">
    ← Înapoi la aplicări
</a>

<!-- Header -->
<div style="display:flex; justify-content:space-between; align-items:flex-start;
            margin-top:16px; margin-bottom:8px;">
    <h1 style="font-size:24px; font-weight:700; color:#111827; margin:0;">
        Frontend Developer
    </h1>
    <StatusBadge Status="În analiză" Variant="warning" />
</div>
<p style="font-size:14px; color:#6b7280; margin:0 0 32px 0;">
    DataFlow · Aplicat pe 10 ianuarie 2025
</p>

<div style="border-bottom:1px solid #e5e7eb; margin-bottom:32px;"></div>

<!-- Timeline -->
<section style="margin-bottom:40px;">
    <h2 style="font-size:14px; font-weight:700; color:#111827; margin-bottom:16px;">
        Istoric status
    </h2>
    @foreach (var step in _timeline)
    {
        <div style="display:flex; align-items:center; gap:16px; margin-bottom:12px;">
            <div style="width:8px; height:8px; border-radius:50%; flex-shrink:0;
                        background:@(step.Active ? "#6366f1" : "#e5e7eb");"></div>
            <p style="font-size:14px; margin:0;
                      font-weight:@(step.Active ? "600" : "400");
                      color:@(step.Active ? "#111827" : "#6b7280");">
                @step.Status
            </p>
            <p style="font-size:12px; color:#6b7280; margin:0 0 0 auto;">@step.Date</p>
        </div>
    }
</section>

<div style="border-bottom:1px solid #e5e7eb; margin-bottom:32px;"></div>

<!-- Chat -->
<section>
    <h2 style="font-size:14px; font-weight:700; color:#111827; margin-bottom:16px;">
        Mesagerie
    </h2>

    <div style="display:flex; flex-direction:column; gap:16px; margin-bottom:24px;">
        <!-- Mesaj angajator -->
        <div style="border:1px solid #e5e7eb; padding:16px;">
            <p style="font-size:11px; font-weight:600; color:#6b7280; margin:0 0 4px 0;">
                DataFlow — 12 Ian
            </p>
            <p style="font-size:14px; color:#111827; margin:0;">
                Bună ziua! Am primit aplicarea dumneavoastră și este în curs de analiză.
            </p>
        </div>
        <!-- Mesaj propriu -->
        <div style="border:1px solid #c7d2fe; background:#ede9fe; padding:16px;">
            <p style="font-size:11px; font-weight:600; color:#6366f1; margin:0 0 4px 0;">
                Tu — 12 Ian
            </p>
            <p style="font-size:14px; color:#111827; margin:0;">
                Mulțumesc! Aștept cu interes un răspuns.
            </p>
        </div>
    </div>

    <div style="display:flex; gap:12px;">
        <MudTextField @bind-Value="_message"
                      Placeholder="Scrie un mesaj..."
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Margin="Margin.Dense"
                      Style="border-radius:0; flex:1;" />
        <MudButton Variant="Variant.Filled" OnClick="SendMessage"
                   Style="background:#6366f1; color:#fff; border-radius:0;
                          font-size:11px; font-weight:600; letter-spacing:2px;
                          text-transform:uppercase; padding:0 24px; flex-shrink:0;">
            Trimite
        </MudButton>
    </div>
</section>

@code {
    [Parameter] public int Id { get; set; }

    private string _message = "";

    private record TimelineStep(string Status, string Date, bool Active);

    private readonly List<TimelineStep> _timeline = new()
    {
        new("Aplicare trimisă", "10 Ian 2025", false),
        new("În analiză",       "12 Ian 2025", true),
        new("Interviu",         "—",           false),
        new("Decizie",          "—",           false),
    };

    private void SendMessage() { _message = ""; }
}
