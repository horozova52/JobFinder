@page "/candidate/messages"
@page "/candidate/messages/{ConversationId:int}"
@layout CandidateLayout
@using JobFinder.Shared.DTOs.Messaging
@using Microsoft.AspNetCore.SignalR.Client
@inject HttpClient Http
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>Mesagerie - JobFinder</PageTitle>

<PageHeader Title="Mesagerie"
            Description="Conversațiile tale cu angajatorii." />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (!_conversations.Any())
{
    <div style="text-align:center; padding:60px 20px;">
        <p style="font-size:14px; color:#6b7280;">
            Nu ai conversații încă. Aplică la un job pentru a putea discuta cu angajatorul.
        </p>
    </div>
}
else
{
    <div style="display:flex; border:1px solid #e5e7eb; height:520px; background:#fff;">
        @* Left panel — conversation list *@
        <div style="width:320px; border-right:1px solid #e5e7eb; overflow-y:auto; flex-shrink:0;">
            @foreach (var conv in _conversations)
            {
                var isActive = _selectedConversation?.Id == conv.Id;
                <div @onclick="() => SelectConversation(conv)"
                     style="padding:14px 16px; border-bottom:1px solid #e5e7eb; cursor:pointer;
                            background:@(isActive ? "#f0f0ff" : "transparent");
                            transition:background 0.15s;"
                     @onmouseover="@(e => {})" @onmouseout="@(e => {})">
                    <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                        <div style="min-width:0; flex:1;">
                            <div style="display:flex; align-items:center; gap:6px;">
                                <span style="font-size:13px; font-weight:@(conv.UnreadCount > 0 ? "700" : "500");
                                             color:#111827; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                    @conv.OtherPartyName
                                </span>
                                @if (conv.UnreadCount > 0)
                                {
                                    <span style="background:#6366f1; color:#fff; font-size:10px; font-weight:700;
                                                 min-width:18px; height:18px; border-radius:9px; display:inline-flex;
                                                 align-items:center; justify-content:center; padding:0 5px; flex-shrink:0;">
                                        @conv.UnreadCount
                                    </span>
                                }
                            </div>
                            <p style="font-size:11px; color:#6b7280; margin:2px 0 0 0;">@conv.JobTitle</p>
                            @if (!string.IsNullOrEmpty(conv.LastMessage))
                            {
                                <p style="font-size:12px; color:#9ca3af; margin:4px 0 0 0;
                                          overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:220px;">
                                    @conv.LastMessage
                                </p>
                            }
                        </div>
                        <span style="font-size:11px; color:#9ca3af; flex-shrink:0; margin-left:8px;">
                            @FormatTime(conv.LastMessageAt)
                        </span>
                    </div>
                </div>
            }
        </div>

        @* Right panel — messages *@
        <div style="flex:1; display:flex; flex-direction:column; min-width:0;">
            @if (_selectedConversation == null)
            {
                <div style="flex:1; display:flex; align-items:center; justify-content:center;">
                    <p style="font-size:14px; color:#9ca3af;">Selectează o conversație</p>
                </div>
            }
            else
            {
                @* Header *@
                <div style="padding:12px 16px; border-bottom:1px solid #e5e7eb; background:#fafafa;">
                    <span style="font-size:14px; font-weight:600; color:#111827;">
                        @_selectedConversation.OtherPartyName
                    </span>
                    <span style="font-size:12px; color:#6b7280; margin-left:8px;">
                        @_selectedConversation.JobTitle
                    </span>
                </div>

                @* Messages area *@
                <div id="messagesContainer" style="flex:1; overflow-y:auto; padding:16px; display:flex; flex-direction:column; gap:8px;">
                    @if (_loadingMessages)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    }
                    else if (!_messages.Any())
                    {
                        <div style="flex:1; display:flex; align-items:center; justify-content:center;">
                            <p style="font-size:13px; color:#9ca3af;">Niciun mesaj încă. Trimite primul mesaj!</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var msg in _messages)
                        {
                            <div style="display:flex; justify-content:@(msg.IsMine ? "flex-end" : "flex-start");">
                                <div style="max-width:70%; padding:10px 14px;
                                            background:@(msg.IsMine ? "#6366f1" : "#f3f4f6");
                                            color:@(msg.IsMine ? "#ffffff" : "#111827");
                                            border-radius:@(msg.IsMine ? "16px 16px 4px 16px" : "16px 16px 16px 4px");">
                                    <p style="font-size:13px; margin:0; word-break:break-word; white-space:pre-wrap;">@msg.Content</p>
                                    <p style="font-size:10px; margin:4px 0 0 0;
                                              color:@(msg.IsMine ? "rgba(255,255,255,0.7)" : "#9ca3af");
                                              text-align:@(msg.IsMine ? "right" : "left");">
                                        @msg.SentAt.ToLocalTime().ToString("HH:mm")
                                    </p>
                                </div>
                            </div>
                        }
                    }
                </div>

                @* Input *@
                <div style="padding:12px 16px; border-top:1px solid #e5e7eb; display:flex; gap:8px; align-items:center;">
                    <MudTextField @bind-Value="_newMessage"
                                  Placeholder="Scrie un mesaj..."
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Style="flex:1;"
                                  Immediate="true"
                                  OnKeyDown="HandleKeyDown" />
                    <MudIconButton Icon="@Icons.Material.Filled.Send"
                                   Color="Color.Primary"
                                   OnClick="SendMessage"
                                   Disabled="@(string.IsNullOrWhiteSpace(_newMessage))" />
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int? ConversationId { get; set; }

    private bool _loading = true;
    private bool _loadingMessages;
    private List<ConversationDto> _conversations = new();
    private ConversationDto? _selectedConversation;
    private List<MessageDto> _messages = new();
    private string _newMessage = "";
    private HubConnection? _hubConnection;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _conversations = await Http.GetFromJsonAsync<List<ConversationDto>>("api/messages/conversations") ?? new();
        }
        catch { }
        finally
        {
            _loading = false;
        }

        _hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/hubs/chat"))
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<MessageDto>("ReceiveMessage", async (msg) =>
        {
            if (_selectedConversation != null && msg.ConversationId == _selectedConversation.Id)
            {
                msg.IsMine = false;
                _messages.Add(msg);
                await InvokeAsync(StateHasChanged);
            }

            var conv = _conversations.FirstOrDefault(c => c.Id == msg.ConversationId);
            if (conv != null)
            {
                conv.LastMessage = msg.Content;
                conv.LastMessageAt = msg.SentAt;
                if (_selectedConversation == null || _selectedConversation.Id != msg.ConversationId)
                    conv.UnreadCount++;
                await InvokeAsync(StateHasChanged);
            }
        });

        try
        {
            await _hubConnection.StartAsync();
        }
        catch { }

        if (ConversationId.HasValue)
        {
            var conv = _conversations.FirstOrDefault(c => c.Id == ConversationId.Value);
            if (conv != null)
                await SelectConversation(conv);
        }
    }

    private async Task SelectConversation(ConversationDto conv)
    {
        _selectedConversation = conv;
        _loadingMessages = true;
        _messages.Clear();
        StateHasChanged();

        try
        {
            _messages = await Http.GetFromJsonAsync<List<MessageDto>>($"api/messages/conversations/{conv.Id}") ?? new();

            if (conv.UnreadCount > 0)
            {
                conv.UnreadCount = 0;
                _ = Http.PutAsync($"api/messages/read/{conv.Id}", null);
                if (_hubConnection?.State == HubConnectionState.Connected)
                    _ = _hubConnection.InvokeAsync("MarkAsRead", conv.Id);
            }

            if (_hubConnection?.State == HubConnectionState.Connected)
                await _hubConnection.InvokeAsync("JoinConversation", conv.Id);
        }
        catch { }
        finally
        {
            _loadingMessages = false;
            StateHasChanged();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await SendMessage();
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_newMessage) || _selectedConversation == null) return;

        var content = _newMessage.Trim();
        _newMessage = "";

        try
        {
            if (_hubConnection?.State == HubConnectionState.Connected)
            {
                await _hubConnection.InvokeAsync("SendMessage", _selectedConversation.Id, content);
                _messages.Add(new MessageDto
                {
                    ConversationId = _selectedConversation.Id,
                    Content = content,
                    SentAt = DateTime.UtcNow,
                    IsMine = true
                });
            }
            else
            {
                var dto = new SendMessageDto { ConversationId = _selectedConversation.Id, Content = content };
                var response = await Http.PostAsJsonAsync("api/messages/send", dto);
                if (response.IsSuccessStatusCode)
                {
                    var msg = await response.Content.ReadFromJsonAsync<MessageDto>();
                    if (msg != null)
                        _messages.Add(msg);
                }
            }

            _selectedConversation.LastMessage = content;
            _selectedConversation.LastMessageAt = DateTime.UtcNow;
            StateHasChanged();
        }
        catch { }
    }

    private string FormatTime(DateTime? dt)
    {
        if (dt == null) return "";
        var local = dt.Value.ToLocalTime();
        var now = DateTime.Now;
        var diff = now - local;

        if (diff.TotalMinutes < 1) return "acum";
        if (diff.TotalMinutes < 60) return $"acum {(int)diff.TotalMinutes} min";
        if (diff.TotalHours < 24 && local.Date == now.Date) return local.ToString("HH:mm");
        if (local.Date == now.Date.AddDays(-1)) return "ieri";
        return local.ToString("dd MMM");
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection != null)
            await _hubConnection.DisposeAsync();
    }
}
