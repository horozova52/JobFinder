@page "/candidate/messages"
@layout CandidateLayout
@rendermode InteractiveWebAssembly

<PageTitle>Mesagerie - JobFinder</PageTitle>

<PageHeader Title="Mesagerie"
            Description="Conversațiile tale cu angajatorii." />

@foreach (var conv in _conversations)
{
    <a href="/candidate/applications/@conv.Id"
       style="display:block; border-bottom:1px solid #e5e7eb; padding:20px 16px;
              margin:0 -16px; text-decoration:none; color:inherit; transition:background 0.15s;"
       onmouseover="this.style.background='#f9fafb'"
       onmouseout="this.style.background='transparent'">
        <div style="display:flex; justify-content:space-between; align-items:flex-start;">
            <div>
                <h3 style="font-size:14px; margin:0 0 4px 0;
                           font-weight:@(conv.Unread ? "700" : "400");
                           color:@(conv.Unread ? "#111827" : "#6b7280");">
                    @conv.Company
                </h3>
                <p style="font-size:14px; color:#6b7280; margin:0;
                          max-width:500px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                    @conv.LastMessage
                </p>
            </div>
            <div style="display:flex; align-items:center; gap:8px; flex-shrink:0; margin-left:24px;">
                <p style="font-size:12px; color:#6b7280; margin:0;">@conv.Date</p>
                @if (conv.Unread)
                {
                    <div style="width:8px; height:8px; border-radius:50%; background:#6366f1;"></div>
                }
            </div>
        </div>
    </a>
}

@code {
    private record Conversation(int Id, string Company,
                                string LastMessage, string Date, bool Unread);

    private readonly List<Conversation> _conversations = new()
    {
        new(1, "DataFlow",  "Am primit aplicarea dumneavoastră...", "12 Ian", true),
        new(2, "DesignLab", "Vă invităm la un interviu tehnic...", "10 Ian", true),
        new(3, "StartupX",  "Felicitări! Ați fost acceptat.",      "8 Ian",  false),
    };
}
