@page "/candidate/jobs"
@layout CandidateLayout

@using JobFinder.Shared.DTOs.Jobs
@using System.Net.Http.Json
@using System.Text.Json

@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Căutare joburi - JobFinder</PageTitle>

<PageHeader Title="Căutare joburi"
            Description="Joburi ordonate după compatibilitatea cu profilul tău." />

@* ── Filtre ── *@
<div style="display:flex; gap:12px; margin-bottom:32px; flex-wrap:wrap;">

    <MudTextField @bind-Value="_search"
                  Placeholder="Caută după titlu, companie, locație..."
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Style="border-radius:0; flex:1; min-width:200px;"
                  OnKeyUp="OnSearchKeyUp" />

    <MudSelect @bind-Value="_filterJobType"
               Placeholder="Mod de lucru"
               Variant="Variant.Outlined"
               Margin="Margin.Dense"
               Clearable="true"
               Style="border-radius:0; min-width:160px;"
               T="string">
        <MudSelectItem Value="@("")">Toate modurile</MudSelectItem>
        <MudSelectItem Value="@("Remote")">Remote</MudSelectItem>
        <MudSelectItem Value="@("OnSite")">La birou</MudSelectItem>
        <MudSelectItem Value="@("Hybrid")">Hibrid</MudSelectItem>
    </MudSelect>

    <MudSelect @bind-Value="_filterEmploymentType"
               Placeholder="Tip angajare"
               Variant="Variant.Outlined"
               Margin="Margin.Dense"
               Clearable="true"
               Style="border-radius:0; min-width:160px;"
               T="string">
        <MudSelectItem Value="@("")">Toate tipurile</MudSelectItem>
        <MudSelectItem Value="@("FullTime")">Full-time</MudSelectItem>
        <MudSelectItem Value="@("PartTime")">Part-time</MudSelectItem>
        <MudSelectItem Value="@("Internship")">Internship</MudSelectItem>
        <MudSelectItem Value="@("Freelance")">Freelance</MudSelectItem>
        <MudSelectItem Value="@("Contract")">Contract</MudSelectItem>
    </MudSelect>

    <MudButton Variant="Variant.Filled"
               OnClick="LoadJobs"
               Style="background:#6366f1; color:#fff; border-radius:0;
                      font-size:11px; font-weight:600; letter-spacing:2px;
                      text-transform:uppercase; padding:0 20px; height:40px;">
        Caută
    </MudButton>
</div>

@* ── Loading skeleton ── *@
@if (_isLoading)
{
    <style>
        @@keyframes shimmer {
            0%   { background-position: -800px 0; }
            100% { background-position:  800px 0; }
        }
        .skeleton {
            background: linear-gradient(90deg, #f3f4f6 25%, #e9eaec 50%, #f3f4f6 75%);
            background-size: 800px 100%;
            animation: shimmer 1.4s infinite;
            border-radius: 4px;
        }
    </style>
    <div style="display:flex; flex-direction:column; gap:16px;">
        @for (int i = 0; i < 5; i++)
        {
            <div style="border:1px solid #e5e7eb; padding:24px;">
                <div class="skeleton" style="height:16px; width:40%; margin-bottom:10px;"></div>
                <div class="skeleton" style="height:12px; width:25%; margin-bottom:14px;"></div>
                <div style="display:flex; gap:8px;">
                    <div class="skeleton" style="height:22px; width:64px;"></div>
                    <div class="skeleton" style="height:22px; width:80px;"></div>
                    <div class="skeleton" style="height:22px; width:72px;"></div>
                </div>
            </div>
        }
    </div>
}
else if (_jobs.Count == 0)
{
    <div style="text-align:center; padding:64px 0;">
        <MudIcon Icon="@Icons.Material.Outlined.WorkOff"
                 Style="font-size:64px; color:#d1d5db; margin-bottom:16px;" />
        <MudText Typo="Typo.h6" Style="color:#6b7280; margin-bottom:8px;">
            Niciun job găsit
        </MudText>
        <MudText Typo="Typo.body2" Style="color:#9ca3af;">
            Încearcă să modifici filtrele sau caută alt termen.
        </MudText>
    </div>
}
else
{
    @* ── Sumar rezultate ── *@
    <div style="display:flex; justify-content:space-between; align-items:center;
                margin-bottom:16px;">
        <MudText Typo="Typo.caption"
                 Style="color:#6b7280; font-weight:600; letter-spacing:1px; text-transform:uppercase;">
            @_jobs.Count oferte găsite
        </MudText>
        @if (_hasMatchData)
        {
            <MudText Typo="Typo.caption" Style="color:#6366f1; font-weight:600;">
                ✦ Sortate după compatibilitate cu profilul tău
            </MudText>
        }
    </div>

    @* ── Lista joburi ── *@
    @foreach (var job in _jobs)
    {
        <div @onclick="() => GoToJob(job.Id)"
             style="border-bottom:1px solid #e5e7eb; padding:24px 16px;
                    margin:0 -16px; cursor:pointer; transition:background 0.15s;"
             onmouseover="this.style.background='#f9fafb'"
             onmouseout="this.style.background='transparent'">

            <div style="display:flex; justify-content:space-between;
                        align-items:flex-start; gap:16px;">

                @* ── Stânga ── *@
                <div style="flex:1; min-width:0;">

                    @* Logo + Titlu + Companie *@
                    <div style="display:flex; align-items:center; gap:10px; margin-bottom:6px;">
                        @if (!string.IsNullOrWhiteSpace(job.CompanyLogoUrl))
                        {
                            <img src="@job.CompanyLogoUrl" alt="@job.CompanyName"
                                 style="width:36px; height:36px; object-fit:cover;
                                        border:1px solid #e5e7eb; flex-shrink:0;" />
                        }
                        else
                        {
                            <div style="width:36px; height:36px; background:#ede9fe;
                                        display:flex; align-items:center; justify-content:center;
                                        font-size:13px; font-weight:700; color:#6366f1;
                                        flex-shrink:0; border:1px solid #e5e7eb;">
                                @(job.CompanyName.Length >= 2
                                    ? job.CompanyName[..2].ToUpper()
                                    : job.CompanyName.ToUpper())
                            </div>
                        }
                        <div>
                            <h2 style="font-size:14px; font-weight:700;
                                       color:#111827; margin:0 0 2px 0;">
                                @job.Title
                            </h2>
                            <p style="font-size:13px; color:#6b7280; margin:0;">
                                @job.CompanyName
                                @if (!string.IsNullOrWhiteSpace(job.Location))
                                {
                                    <span> · @job.Location</span>
                                }
                            </p>
                        </div>
                    </div>

                    @* Meta: tip + angajare + salariu *@
                    <div style="display:flex; gap:8px; flex-wrap:wrap;
                                margin:8px 0; align-items:center;">
                        <span style="font-size:11px; font-weight:600; color:#6b7280;
                                     border:1px solid #e5e7eb; padding:2px 8px;">
                            @job.JobType
                        </span>
                        <span style="font-size:11px; font-weight:600; color:#6b7280;
                                     border:1px solid #e5e7eb; padding:2px 8px;">
                            @job.EmploymentType
                        </span>
                        @if (job.SalaryFrom.HasValue || job.SalaryTo.HasValue)
                        {
                            <span style="font-size:11px; font-weight:600;
                                         color:#6366f1; background:#ede9fe; padding:2px 8px;">
                                @FormatSalary(job)
                            </span>
                        }
                        else if (job.IsSalaryNegotiable)
                        {
                            <span style="font-size:11px; color:#9ca3af;
                                         font-style:italic; padding:2px 0;">
                                Salariu negociabil
                            </span>
                        }
                    </div>

                    @* Skills *@
                    @if (job.SkillNames.Any())
                    {
                        <div style="display:flex; gap:6px; flex-wrap:wrap; margin-top:6px;">
                            @foreach (var skill in job.SkillNames.Take(5))
                            {
                                var isMatched = _candidateSkills.Contains(skill);
                                <span style="font-size:11px; font-weight:600; padding:2px 8px;
                                             @(isMatched
                                                 ? "background:#ede9fe; color:#6366f1; border:1px solid #c4b5fd;"
                                                 : "color:#6b7280; border:1px solid #e5e7eb;")">
                                    @(isMatched ? "✓ " : "")@skill
                                </span>
                            }
                            @if (job.SkillNames.Count > 5)
                            {
                                <span style="font-size:11px; color:#9ca3af; padding:2px 4px;">
                                    +@(job.SkillNames.Count - 5)
                                </span>
                            }
                        </div>
                    }
                </div>

                @* ── Dreapta: match + dată ── *@
                <div style="display:flex; flex-direction:column;
                            align-items:flex-end; gap:8px; flex-shrink:0;">

                    @if (_hasMatchData && job.TotalSkillsRequired > 0)
                    {
                        <div style="text-align:center;">
                            <div style="@(GetMatchStyle(job.MatchScore) + "font-size:15px; font-weight:700; width:52px; height:52px; display:flex; align-items:center; justify-content:center; border-radius:4px;")">
                                @job.MatchScore%
                            </div>
                            <p style="font-size:10px; color:#9ca3af;
                                      margin:3px 0 0 0; text-align:center;">
                                match
                            </p>
                        </div>
                    }

                    @if (job.PublishedAt.HasValue)
                    {
                        <p style="font-size:11px; color:#9ca3af; margin:0; white-space:nowrap;">
                            @FormatDate(job.PublishedAt.Value)
                        </p>
                    }
                </div>
            </div>
        </div>
    }
}

@code {
    private List<JobFeedItemDto> _jobs           = new();
    private HashSet<string>      _candidateSkills = new(StringComparer.OrdinalIgnoreCase);
    private bool   _isLoading             = true;
    private bool   _hasMatchData          = false;
    private string _search                = "";
    private string _filterJobType         = "";
    private string _filterEmploymentType  = "";

    protected override async Task OnInitializedAsync()
        => await LoadJobs();

    private async Task LoadJobs()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            var query = new List<string>();
            if (!string.IsNullOrWhiteSpace(_search))
                query.Add($"search={Uri.EscapeDataString(_search)}");
            if (!string.IsNullOrWhiteSpace(_filterJobType))
                query.Add($"jobType={_filterJobType}");
            if (!string.IsNullOrWhiteSpace(_filterEmploymentType))
                query.Add($"employmentType={_filterEmploymentType}");

            var url = "api/jobfeed" +
                      (query.Count > 0 ? "?" + string.Join("&", query) : "");

            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var result = JsonSerializer.Deserialize<FeedResult>(json,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                _jobs = result?.Items ?? new();

                // FIX: Skills-urile candidatului vin direct din răspuns
                // (matchedSkillsCount > 0 înseamnă că serverul a calculat matching)
                // Colectăm toate skill-urile candidate din joburile cu match
                _candidateSkills.Clear();
                if (_jobs.Any(j => j.MatchScore > 0))
                {
                    // Serverul returnează skillNames ordonate — cele matched sunt primele
                    foreach (var job in _jobs.Where(j => j.MatchedSkillsCount > 0))
                    {
                        foreach (var skill in job.SkillNames.Take(job.MatchedSkillsCount))
                            _candidateSkills.Add(skill);
                    }
                }

                _hasMatchData = _jobs.Any(j => j.MatchScore > 0);
            }
        }
        catch { /* tratare erori în producție */ }
        finally
        {
            _isLoading = false;
        }
    }

    // FIX: tipul corect pentru MudBlazor OnKeyUp
    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await LoadJobs();
    }

    private void GoToJob(int id)
        => Navigation.NavigateTo($"/candidate/jobs/{id}");

    // ── Helpers ──────────────────────────────────────────────────────

    // FIX: guard pentru ambele null
    private static string FormatSalary(JobFeedItemDto job)
    {
        if (job.SalaryFrom.HasValue && job.SalaryTo.HasValue)
            return $"{job.SalaryFrom:N0} – {job.SalaryTo:N0} MDL";
        if (job.SalaryFrom.HasValue)
            return $"de la {job.SalaryFrom:N0} MDL";
        if (job.SalaryTo.HasValue)
            return $"până la {job.SalaryTo:N0} MDL";
        return "";
    }

    private static string FormatDate(DateTime date)
    {
        var days = (DateTime.UtcNow - date).TotalDays;
        return (days switch
        {
            < 1  => "Azi",
            < 2  => "Ieri",
            < 7  => $"Acum {(int)days} zile",
            < 30 => $"Acum {(int)(days / 7)} săpt.",
            _    => date.ToString("dd.MM.yyyy")
        });
    }

    private static string GetMatchStyle(int score) => (score switch
    {
        >= 80 => "background:#dcfce7; color:#16a34a;",
        >= 50 => "background:#fef9c3; color:#ca8a04;",
        >= 20 => "background:#ede9fe; color:#6366f1;",
        _     => "background:#f3f4f6; color:#6b7280;"
    });

    // ── DTO local pentru deserializare răspuns feed ──────────────────
    private sealed class FeedResult
    {
        public List<JobFeedItemDto> Items { get; set; } = new();
        public int TotalCount { get; set; }
    }
}
