@page "/candidate/dashboard"
@layout CandidateLayout

@using JobFinder.Shared.DTOs.Applications
@using JobFinder.Shared.DTOs.Jobs
@using JobFinder.Shared.DTOs.Candidates
@using JobFinder.Shared.Enums
@using System.Net.Http.Json

@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Dashboard - JobFinder</PageTitle>

@if (_loading)
{
    <!-- Skeleton loading -->
    <div style="display:flex; flex-direction:column; gap:24px;">
        <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:16px;">
            @for (int i = 0; i < 4; i++)
            {
                <div style="height:90px; border-radius:12px;
                            background:linear-gradient(90deg,#f3f4f6 25%,#e9eaec 50%,#f3f4f6 75%);
                            background-size:800px 100%; animation:shimmer 1.4s infinite;"></div>
            }
        </div>
        <div style="height:80px; border-radius:12px;
                    background:linear-gradient(90deg,#f3f4f6 25%,#e9eaec 50%,#f3f4f6 75%);
                    background-size:800px 100%; animation:shimmer 1.4s infinite;"></div>
        <div style="height:200px; border-radius:12px;
                    background:linear-gradient(90deg,#f3f4f6 25%,#e9eaec 50%,#f3f4f6 75%);
                    background-size:800px 100%; animation:shimmer 1.4s infinite;"></div>
    </div>
}
else
{
    <!-- ══════════════════════════════════════
         TITLU
    ══════════════════════════════════════ -->
    <div style="margin-bottom:28px;">
        <h1 style="font-size:22px; font-weight:700; color:#111827; margin:0 0 4px 0;">
            Prezentare generală
        </h1>
    </div>

    <!-- ══════════════════════════════════════
         STATISTICI — 4 carduri cu iconițe
    ══════════════════════════════════════ -->
    <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:24px;">

        <!-- Total aplicări -->
        <div style="background:#fff; border:1px solid #e5e7eb; border-radius:12px;
                    padding:20px 24px; display:flex; justify-content:space-between; align-items:center;">
            <div>
                <p style="font-size:11px; font-weight:600; color:#9ca3af; text-transform:uppercase;
                          letter-spacing:1px; margin:0 0 6px 0;">Total aplicări</p>
                <p style="font-size:32px; font-weight:700; color:#111827; margin:0; line-height:1;">
                    @_stats.Total
                </p>
            </div>
            <div style="width:44px; height:44px; background:#f0eeff; border-radius:10px;
                        display:flex; align-items:center; justify-content:center;">
                <MudIcon Icon="@Icons.Material.Filled.Work" Style="color:#6366f1; font-size:22px;" />
            </div>
        </div>

        <!-- În analiză -->
        <div style="background:#fff; border:1px solid #e5e7eb; border-radius:12px;
                    padding:20px 24px; display:flex; justify-content:space-between; align-items:center;">
            <div>
                <p style="font-size:11px; font-weight:600; color:#9ca3af; text-transform:uppercase;
                          letter-spacing:1px; margin:0 0 6px 0;">În analiză</p>
                <p style="font-size:32px; font-weight:700; color:#111827; margin:0; line-height:1;">
                    @_stats.InReview
                </p>
            </div>
            <div style="width:44px; height:44px; background:#fff7ed; border-radius:10px;
                        display:flex; align-items:center; justify-content:center;">
                <MudIcon Icon="@Icons.Material.Filled.HourglassEmpty" Style="color:#f97316; font-size:22px;" />
            </div>
        </div>

        <!-- Interviuri -->
        <div style="background:#fff; border:1px solid #e5e7eb; border-radius:12px;
                    padding:20px 24px; display:flex; justify-content:space-between; align-items:center;">
            <div>
                <p style="font-size:11px; font-weight:600; color:#9ca3af; text-transform:uppercase;
                          letter-spacing:1px; margin:0 0 6px 0;">Interviuri</p>
                <p style="font-size:32px; font-weight:700; color:#111827; margin:0; line-height:1;">
                    @_stats.Interview
                </p>
            </div>
            <div style="width:44px; height:44px; background:#eff6ff; border-radius:10px;
                        display:flex; align-items:center; justify-content:center;">
                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Style="color:#3b82f6; font-size:22px;" />
            </div>
        </div>

        <!-- Acceptate -->
        <div style="background:#fff; border:1px solid #e5e7eb; border-radius:12px;
                    padding:20px 24px; display:flex; justify-content:space-between; align-items:center;">
            <div>
                <p style="font-size:11px; font-weight:600; color:#9ca3af; text-transform:uppercase;
                          letter-spacing:1px; margin:0 0 6px 0;">Acceptate</p>
                <p style="font-size:32px; font-weight:700; color:#111827; margin:0; line-height:1;">
                    @_stats.Accepted
                </p>
            </div>
            <div style="width:44px; height:44px; background:#f0fdf4; border-radius:10px;
                        display:flex; align-items:center; justify-content:center;">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color:#22c55e; font-size:22px;" />
            </div>
        </div>
    </div>

    <!-- ══════════════════════════════════════
         BANNER COMPLETARE PROFIL
    ══════════════════════════════════════ -->
    @if (_completionPct < 100)
    {
        <div style="background:linear-gradient(135deg,#6366f1 0%,#818cf8 100%);
                    border-radius:16px; padding:24px 32px; margin-bottom:24px;
                    display:flex; align-items:center; justify-content:space-between; gap:24px;">
            <div style="display:flex; align-items:center; gap:20px;">
                <!-- Cerc procentaj -->
                <div style="position:relative; width:56px; height:56px; flex-shrink:0;">
                    <svg width="56" height="56" viewBox="0 0 56 56">
                        <circle cx="28" cy="28" r="24" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="4"/>
                        <circle cx="28" cy="28" r="24" fill="none" stroke="white" stroke-width="4"
                                stroke-dasharray="@(Math.Round(2 * Math.PI * 24 * _completionPct / 100, 1)) 999"
                                stroke-linecap="round" transform="rotate(-90 28 28)"/>
                    </svg>
                    <span style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
                                 font-size:11px; font-weight:700; color:#fff;">
                        @_completionPct%
                    </span>
                </div>
                <div>
                    <p style="font-size:15px; font-weight:700; color:#fff; margin:0 0 4px 0;">
                        Completează-ți profilul
                    </p>
                    <p style="font-size:13px; color:rgba(255,255,255,0.8); margin:0;">
                        Un profil complet crește șansele de a fi remarcat de angajatori
                    </p>
                </div>
            </div>
            <a href="/candidate/profile"
               style="display:inline-block; background:#fff; color:#6366f1;
                      font-size:12px; font-weight:700; letter-spacing:1px; text-transform:uppercase;
                      padding:12px 24px; border-radius:8px; text-decoration:none; white-space:nowrap;
                      flex-shrink:0;">
                Completează profilul
            </a>
        </div>
    }

    <!-- ══════════════════════════════════════
         ACTIVITATEA MEA (aplicări recente)
    ══════════════════════════════════════ -->
    <div style="background:#fff; border:1px solid #e5e7eb; border-radius:16px;
                padding:24px; margin-bottom:24px;">

        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
            <h2 style="font-size:16px; font-weight:700; color:#111827; margin:0;
                       padding-left:12px; border-left:3px solid #6366f1;">
                Activitatea mea
            </h2>
            @if (_recentApplications.Count > 0)
            {
                <a href="/candidate/applications"
                   style="font-size:12px; font-weight:600; color:#6366f1;
                          text-decoration:none;">
                    Vezi tot istoricul →
                </a>
            }
        </div>

        @if (_recentApplications.Count == 0)
        {
            <div style="text-align:center; padding:32px 0;">
                <MudIcon Icon="@Icons.Material.Filled.Inbox"
                         Style="font-size:40px; color:#d1d5db; display:block; margin:0 auto 12px;" />
                <p style="font-size:14px; color:#9ca3af; margin:0 0 12px 0;">
                    Nu ai aplicat încă la niciun job.
                </p>
                <a href="/candidate/jobs"
                   style="font-size:12px; font-weight:600; color:#6366f1; text-decoration:none;">
                    Explorează joburi →
                </a>
            </div>
        }
        else
        {
            @foreach (var app in _recentApplications)
            {
                <a href="/candidate/applications/@app.Id"
                   style="display:flex; align-items:center; justify-content:space-between;
                          gap:16px; padding:14px 16px; border-radius:10px; text-decoration:none;
                          color:inherit; margin-bottom:4px; transition:background 0.15s;"
                   onmouseover="this.style.background='#f9fafb'"
                   onmouseout="this.style.background='transparent'">

                    <div style="display:flex; align-items:center; gap:14px; flex:1; min-width:0;">
                        <!-- Icoană job -->
                        <div style="width:40px; height:40px; min-width:40px; background:#f0eeff;
                                    border-radius:10px; display:flex; align-items:center; justify-content:center;">
                            <MudIcon Icon="@Icons.Material.Filled.Work" Style="color:#6366f1; font-size:20px;" />
                        </div>
                        <div style="flex:1; min-width:0;">
                            <p style="font-size:14px; font-weight:600; color:#111827;
                                      margin:0 0 2px 0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                @app.JobTitle
                            </p>
                            <p style="font-size:12px; color:#9ca3af; margin:0;">
                                @* @if (!string.IsNullOrWhiteSpace(app.CompanyName))
                                {
                                    <span>@app.CompanyName · </span>
                                } *@
                                Aplicat pe @app.AppliedAt.ToString("dd.MM.yyyy")
                            </p>
                        </div>
                    </div>

                    <!-- Badge status + dată -->
                    <div style="display:flex; align-items:center; gap:16px; flex-shrink:0;">
                        <span style="font-size:11px; font-weight:600; padding:4px 12px;
                                     border-radius:20px; background:@GetBadgeBg(app.Status);
                                     color:@GetBadgeFg(app.Status);">
                            @GetStatusText(app.Status)
                        </span>
                        <span style="font-size:11px; color:#9ca3af; white-space:nowrap;
                                     font-family:'Roboto Mono',monospace;">
                            Aplicat pe @app.AppliedAt.ToString("dd.MM.yyyy")
                        </span>
                    </div>
                </a>
            }
        }
    </div>

    <!-- ══════════════════════════════════════
         RECOMANDĂRI PERSONALIZATE — grid 3 col
    ══════════════════════════════════════ -->
    <div style="background:#fff; border:1px solid #e5e7eb; border-radius:16px; padding:24px;">

        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
            <h2 style="font-size:16px; font-weight:700; color:#111827; margin:0;
                       padding-left:12px; border-left:3px solid #6366f1;">
                Recomandări personalizate
            </h2>
            <a href="/candidate/jobs"
               style="font-size:12px; font-weight:600; color:#6366f1; text-decoration:none;">
                Explorează toate joburile →
            </a>
        </div>

        @if (_recommendedJobs.Count == 0)
        {
            <div style="text-align:center; padding:32px 0;">
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome"
                         Style="font-size:40px; color:#d1d5db; display:block; margin:0 auto 12px;" />
                <p style="font-size:14px; color:#9ca3af; margin:0 0 12px 0;">
                    Adaugă competențe în profil pentru recomandări personalizate.
                </p>
                <a href="/candidate/profile"
                   style="font-size:12px; font-weight:600; color:#6366f1; text-decoration:none;">
                    Completează profilul →
                </a>
            </div>
        }
        else
        {
            <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:16px;">
                @foreach (var job in _recommendedJobs)
                {
                    <div @onclick="@(() => Navigation.NavigateTo($"/candidate/jobs/{job.Id}"))"
                         style="border:1px solid #e5e7eb; border-radius:12px; padding:20px;
                                cursor:pointer; transition:border-color 0.15s, box-shadow 0.15s;
                                position:relative;"
                         onmouseover="this.style.borderColor='#c7d2fe'; this.style.boxShadow='0 4px 16px rgba(99,102,241,0.08)'"
                         onmouseout="this.style.borderColor='#e5e7eb'; this.style.boxShadow='none'">

                        <!-- Badge match (colț dreapta sus) -->
                        @if (job.TotalSkillsRequired > 0)
                        {
                            <div style="position:absolute; top:12px; right:12px;
                                        font-size:11px; font-weight:700;
                                        background:@GetMatchBg(job.MatchScore);
                                        color:@GetMatchColor(job.MatchScore);
                                        padding:3px 8px; border-radius:20px;">
                                @job.MatchScore% match
                            </div>
                        }

                        <!-- Icoană companie -->
                        <div style="width:44px; height:44px; background:#f0eeff; border-radius:10px;
                                    display:flex; align-items:center; justify-content:center; margin-bottom:14px;">
                            <MudIcon Icon="@Icons.Material.Filled.Work" Style="color:#6366f1; font-size:22px;" />
                        </div>

                        <!-- Titlu + companie -->
                        <p style="font-size:14px; font-weight:700; color:#111827;
                                  margin:0 0 4px 0; padding-right:60px;
                                  white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                            @job.Title
                        </p>
                        <p style="font-size:12px; color:#6b7280; margin:0 0 4px 0;">
                            @job.CompanyName
                        </p>
                        @if (!string.IsNullOrWhiteSpace(job.Location))
                        {
                            <p style="font-size:12px; color:#9ca3af; margin:0 0 14px 0; display:flex; align-items:center; gap:4px;">
                                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Style="font-size:13px; color:#9ca3af;" />
                                @job.Location
                            </p>
                        }

                        <!-- Skills -->
                        @if (job.SkillNames.Any())
                        {
                            <div style="display:flex; gap:6px; flex-wrap:wrap;">
                                @foreach (var skill in job.SkillNames.Take(3))
                                {
                                    <span style="font-size:11px; font-weight:500; padding:3px 8px;
                                                 background:#f3f4f6; color:#6b7280; border-radius:6px;">
                                        @skill
                                    </span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

<style>
    @@keyframes shimmer {
        0%   { background-position: -800px 0; }
        100% { background-position:  800px 0; }
    }
</style>

@code {
    private bool _loading = true;
    private DashboardStats _stats = new();
    private List<ApplicationDto> _recentApplications = new();
    private List<JobFeedItemDto> _recommendedJobs = new();
    private int _completionPct = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var applicationsTask = Http.GetFromJsonAsync<List<ApplicationDto>>("api/applications/my");
            var feedTask         = Http.GetFromJsonAsync<List<JobFeedItemDto>>("api/jobfeed?pageSize=6");
            var profileTask      = Http.GetFromJsonAsync<CandidateProfileDto>("api/candidateprofile");

            await Task.WhenAll(applicationsTask, feedTask, profileTask);

            // ── Aplicări ──────────────────────────────────────────────
            var applications = applicationsTask.Result ?? new();
            _stats = new DashboardStats
            {
                Total    = applications.Count,
                InReview = applications.Count(a => a.Status == ApplicationState.InReview),
                Interview= applications.Count(a => a.Status == ApplicationState.Interview),
                Accepted = applications.Count(a => a.Status == ApplicationState.Accepted),
            };
            _recentApplications = applications
                .OrderByDescending(a => a.AppliedAt)
                .Take(5)
                .ToList();

            // ── Joburi recomandate ────────────────────────────────────
            _recommendedJobs = (feedTask.Result ?? new())
                .OrderByDescending(j => j.MatchScore)
                .Take(3)
                .ToList();

            // ── Completitudine profil ─────────────────────────────────
            var profile = profileTask.Result;
            if (profile != null)
                _completionPct = ComputeCompletion(profile);
        }
        catch { }
        finally { _loading = false; }
    }

    // ── Helpers ───────────────────────────────────────────────────────

    private static int ComputeCompletion(CandidateProfileDto p)
    {
        int score = 0;
        if (!string.IsNullOrWhiteSpace(p.FirstName))  score += 10;
        if (!string.IsNullOrWhiteSpace(p.LastName))   score += 10;
        if (!string.IsNullOrWhiteSpace(p.Headline))   score += 5;
        if (!string.IsNullOrWhiteSpace(p.Location))   score += 5;
        if (!string.IsNullOrWhiteSpace(p.Phone))      score += 5;
        if (!string.IsNullOrWhiteSpace(p.Summary))    score += 10;
        if (p.DateOfBirth.HasValue)                    score += 5;
        if (p.Educations?.Count  > 0) score += 20;
        if (p.Experiences?.Count > 0) score += 15;
        if (p.Skills?.Count      > 0) score += 10;
        if (p.Languages?.Count   > 0) score += 5;
        return Math.Min(score, 100);
    }

    private static string GetMatchBg(int score) => score switch
    {
        >= 80 => "#dcfce7",
        >= 50 => "#fef9c3",
        >= 20 => "#ede9fe",
        _     => "#f3f4f6"
    };

    private static string GetMatchColor(int score) => score switch
    {
        >= 80 => "#16a34a",
        >= 50 => "#ca8a04",
        >= 20 => "#6366f1",
        _     => "#6b7280"
    };

    private static string GetStatusText(ApplicationState s) => s switch
    {
        ApplicationState.Pending   => "În procesare",
        ApplicationState.InReview  => "În analiză",
        ApplicationState.Interview => "Interviu",
        ApplicationState.Accepted  => "Acceptat",
        ApplicationState.Rejected  => "Respins",
        ApplicationState.Withdrawn => "Retras",
        _ => s.ToString()
    };

    private static string GetBadgeBg(ApplicationState s) => s switch
    {
        ApplicationState.Accepted  => "#dcfce7",
        ApplicationState.Rejected  => "#fee2e2",
        ApplicationState.Interview => "#dbeafe",
        ApplicationState.InReview  => "#fef9c3",
        ApplicationState.Withdrawn => "#f3f4f6",
        _                          => "#fef3c7"
    };

    private static string GetBadgeFg(ApplicationState s) => s switch
    {
        ApplicationState.Accepted  => "#16a34a",
        ApplicationState.Rejected  => "#dc2626",
        ApplicationState.Interview => "#1d4ed8",
        ApplicationState.InReview  => "#92400e",
        ApplicationState.Withdrawn => "#6b7280",
        _                          => "#92400e"
    };

    private class DashboardStats
    {
        public int Total     { get; set; }
        public int InReview  { get; set; }
        public int Interview { get; set; }
        public int Accepted  { get; set; }
    }
}
