@page "/candidate/dashboard"
@layout CandidateLayout

@using JobFinder.Shared.DTOs.Applications
@using JobFinder.Shared.DTOs.Jobs
@using JobFinder.Shared.DTOs.Candidates
@using JobFinder.Shared.Enums
@using System.Net.Http.Json
@using System.Text.Json

@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Dashboard - JobFinder</PageTitle>

<PageHeader Title="Dashboard"
            Description="Bine ai revenit. Iată activitatea ta pe platformă." />

@if (_loading)
{
    <div style="display:flex; flex-direction:column; gap:24px;">
        @for (int i = 0; i < 3; i++)
        {
            <div style="border:1px solid #e5e7eb; padding:24px; height:80px;
                        background:linear-gradient(90deg,#f3f4f6 25%,#e9eaec 50%,#f3f4f6 75%);
                        background-size:800px 100%;
                        animation:shimmer 1.4s infinite;"></div>
        }
    </div>
}
else
{
    @* ══════════════════════════════════════
       STATISTICI
    ══════════════════════════════════════ *@
    <section style="margin-bottom:40px;">
        <h2 style="font-size:14px; font-weight:700; color:#111827; margin-bottom:16px;">
            Statistici
        </h2>
        <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:16px;">

            <div style="border:1px solid #e5e7eb; padding:20px;">
                <p style="font-size:28px; font-weight:700; color:#6366f1; margin:0 0 4px 0;">
                    @_stats.Total
                </p>
                <p style="font-size:12px; color:#6b7280; margin:0;">Total aplicări</p>
            </div>

            <div style="border:1px solid #e5e7eb; padding:20px;">
                <p style="font-size:28px; font-weight:700; color:#f59e0b; margin:0 0 4px 0;">
                    @_stats.InReview
                </p>
                <p style="font-size:12px; color:#6b7280; margin:0;">În analiză</p>
            </div>

            <div style="border:1px solid #e5e7eb; padding:20px;">
                <p style="font-size:28px; font-weight:700; color:#3b82f6; margin:0 0 4px 0;">
                    @_stats.Interview
                </p>
                <p style="font-size:12px; color:#6b7280; margin:0;">Interviuri</p>
            </div>

            <div style="border:1px solid #e5e7eb; padding:20px;">
                <p style="font-size:28px; font-weight:700; color:#16a34a; margin:0 0 4px 0;">
                    @_stats.Accepted
                </p>
                <p style="font-size:12px; color:#6b7280; margin:0;">Acceptate</p>
            </div>

        </div>
    </section>

    @* ══════════════════════════════════════
       COMPLETITUDINE PROFIL
    ══════════════════════════════════════ *@
    @if (_completionPct < 100)
    {
        <section style="margin-bottom:40px;">
            <div style="border:1px solid #e5e7eb; padding:20px 24px;
                        background:#fafafa;">
                <div style="display:flex; justify-content:space-between;
                            align-items:center; margin-bottom:10px;">
                    <h2 style="font-size:14px; font-weight:700; color:#111827; margin:0;">
                        Completitudine profil
                    </h2>
                    <span style="font-size:13px; font-weight:600;
                                 color:@(_completionPct >= 80 ? "#16a34a" : "#6366f1");">
                        @_completionPct%
                    </span>
                </div>
                <div style="height:6px; background:#e5e7eb; border-radius:99px; overflow:hidden;">
                    <div style="height:100%; width:@(_completionPct)%;
                                background:#6366f1; border-radius:99px;
                                transition:width 0.5s ease;"></div>
                </div>
                <p style="font-size:12px; color:#6b7280; margin:10px 0 0 0;">
                    @GetCompletionHint()
                    <a href="/candidate/profile"
                       style="color:#6366f1; text-decoration:none; font-weight:600; margin-left:6px;">
                        Completează profilul →
                    </a>
                </p>
            </div>
        </section>
    }

    @* ══════════════════════════════════════
       APLICĂRI RECENTE
    ══════════════════════════════════════ *@
    <section style="margin-bottom:40px;">
        <div style="display:flex; justify-content:space-between;
                    align-items:center; margin-bottom:16px;">
            <h2 style="font-size:14px; font-weight:700; color:#111827; margin:0;">
                Aplicări recente
            </h2>
            @if (_recentApplications.Count > 0)
            {
                <a href="/candidate/applications"
                   style="font-size:12px; font-weight:600; color:#6366f1;
                          text-decoration:none; letter-spacing:0.5px;">
                    Vezi toate →
                </a>
            }
        </div>

        @if (_recentApplications.Count == 0)
        {
            <div style="border:1px dashed #e5e7eb; padding:32px; text-align:center;">
                <p style="font-size:14px; color:#6b7280; margin:0 0 12px 0;">
                    Nu ai aplicat încă la niciun job.
                </p>
                <a href="/candidate/jobs"
                   style="font-size:11px; font-weight:600; color:#6366f1;
                          text-decoration:none; letter-spacing:2px; text-transform:uppercase;">
                    Explorează joburi →
                </a>
            </div>
        }
        else
        {
            @foreach (var app in _recentApplications)
            {
                <a href="/candidate/applications/@app.Id"
                   style="display:block; border-bottom:1px solid #e5e7eb;
                          padding:16px; margin:0 -16px; text-decoration:none;
                          color:inherit; transition:background 0.15s;"
                   onmouseover="this.style.background='#f9fafb'"
                   onmouseout="this.style.background='transparent'">
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <div>
                            <h3 style="font-size:14px; font-weight:700;
                                       color:#111827; margin:0 0 4px 0;">
                                @app.JobTitle
                            </h3>
                            <p style="font-size:13px; color:#6b7280; margin:0;">
                                Aplicat pe @app.AppliedAt.ToString("dd.MM.yyyy")
                            </p>
                        </div>
                        <StatusBadge Status="@GetStatusText(app.Status)"
                                     Variant="@GetStatusVariant(app.Status)" />
                    </div>
                </a>
            }
        }
    </section>

    @* ══════════════════════════════════════
       JOBURI RECOMANDATE
    ══════════════════════════════════════ *@
    <section style="margin-bottom:40px;">
        <div style="display:flex; justify-content:space-between;
                    align-items:center; margin-bottom:16px;">
            <h2 style="font-size:14px; font-weight:700; color:#111827; margin:0;">
                Joburi recomandate pentru tine
            </h2>
            <a href="/candidate/jobs"
               style="font-size:12px; font-weight:600; color:#6366f1;
                      text-decoration:none; letter-spacing:0.5px;">
                Vezi toate →
            </a>
        </div>

        @if (_recommendedJobs.Count == 0)
        {
            <div style="border:1px dashed #e5e7eb; padding:32px; text-align:center;">
                <p style="font-size:14px; color:#6b7280; margin:0 0 12px 0;">
                    Adaugă competențe în profil pentru a primi recomandări personalizate.
                </p>
                <a href="/candidate/profile"
                   style="font-size:11px; font-weight:600; color:#6366f1;
                          text-decoration:none; letter-spacing:2px; text-transform:uppercase;">
                    Completează profilul →
                </a>
            </div>
        }
        else
        {
            @foreach (var job in _recommendedJobs)
            {
                <div @onclick="() => GoToJob(job.Id)"
                     style="border-bottom:1px solid #e5e7eb; padding:20px 16px;
                            margin:0 -16px; cursor:pointer; transition:background 0.15s;"
                     onmouseover="this.style.background='#f9fafb'"
                     onmouseout="this.style.background='transparent'">

                    <div style="display:flex; justify-content:space-between;
                                align-items:flex-start; gap:16px;">
                        <div style="flex:1; min-width:0;">
                            <h3 style="font-size:14px; font-weight:700;
                                       color:#111827; margin:0 0 4px 0;">
                                @job.Title
                            </h3>
                            <p style="font-size:13px; color:#6b7280; margin:0 0 8px 0;">
                                @job.CompanyName
                                @if (!string.IsNullOrWhiteSpace(job.Location))
                                {
                                    <span> · @job.Location</span>
                                }
                            </p>
                            @if (job.SkillNames.Any())
                            {
                                <div style="display:flex; gap:6px; flex-wrap:wrap;">
                                    @foreach (var skill in job.SkillNames.Take(4))
                                    {
                                        <span style="font-size:11px; font-weight:600;
                                                     color:#6b7280; border:1px solid #e5e7eb;
                                                     padding:2px 8px;">
                                            @skill
                                        </span>
                                    }
                                </div>
                            }
                        </div>

                        @if (job.TotalSkillsRequired > 0)
                        {
                            <div style="text-align:center; flex-shrink:0;">
                                <div style="@GetMatchStyle(job.MatchScore)
                                            font-size:14px; font-weight:700;
                                            width:48px; height:48px;
                                            display:flex; align-items:center;
                                            justify-content:center; border-radius:4px;">
                                    @job.MatchScore%
                                </div>
                                <p style="font-size:10px; color:#9ca3af;
                                          margin:3px 0 0 0; text-align:center;">
                                    match
                                </p>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </section>
}

<style>
    @@keyframes shimmer {
        0%   { background-position: -800px 0; }
        100% { background-position:  800px 0; }
    }
</style>

@code {
    private bool _loading = true;

    private DashboardStats _stats = new();
    private List<ApplicationDto>  _recentApplications = new();
    private List<JobFeedItemDto>  _recommendedJobs    = new();
    private int _completionPct = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Toate call-urile în paralel
            var applicationsTask = Http.GetFromJsonAsync<List<ApplicationDto>>(
                "api/applications/my");
            var feedTask = Http.GetAsync("api/jobfeed");
            var profileTask = Http.GetFromJsonAsync<CandidateProfileDto>(
                "api/candidateprofile");

            await Task.WhenAll(applicationsTask, feedTask, profileTask);

            // ── Aplicări ──────────────────────────────────────────────
            var applications = applicationsTask.Result ?? new();

            _stats = new DashboardStats
            {
                Total     = applications.Count,
                InReview  = applications.Count(a =>
                    a.Status == ApplicationState.InReview),
                Interview = applications.Count(a =>
                    a.Status == ApplicationState.Interview),
                Accepted  = applications.Count(a =>
                    a.Status == ApplicationState.Accepted),
            };

            _recentApplications = applications
                .OrderByDescending(a => a.AppliedAt)
                .Take(3)
                .ToList();

            // ── Feed joburi ───────────────────────────────────────────
            if (feedTask.Result.IsSuccessStatusCode)
            {
                var json = await feedTask.Result.Content.ReadAsStringAsync();
                var feedResult = JsonSerializer.Deserialize<FeedResult>(json,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                _recommendedJobs = (feedResult?.Items ?? new())
                    .OrderByDescending(j => j.MatchScore)
                    .Take(3)
                    .ToList();
            }

            // ── Completitudine profil ─────────────────────────────────
            var profile = profileTask.Result;
            if (profile != null)
                _completionPct = ComputeCompletion(profile);
        }
        catch { }
        finally
        {
            _loading = false;
        }
    }

    private static int ComputeCompletion(CandidateProfileDto p)
    {
        int score = 0;
        if (!string.IsNullOrWhiteSpace(p.FirstName))  score += 10;
        if (!string.IsNullOrWhiteSpace(p.LastName))   score += 10;
        if (!string.IsNullOrWhiteSpace(p.Headline))   score += 5;
        if (!string.IsNullOrWhiteSpace(p.Location))   score += 5;
        if (!string.IsNullOrWhiteSpace(p.Phone))      score += 5;
        if (!string.IsNullOrWhiteSpace(p.Summary))    score += 10;
        if (p.DateOfBirth.HasValue)                    score += 5;
        if (p.Educations?.Count  > 0) score += 20;
        if (p.Experiences?.Count > 0) score += 15;
        if (p.Skills?.Count      > 0) score += 10;
        if (p.Languages?.Count   > 0) score += 5;
        return Math.Min(score, 100);
    }

    private string GetCompletionHint() => _completionPct switch
    {
        >= 80 => "Profilul tău este aproape complet.",
        >= 50 => "Adaugă experiența și educația pentru un profil mai vizibil.",
        >= 30 => "Completează rezumatul și competențele.",
        _     => "Începe prin a-ți completa datele personale.",
    };

    private static string GetMatchStyle(int score) => score switch
    {
        >= 80 => "background:#dcfce7; color:#16a34a;",
        >= 50 => "background:#fef9c3; color:#ca8a04;",
        >= 20 => "background:#ede9fe; color:#6366f1;",
        _     => "background:#f3f4f6; color:#6b7280;"
    };

    private static string GetStatusText(ApplicationState s) => s switch
    {
        ApplicationState.Pending   => "În așteptare",
        ApplicationState.InReview  => "În analiză",
        ApplicationState.Interview => "Interviu",
        ApplicationState.Accepted  => "Acceptat",
        ApplicationState.Rejected  => "Respins",
        ApplicationState.Withdrawn => "Retras",
        _ => s.ToString()
    };

    private static string GetStatusVariant(ApplicationState s) => s switch
    {
        ApplicationState.Pending   => "warning",
        ApplicationState.InReview  => "warning",
        ApplicationState.Interview => "default",
        ApplicationState.Accepted  => "success",
        ApplicationState.Rejected  => "destructive",
        ApplicationState.Withdrawn => "muted",
        _ => "default"
    };

    private void GoToJob(int id)
        => Navigation.NavigateTo($"/candidate/jobs/{id}");

    // ── Modele locale ─────────────────────────────────────────────────

    private class DashboardStats
    {
        public int Total     { get; set; }
        public int InReview  { get; set; }
        public int Interview { get; set; }
        public int Accepted  { get; set; }
    }

    private sealed class FeedResult
    {
        public List<JobFeedItemDto> Items { get; set; } = new();
        public int TotalCount { get; set; }
    }
}
