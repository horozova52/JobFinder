@page "/register"
@layout MainLayout

<PageTitle>Înregistrare - JobFinder</PageTitle>

<div style="min-height:calc(100vh - 64px); display:flex; align-items:center; justify-content:center;
            background:linear-gradient(135deg,#ffffff 0%,#f8f7ff 60%,#f0eeff 100%);
            padding:64px 32px;">
    <div style="max-width:760px; width:100%;">

        <!-- Header -->
        <div style="text-align:center; margin-bottom:48px;">
            <p style="font-size:11px; font-weight:700; letter-spacing:3px; text-transform:uppercase;
                      color:#6366f1; margin:0 0 16px 0; font-family:'Roboto Mono',monospace;">
                Alătură-te platformei
            </p>
            <h1 style="font-size:36px; font-weight:800; color:#111827; letter-spacing:-1px;
                       margin:0 0 12px 0; line-height:1.1;">
                Cine ești tu?
            </h1>
            <p style="font-size:16px; color:#6b7280; margin:0; line-height:1.6;">
                Alege tipul de cont potrivit pentru tine.
            </p>
        </div>

        <!-- Cele 2 carduri -->
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:32px;">

            <!-- Card Candidat -->
            <a href="/register/candidate"
               style="display:block; padding:40px 32px; border-radius:16px; background:#fff;
                      border:2px solid #e5e7eb; text-decoration:none; color:inherit;
                      transition:border-color 0.2s, box-shadow 0.2s, transform 0.2s;"
               onmouseover="this.style.borderColor='#6366f1'; this.style.boxShadow='0 8px 32px rgba(99,102,241,0.12)'; this.style.transform='translateY(-3px)'"
               onmouseout="this.style.borderColor='#e5e7eb'; this.style.boxShadow='none'; this.style.transform='translateY(0)'">

                <div style="width:56px; height:56px; background:#f0eeff; border-radius:14px;
                            display:flex; align-items:center; justify-content:center;
                            font-size:26px; margin-bottom:20px;">
                    🧑‍💼
                </div>

                <h2 style="font-size:20px; font-weight:800; color:#111827; margin:0 0 10px 0;">
                    Sunt candidat
                </h2>
                <p style="font-size:14px; color:#6b7280; margin:0 0 24px 0; line-height:1.6;">
                    Caut un loc de muncă. Vreau să-mi creez un profil profesional,
                    să aplic la joburi și să urmăresc statusul candidaturilor mele.
                </p>

                <ul style="list-style:none; padding:0; margin:0 0 28px 0; display:flex; flex-direction:column; gap:8px;">
                    @foreach (var f in _candidateFeatures)
                    {
                        <li style="display:flex; align-items:center; gap:10px; font-size:13px; color:#374151;">
                            <span style="color:#6366f1; font-weight:700; flex-shrink:0;">✓</span>
                            @f
                        </li>
                    }
                </ul>

                <div style="display:flex; align-items:center; justify-content:space-between;">
                    <span style="font-size:11px; font-weight:700; letter-spacing:2px; text-transform:uppercase;
                                 color:#6366f1;">
                        Înregistrare candidat →
                    </span>
                </div>
            </a>

            <!-- Card Angajator -->
            <a href="/register/employer"
               style="display:block; padding:40px 32px; border-radius:16px; background:#fff;
                      border:2px solid #e5e7eb; text-decoration:none; color:inherit;
                      transition:border-color 0.2s, box-shadow 0.2s, transform 0.2s;"
               onmouseover="this.style.borderColor='#111827'; this.style.boxShadow='0 8px 32px rgba(17,24,39,0.10)'; this.style.transform='translateY(-3px)'"
               onmouseout="this.style.borderColor='#e5e7eb'; this.style.boxShadow='none'; this.style.transform='translateY(0)'">

                <div style="width:56px; height:56px; background:#f3f4f6; border-radius:14px;
                            display:flex; align-items:center; justify-content:center;
                            font-size:26px; margin-bottom:20px;">
                    🏢
                </div>

                <h2 style="font-size:20px; font-weight:800; color:#111827; margin:0 0 10px 0;">
                    Sunt angajator
                </h2>
                <p style="font-size:14px; color:#6b7280; margin:0 0 24px 0; line-height:1.6;">
                    Reprezint o companie. Vreau să public anunțuri de angajare,
                    să găsesc candidați compatibili și să gestionez procesul de recrutare.
                </p>

                <ul style="list-style:none; padding:0; margin:0 0 28px 0; display:flex; flex-direction:column; gap:8px;">
                    @foreach (var f in _employerFeatures)
                    {
                        <li style="display:flex; align-items:center; gap:10px; font-size:13px; color:#374151;">
                            <span style="color:#111827; font-weight:700; flex-shrink:0;">✓</span>
                            @f
                        </li>
                    }
                </ul>

                <div style="display:flex; align-items:center; justify-content:space-between;">
                    <span style="font-size:11px; font-weight:700; letter-spacing:2px; text-transform:uppercase;
                                 color:#111827;">
                        Înregistrare angajator →
                    </span>
                </div>
            </a>
        </div>

        <!-- Link login -->
        <p style="text-align:center; font-size:13px; color:#9ca3af; margin:0;">
            Ai deja un cont?
            <a href="/login" style="color:#6366f1; font-weight:700; text-decoration:none;
                                    margin-left:4px;">
                Autentifică-te →
            </a>
        </p>

    </div>
</div>

@code {
    private readonly List<string> _candidateFeatures = new()
    {
        "Profil profesional complet cu CV generat automat",
        "Matching automat cu joburi pe baza competențelor",
        "Aplicare rapidă și urmărire status în timp real",
        "Mesagerie directă cu angajatorii",
    };

    private readonly List<string> _employerFeatures = new()
    {
        "Publicare anunțuri de angajare structurate",
        "Candidați compatibili ordonați după scor",
        "Gestionare aplicări și pipeline de selecție",
        "Comunicare directă cu candidații",
    };
}
