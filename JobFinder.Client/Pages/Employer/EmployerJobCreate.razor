@page "/employer/jobs/create"
@layout EmployerLayout
@using JobFinder.Shared.DTOs.Jobs
@using JobFinder.Shared.Enums
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Creare anunț - JobFinder</PageTitle>

<a href="/employer/jobs"
   style="font-size:12px; font-weight:600; letter-spacing:1px; text-transform:uppercase;
          color:#6b7280; text-decoration:none; display:inline-block; margin-bottom:24px;">
    ← Înapoi la anunțuri
</a>

<PageHeader Title="Creare anunț"
            Description="Publică un nou anunț de angajare." />

<div style="max-width:560px; display:flex; flex-direction:column; gap:24px;">

    <!-- Titlu -->
    <div>
        <label style="display:block; font-size:11px; font-weight:600; letter-spacing:2px;
                      text-transform:uppercase; color:#6b7280; margin-bottom:8px;">
            Titlu job
        </label>
        <MudTextField @bind-Value="_dto.Title" Placeholder="ex: Frontend Developer"
                      Variant="Variant.Outlined" FullWidth="true"
                      Margin="Margin.Dense" Style="border-radius:0;" />
    </div>

    <!-- Locație -->
    <div>
        <label style="display:block; font-size:11px; font-weight:600; letter-spacing:2px;
                      text-transform:uppercase; color:#6b7280; margin-bottom:8px;">
            Locație
        </label>
        <MudTextField @bind-Value="_dto.Location"
                      Variant="Variant.Outlined" FullWidth="true"
                      Margin="Margin.Dense" Style="border-radius:0;" />
    </div>

    <!-- Mod de lucru + Tip angajare -->
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
        <div>
            <label style="display:block; font-size:11px; font-weight:600; letter-spacing:2px;
                          text-transform:uppercase; color:#6b7280; margin-bottom:8px;">
                Mod de lucru
            </label>
            <MudSelect @bind-Value="_dto.JobType"
                       Variant="Variant.Outlined" FullWidth="true"
                       Margin="Margin.Dense" Style="border-radius:0;">
                <MudSelectItem Value="JobType.Remote">Remote</MudSelectItem>
                <MudSelectItem Value="JobType.OnSite">La birou</MudSelectItem>
                <MudSelectItem Value="JobType.Hybrid">Hibrid</MudSelectItem>
            </MudSelect>
        </div>
        <div>
            <label style="display:block; font-size:11px; font-weight:600; letter-spacing:2px;
                          text-transform:uppercase; color:#6b7280; margin-bottom:8px;">
                Tip angajare
            </label>
            <MudSelect @bind-Value="_dto.EmploymentType"
                       Variant="Variant.Outlined" FullWidth="true"
                       Margin="Margin.Dense" Style="border-radius:0;">
                <MudSelectItem Value="EmploymentType.FullTime">Full-time</MudSelectItem>
                <MudSelectItem Value="EmploymentType.PartTime">Part-time</MudSelectItem>
                <MudSelectItem Value="EmploymentType.Freelance">Freelance</MudSelectItem>
                <MudSelectItem Value="EmploymentType.Internship">Internship</MudSelectItem>
                <MudSelectItem Value="EmploymentType.Contract">Contract</MudSelectItem>
            </MudSelect>
        </div>
    </div>

    <!-- Descriere -->
    <div>
        <label style="display:block; font-size:11px; font-weight:600; letter-spacing:2px;
                      text-transform:uppercase; color:#6b7280; margin-bottom:8px;">
            Descriere
        </label>
        <MudTextField @bind-Value="_dto.Description"
                      Lines="5" Variant="Variant.Outlined" FullWidth="true"
                      Margin="Margin.Dense" Style="border-radius:0;" />
    </div>

    <!-- Cerințe -->
    <div>
        <label style="display:block; font-size:11px; font-weight:600; letter-spacing:2px;
                      text-transform:uppercase; color:#6b7280; margin-bottom:8px;">
            Cerințe
        </label>
        <MudTextField @bind-Value="_dto.Requirements"
                      Lines="3" Variant="Variant.Outlined" FullWidth="true"
                      Margin="Margin.Dense" Style="border-radius:0;" />
    </div>

    <!-- Responsabilități -->
    <div>
        <label style="display:block; font-size:11px; font-weight:600; letter-spacing:2px;
                      text-transform:uppercase; color:#6b7280; margin-bottom:8px;">
            Responsabilități
        </label>
        <MudTextField @bind-Value="_dto.Responsibilities"
                      Lines="3" Variant="Variant.Outlined" FullWidth="true"
                      Margin="Margin.Dense" Style="border-radius:0;" />
    </div>

    <!-- Salariu -->
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
        <div>
            <label style="display:block; font-size:11px; font-weight:600; letter-spacing:2px;
                          text-transform:uppercase; color:#6b7280; margin-bottom:8px;">
                Salariu de la
            </label>
            <MudNumericField @bind-Value="_dto.SalaryFrom"
                             Variant="Variant.Outlined" FullWidth="true"
                             Margin="Margin.Dense" Style="border-radius:0;" />
        </div>
        <div>
            <label style="display:block; font-size:11px; font-weight:600; letter-spacing:2px;
                          text-transform:uppercase; color:#6b7280; margin-bottom:8px;">
                Salariu până la
            </label>
            <MudNumericField @bind-Value="_dto.SalaryTo"
                             Variant="Variant.Outlined" FullWidth="true"
                             Margin="Margin.Dense" Style="border-radius:0;" />
        </div>
    </div>

    <div>
        <MudCheckBox @bind-Value="_dto.IsSalaryNegotiable" Label="Salariu negociabil"
                     Color="Color.Primary" />
    </div>
    <!-- Categorie -->
    <div>
        <label style="display:block; font-size:11px; font-weight:600; letter-spacing:2px;
                  text-transform:uppercase; color:#6b7280; margin-bottom:8px;">
            Categorie
        </label>
        <MudSelect @bind-Value="_dto.CategoryId"
                   Variant="Variant.Outlined" FullWidth="true"
                   Margin="Margin.Dense" Style="border-radius:0;"
                   T="int?">
            <MudSelectItem T="int?" Value="@((int?)null)">Selectează categoria</MudSelectItem>
            @foreach (var cat in _categories)
            {
                <MudSelectItem T="int?" Value="@((int?)cat.Id)">@cat.Name</MudSelectItem>
            }
        </MudSelect>
    </div>
    <!-- Tags -->
    <div>
        <label style="display:block; font-size:11px; font-weight:600; letter-spacing:2px;
                      text-transform:uppercase; color:#6b7280; margin-bottom:8px;">
            Tags (separate prin virgulă)
        </label>
        <MudTextField @bind-Value="_dto.Tags" Placeholder="React, TypeScript, CSS"
                      Variant="Variant.Outlined" FullWidth="true"
                      Margin="Margin.Dense" Style="border-radius:0;" />
    </div>

    <div>
        <MudButton Variant="Variant.Filled" OnClick="HandleSubmit" Disabled="_submitting"
                   Style="background:#6366f1; color:#fff; border-radius:0;
                          font-size:11px; font-weight:600; letter-spacing:2px;
                          text-transform:uppercase; padding:12px 24px;">
            @if (_submitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Surface" Class="mr-2" />
            }
            Publică anunțul
        </MudButton>
    </div>
</div>

@code {
    private CreateJobPostingDto _dto = new();
    private bool _submitting;
    private List<JobCategoryDto> _categories = new();

    protected override async Task OnInitializedAsync()
    {
        var cats = await Http.GetFromJsonAsync<List<JobCategoryDto>>("api/jobcategories");
        if (cats != null) _categories = cats;
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_dto.Title) || string.IsNullOrWhiteSpace(_dto.Description))
        {
            Snackbar.Add("Titlul și descrierea sunt obligatorii.", Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/jobs", _dto);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Anunțul a fost publicat cu succes!", Severity.Success);
                Navigation.NavigateTo("/employer/jobs");
            }
            else
            {
                Snackbar.Add("Eroare la publicarea anunțului. Încercați din nou.", Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("Eroare de conexiune. Încercați din nou.", Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }
}
