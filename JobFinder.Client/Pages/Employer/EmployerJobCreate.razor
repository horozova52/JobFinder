@page "/employer/jobs/create"
@layout EmployerLayout
@using JobFinder.Shared.DTOs.Jobs
@using JobFinder.Shared.Enums
@using Microsoft.AspNetCore.Components.Web
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Creare anunț - JobFinder</PageTitle>

<button @onclick="GoBack"
        style="display:inline-flex; align-items:center; gap:6px; font-size:12px; font-weight:600;
               letter-spacing:1px; text-transform:uppercase; color:#6b7280;
               background:none; border:none; cursor:pointer; padding:0;
               margin-bottom:24px;">
    ← Înapoi la anunțuri
</button>

<div style="margin-bottom:28px;">
    <h1 style="font-size:22px; font-weight:700; color:#111827; margin:0 0 4px 0;">
        Creare anunț nou
    </h1>
  
</div>

<div style="display:grid; grid-template-columns:1fr 300px; gap:24px; align-items:start;">

    @* ── Formular principal ── *@
    <div style="display:flex; flex-direction:column; gap:20px;">

        @* Informații de bază *@
        <div style="background:#fff; border:1px solid #e5e7eb; border-radius:16px; padding:28px;">
            <h2 style="font-size:14px; font-weight:700; color:#111827;
                       margin:0 0 20px 0; padding-left:12px; border-left:3px solid #6366f1;">
                Informații de bază
            </h2>
            <div style="display:flex; flex-direction:column; gap:16px;">
                <div>
                    <label style="display:block; font-size:11px; font-weight:600; letter-spacing:1px;
                                  text-transform:uppercase; color:#6b7280; margin-bottom:6px;">
                        Titlu job *
                    </label>
                    <MudTextField @bind-Value="_dto.Title" Placeholder="ex: Senior .NET Developer"
                                  Variant="Variant.Outlined" FullWidth="true"
                                  Margin="Margin.Dense" Style="border-radius:8px;" />
                </div>
                <div>
                    <label style="display:block; font-size:11px; font-weight:600; letter-spacing:1px;
                                  text-transform:uppercase; color:#6b7280; margin-bottom:6px;">
                        Locație
                    </label>
                    <MudTextField @bind-Value="_dto.Location" Placeholder="ex: Chișinău, Moldova"
                                  Variant="Variant.Outlined" FullWidth="true"
                                  Margin="Margin.Dense" Style="border-radius:8px;" />
                </div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                    <div>
                        <label style="display:block; font-size:11px; font-weight:600; letter-spacing:1px;
                                      text-transform:uppercase; color:#6b7280; margin-bottom:6px;">
                            Mod de lucru
                        </label>
                        <MudSelect @bind-Value="_dto.JobType"
                                   Variant="Variant.Outlined" FullWidth="true"
                                   Margin="Margin.Dense" Style="border-radius:8px;">
                            <MudSelectItem Value="JobType.OnSite">La birou</MudSelectItem>
                            <MudSelectItem Value="JobType.Remote">Remote</MudSelectItem>
                            <MudSelectItem Value="JobType.Hybrid">Hibrid</MudSelectItem>
                        </MudSelect>
                    </div>
                    <div>
                        <label style="display:block; font-size:11px; font-weight:600; letter-spacing:1px;
                                      text-transform:uppercase; color:#6b7280; margin-bottom:6px;">
                            Tip angajare
                        </label>
                        <MudSelect @bind-Value="_dto.EmploymentType"
                                   Variant="Variant.Outlined" FullWidth="true"
                                   Margin="Margin.Dense" Style="border-radius:8px;">
                            <MudSelectItem Value="EmploymentType.FullTime">Full-time</MudSelectItem>
                            <MudSelectItem Value="EmploymentType.PartTime">Part-time</MudSelectItem>
                            <MudSelectItem Value="EmploymentType.Freelance">Freelance</MudSelectItem>
                            <MudSelectItem Value="EmploymentType.Internship">Internship</MudSelectItem>
                            <MudSelectItem Value="EmploymentType.Contract">Contract</MudSelectItem>
                        </MudSelect>
                    </div>
                </div>
                <div>
                    <label style="display:block; font-size:11px; font-weight:600; letter-spacing:1px;
                                  text-transform:uppercase; color:#6b7280; margin-bottom:6px;">
                        Categorie
                    </label>
                    <MudSelect @bind-Value="_dto.CategoryId"
                               Variant="Variant.Outlined" FullWidth="true"
                               Margin="Margin.Dense" Style="border-radius:8px;"
                               T="int?">
                        <MudSelectItem T="int?" Value="@((int?)null)">Selectează categoria</MudSelectItem>
                        @foreach (var cat in _categories)
                        {
                            <MudSelectItem T="int?" Value="@((int?)cat.Id)">@cat.Name</MudSelectItem>
                        }
                    </MudSelect>
                </div>
            </div>
        </div>

        @* Descriere job *@
        <div style="background:#fff; border:1px solid #e5e7eb; border-radius:16px; padding:28px;">
            <h2 style="font-size:14px; font-weight:700; color:#111827;
                       margin:0 0 20px 0; padding-left:12px; border-left:3px solid #6366f1;">
                Descriere job
            </h2>
            <div style="display:flex; flex-direction:column; gap:16px;">
                <div>
                    <label style="display:block; font-size:11px; font-weight:600; letter-spacing:1px;
                                  text-transform:uppercase; color:#6b7280; margin-bottom:6px;">
                        Descriere *
                    </label>
                    <MudTextField @bind-Value="_dto.Description"
                                  Placeholder="Descrie rolul, echipa și proiectele..."
                                  Lines="5" Variant="Variant.Outlined" FullWidth="true"
                                  Margin="Margin.Dense" Style="border-radius:8px;" />
                </div>
                <div>
                    <label style="display:block; font-size:11px; font-weight:600; letter-spacing:1px;
                                  text-transform:uppercase; color:#6b7280; margin-bottom:6px;">
                        Cerințe
                    </label>
                    <MudTextField @bind-Value="_dto.Requirements"
                                  Placeholder="Experiență, tehnologii, certificări necesare..."
                                  Lines="4" Variant="Variant.Outlined" FullWidth="true"
                                  Margin="Margin.Dense" Style="border-radius:8px;" />
                </div>
                <div>
                    <label style="display:block; font-size:11px; font-weight:600; letter-spacing:1px;
                                  text-transform:uppercase; color:#6b7280; margin-bottom:6px;">
                        Responsabilități
                    </label>
                    <MudTextField @bind-Value="_dto.Responsibilities"
                                  Placeholder="Ce va face candidatul selectat..."
                                  Lines="4" Variant="Variant.Outlined" FullWidth="true"
                                  Margin="Margin.Dense" Style="border-radius:8px;" />
                </div>
            </div>
        </div>

        @* Salariu *@
        <div style="background:#fff; border:1px solid #e5e7eb; border-radius:16px; padding:28px;">
            <h2 style="font-size:14px; font-weight:700; color:#111827;
                       margin:0 0 20px 0; padding-left:12px; border-left:3px solid #6366f1;">
                Salariu (MDL)
            </h2>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:12px;">
                <div>
                    <label style="display:block; font-size:11px; font-weight:600; letter-spacing:1px;
                                  text-transform:uppercase; color:#6b7280; margin-bottom:6px;">
                        De la
                    </label>
                    <MudNumericField @bind-Value="_dto.SalaryFrom" Placeholder="ex: 15000"
                                     Variant="Variant.Outlined" FullWidth="true"
                                     Margin="Margin.Dense" Style="border-radius:8px;" />
                </div>
                <div>
                    <label style="display:block; font-size:11px; font-weight:600; letter-spacing:1px;
                                  text-transform:uppercase; color:#6b7280; margin-bottom:6px;">
                        Până la
                    </label>
                    <MudNumericField @bind-Value="_dto.SalaryTo" Placeholder="ex: 30000"
                                     Variant="Variant.Outlined" FullWidth="true"
                                     Margin="Margin.Dense" Style="border-radius:8px;" />
                </div>
            </div>
            <MudCheckBox @bind-Value="_dto.IsSalaryNegotiable"
                         Label="Salariu negociabil"
                         Color="Color.Primary" />
        </div>

        @* Tags *@
        <div style="background:#fff; border:1px solid #e5e7eb; border-radius:16px; padding:28px;">
            <h2 style="font-size:14px; font-weight:700; color:#111827;
               margin:0 0 8px 0; padding-left:12px; border-left:3px solid #6366f1;">
                Tags
            </h2>
            <p style="font-size:13px; color:#9ca3af; margin:0 0 14px 0;">
                Cuvinte cheie pentru anunț (ex: React, TypeScript, Agile)
            </p>

            @* Lista tagurilor adăugate *@
            @if (_tags.Count > 0)
            {
                <div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:14px;">
                    @foreach (var tag in _tags)
                    {
                        <span style="font-size:12px; font-weight:600; color:#4f46e5;
                                     background:#f0eeff; border:1px solid #c4b5fd;
                                     border-radius:16px; padding:5px 12px;
                                     display:flex; align-items:center; gap:8px;">
                            @tag
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           Size="Size.Small"
                                           Style="color:#9ca3af; padding:0; width:16px; height:16px;"
                                           OnClick="@(() => RemoveTag(tag))" />
                        </span>
                    }
                </div>
            }

            @* Câmp adăugare tag *@
            <div style="display:flex; gap:8px; align-items:center;">
                <MudTextField @bind-Value="_newTag"
                              Placeholder="Scrie un tag și apasă Enter"
                              Variant="Variant.Outlined" FullWidth="true"
                              Margin="Margin.Dense" Style="border-radius:8px;"
                              OnKeyDown="OnTagKeyDown"
                              Immediate="true" />
                <MudButton Variant="Variant.Filled"
                           OnClick="AddTag"
                           Disabled="@string.IsNullOrWhiteSpace(_newTag)"
                           Style="background:#6366f1; color:#fff; border-radius:8px;
                          font-size:11px; font-weight:700; letter-spacing:1px;
                          text-transform:uppercase; height:40px; flex-shrink:0;">
                    + Adaugă
                </MudButton>
            </div>
        </div>

        @* Buton submit *@
        <MudButton Variant="Variant.Filled" OnClick="HandleSubmit" Disabled="_submitting"
                   FullWidth="true"
                   Style="background:#6366f1; color:#fff; border-radius:10px;
                          font-size:12px; font-weight:700; letter-spacing:1px;
                          text-transform:uppercase; height:48px;">
            @if (_submitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true"
                                     Color="Color.Surface" Class="mr-2" />
            }
            Publică anunțul
        </MudButton>
    </div>

    @* ── Sidebar sfaturi ── *@
    <div style="display:flex; flex-direction:column; gap:16px; position:sticky; top:24px;">
        <div style="background:#f0eeff; border:1px solid #c4b5fd; border-radius:16px; padding:24px;">
            <p style="font-size:13px; font-weight:700; color:#4f46e5; margin:0 0 14px 0;">
                💡 Sfaturi pentru un anunț eficient
            </p>
            <div style="display:flex; flex-direction:column; gap:10px;">
                @foreach (var tip in _tips)
                {
                    <div style="display:flex; gap:10px; align-items:flex-start;">
                        <span style="color:#6366f1; font-size:14px; flex-shrink:0;">✓</span>
                        <p style="font-size:13px; color:#374151; margin:0; line-height:1.5;">@tip</p>
                    </div>
                }
            </div>
        </div>

        <div style="background:#fff; border:1px solid #e5e7eb; border-radius:16px; padding:20px;">
            <p style="font-size:12px; font-weight:700; color:#9ca3af; text-transform:uppercase;
                      letter-spacing:1px; margin:0 0 10px 0;">
                Câmpuri obligatorii
            </p>
            <div style="display:flex; flex-direction:column; gap:6px;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <span style="color:@(!string.IsNullOrWhiteSpace(_dto.Title) ? "#16a34a" : "#d1d5db");">
                        @(!string.IsNullOrWhiteSpace(_dto.Title) ? "✓" : "○")
                    </span>
                    <p style="font-size:13px; color:#374151; margin:0;">Titlu job</p>
                </div>
                <div style="display:flex; align-items:center; gap:8px;">
                    <span style="color:@(!string.IsNullOrWhiteSpace(_dto.Description) ? "#16a34a" : "#d1d5db");">
                        @(!string.IsNullOrWhiteSpace(_dto.Description) ? "✓" : "○")
                    </span>
                    <p style="font-size:13px; color:#374151; margin:0;">Descriere</p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private CreateJobPostingDto _dto = new();
    private bool _submitting;
    private List<JobCategoryDto> _categories = new();

    private List<string> _tags = new();
    private string _newTag = "";

    private readonly string[] _tips = new[]
    {
        "Titlul clar atrage candidații potriviți",
        "Descrie echipa și cultura companiei",
        "Specifică tehnologiile și experiența necesară",
        "Menționează salariul pentru mai multe aplicări",
        "Adaugă responsabilitățile concrete ale rolului",
    };

    protected override async Task OnInitializedAsync()
    {
        var cats = await Http.GetFromJsonAsync<List<JobCategoryDto>>("api/jobcategories");
        if (cats != null) _categories = cats;
    }
    private void AddTag()
    {
        var tag = _newTag.Trim();
        if (string.IsNullOrWhiteSpace(tag)) return;

        if (!_tags.Any(t => t.Equals(tag, StringComparison.OrdinalIgnoreCase)))
        {
            _tags.Add(tag);
            SyncTags();
        }
        _newTag = "";
    }

    private void RemoveTag(string tag)
    {
        _tags.Remove(tag);
        SyncTags();
    }

    private void OnTagKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            AddTag();
    }

    private void SyncTags()
    {
        _dto.Tags = _tags.Count > 0 ? string.Join(", ", _tags) : null;
    }

    private async Task GoBack()
    {
        await JS.InvokeVoidAsync("history.back");
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_dto.Title) || string.IsNullOrWhiteSpace(_dto.Description))
        {
            Snackbar.Add("Titlul și descrierea sunt obligatorii.", Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/jobs", _dto);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Anunțul a fost publicat cu succes!", Severity.Success);
                Navigation.NavigateTo("/employer/jobs");
            }
            else Snackbar.Add("Eroare la publicarea anunțului. Încercați din nou.", Severity.Error);
        }
        catch { Snackbar.Add("Eroare de conexiune. Încercați din nou.", Severity.Error); }
        finally { _submitting = false; }
    }
}
