@page "/employer/notifications"
@layout EmployerLayout

@using JobFinder.Shared.DTOs.Common
@using JobFinder.Core.Entities.Common
@using System.Net.Http.Json

@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Notificări - JobFinder</PageTitle>

@* ── Titlu ── *@
<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:28px;">
    <div>
        <h1 style="font-size:22px; font-weight:700; color:#111827; margin:0 0 4px 0;">
            Notificările mele
        </h1>
        <p style="font-size:14px; color:#9ca3af; margin:0;">
            Actualizări despre aplicările și activitatea companiei tale pe platformă.
        </p>
    </div>
    @if (_unreadCount > 0)
    {
        <span style="font-size:12px; font-weight:700; padding:6px 16px; border-radius:20px;
                         background:#ede9fe; color:#6366f1;">
            @_unreadCount necitite
        </span>
    }
</div>

@if (_loading)
{
    <div style="display:flex; flex-direction:column; gap:12px;">
        @for (int i = 0; i < 4; i++)
        {
            <div style="height:90px; border-radius:16px;
                                background:linear-gradient(90deg,#f3f4f6 25%,#e9eaec 50%,#f3f4f6 75%);
                                background-size:800px 100%; animation:shimmer 1.4s infinite;"></div>
        }
    </div>
}
else if (_notifications.Count == 0)
{
    <div style="background:#fff; border:1px solid #e5e7eb; border-radius:16px;
                    text-align:center; padding:64px 32px;">
        <MudIcon Icon="@Icons.Material.Filled.NotificationsNone"
                 Style="font-size:48px; color:#d1d5db; display:block; margin:0 auto 12px;" />
        <p style="font-size:16px; font-weight:600; color:#111827; margin:0 0 8px 0;">
            Nicio notificare momentan.
        </p>
        <p style="font-size:14px; color:#9ca3af; margin:0;">
            Când un candidat aplică la joburile tale, le vei vedea aici.
        </p>
    </div>
}
else
{
    <div style="display:flex; flex-direction:column; gap:10px;">
        @foreach (var n in _notifications)
        {
            var accent = GetAccentColor(n.Type);
            var icon = GetMudIcon(n.Type);

            <div style="background:@(n.IsRead ? "#fff" : "#faf9ff");
                                border:1px solid @(n.IsRead ? "#e5e7eb" : "#c4b5fd");
                                border-radius:16px; padding:18px 20px;
                                display:flex; gap:14px; align-items:flex-start;">

                @* Icoaniță tip notificare *@
                <div style="width:42px; height:42px; min-width:42px; border-radius:12px;
                                    display:flex; align-items:center; justify-content:center;
                                    background:@accent.bg;">
                    <MudIcon Icon="@icon" Style="@($"color:{accent.fg}; font-size:20px;")" />
                </div>

                @* Conținut *@
                <div style="flex:1; min-width:0;">
                    <div style="display:flex; justify-content:space-between;
                                        align-items:flex-start; gap:12px; margin-bottom:4px;">
                        <p style="font-size:14px; font-weight:700; color:#111827; margin:0;">
                            @n.Title
                        </p>
                        <span style="font-size:11px; color:#9ca3af; white-space:nowrap; flex-shrink:0;
                                             font-family:'Roboto Mono',monospace;">
                            @n.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        </span>
                    </div>

                    <p style="font-size:13px; color:#6b7280; margin:0 0 10px 0; line-height:1.5;">
                        @n.Message
                    </p>

                    <div style="display:flex; align-items:center; gap:8px;">
                        @if (!string.IsNullOrWhiteSpace(n.Link))
                        {
                            <button type="button"
                                    @onclick="() => NavigateTo(n)"
                                    style="font-size:11px; font-weight:700; padding:6px 14px;
                                                       border-radius:20px; border:1px solid #c4b5fd;
                                                       background:#ede9fe; color:#6366f1;
                                                       text-transform:uppercase; letter-spacing:1px;
                                                       cursor:pointer;">
                                Deschide
                            </button>
                        }
                        @if (!n.IsRead)
                        {
                            <span style="font-size:10px; font-weight:700; padding:3px 10px;
                                                     border-radius:20px; background:#d1fae5; color:#065f46;">
                                Nou
                            </span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    @@keyframes shimmer {
        0% {
            background-position: -800px 0;
        }

        100% {
            background-position: 800px 0;
        }
    }
</style>

@code {
    private readonly List<NotificationDto> _notifications = new();
    private bool _loading = true;
    private int _unreadCount = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<List<NotificationDto>>("api/notification/mine");
            if (result != null)
            {
                _notifications.AddRange(result.OrderByDescending(n => n.CreatedAt));
                _unreadCount = _notifications.Count(n => !n.IsRead);
            }
        }
        finally { _loading = false; }
    }

    private async Task NavigateTo(NotificationDto notif)
    {
        if (!string.IsNullOrWhiteSpace(notif.Link))
        {
            Navigation.NavigateTo(notif.Link);
            if (!notif.IsRead)
            {
                notif.IsRead = true;
                _unreadCount = Math.Max(0, _unreadCount - 1);
                _ = Http.PostAsync($"api/notification/{notif.Id}/read", null);
            }
        }
    }

    private static (string bg, string fg) GetAccentColor(NotificationType type) => type switch
    {
        NotificationType.NewApplicationReceived => ("#d1fae5", "#065f46"),
        NotificationType.ApplicationStatusChanged => ("#ede9fe", "#6366f1"),
        NotificationType.EmploymentConfirmed => ("#fef9c3", "#92400e"),
        NotificationType.SystemSuggestion => ("#fee2e2", "#b91c1c"),
        _ => ("#f3f4f6", "#6b7280")
    };

    private static string GetMudIcon(NotificationType type) => type switch
    {
        NotificationType.NewApplicationReceived => Icons.Material.Filled.PersonAdd,
        NotificationType.ApplicationStatusChanged => Icons.Material.Filled.Update,
        NotificationType.EmploymentConfirmed => Icons.Material.Filled.CheckCircle,
        NotificationType.SystemSuggestion => Icons.Material.Filled.Info,
        _ => Icons.Material.Filled.Notifications
    };
}
