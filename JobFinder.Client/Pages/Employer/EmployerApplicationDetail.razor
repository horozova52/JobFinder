@page "/employer/applications/{Id:int}"
@layout EmployerLayout

@using JobFinder.Shared.DTOs.Application
@using JobFinder.Shared.DTOs.Applications
@using JobFinder.Shared.DTOs.Candidates
@using JobFinder.Shared.DTOs.Jobs
@using JobFinder.Shared.Enums
@using System.Net.Http.Json
@using System.Text.Json

@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Detalii aplicare - JobFinder</PageTitle>

@* ── Înapoi ── *@
<a href="/employer/jobs"
   style="display:inline-flex; align-items:center; gap:6px; font-size:12px; font-weight:600;
          letter-spacing:1px; text-transform:uppercase; color:#6b7280; text-decoration:none;
          margin-bottom:24px;">
    ← Înapoi
</a>


@if (_loading)
{
    <div style="display:flex; flex-direction:column; gap:16px;">
        @for (int i = 0; i < 3; i++)
        {
            <div style="height:100px; border-radius:16px;
                                background:linear-gradient(90deg,#f3f4f6 25%,#e9eaec 50%,#f3f4f6 75%);
                                background-size:800px 100%; animation:shimmer 1.4s infinite;"></div>
        }
    </div>
}
else if (_application == null)
{
    <div style="background:#fff; border:1px solid #e5e7eb; border-radius:16px;
                    text-align:center; padding:64px 32px;">
        <p style="font-size:14px; color:#6b7280; margin:0;">Aplicarea nu a fost găsită.</p>
    </div>
}
else
{
    <div style="display:grid; grid-template-columns:1fr 300px; gap:24px; align-items:start;">

        @* ════════════════════════════════
           COLOANA STÂNGA
        ════════════════════════════════ *@
        <div style="display:flex; flex-direction:column; gap:20px;">

            @* ── Card header candidat ── *@
            <div style="background:#fff; border:1px solid #e5e7eb; border-radius:16px; padding:28px;">
                <div style="display:flex; justify-content:space-between; align-items:flex-start;
                                gap:16px; margin-bottom:16px;">
                    <div style="display:flex; align-items:center; gap:14px; flex:1; min-width:0;">
                        <div style="width:56px; height:56px; min-width:56px; background:#f0eeff;
                                        border-radius:12px; display:flex; align-items:center;
                                        justify-content:center; font-size:20px; font-weight:800;
                                        color:#6366f1; flex-shrink:0;">
                            @(_application.CandidateFullName?.Length >= 2
                                                    ? _application.CandidateFullName[..2].ToUpper() : "?")
                    </div>
                    <div style="flex:1; min-width:0;">
                        <h1 style="font-size:20px; font-weight:700; color:#111827;
                                       margin:0 0 4px 0;">
                            @_application.CandidateFullName
                        </h1>
                        <p style="font-size:13px; color:#9ca3af; margin:0;">
                            A aplicat la <strong style="color:#6366f1;">@_application.JobTitle</strong>
                            · @_application.AppliedAt.ToString("dd MMMM yyyy")
                        </p>
                    </div>
                </div>
                <span style="font-size:12px; font-weight:600; padding:6px 16px;
                                 border-radius:20px; white-space:nowrap; flex-shrink:0;
                                 background:@GetBadgeBg(_application.Status);
                                 color:@GetBadgeFg(_application.Status);">
                    @GetStatusText(_application.Status)
                </span>
            </div>

                @* Contact rapid *@
            @if (_candidateProfile != null)
                {
                    <div style="display:flex; gap:16px; flex-wrap:wrap; padding-top:16px;
                                        border-top:1px solid #f0f0f0;">
                        @if (!string.IsNullOrWhiteSpace(_candidateProfile.Email))
                        {
                            <a href="mailto:@_candidateProfile.Email"
                               style="display:flex; align-items:center; gap:6px; font-size:13px;
                                                  color:#6366f1; text-decoration:none;">
                                <MudIcon Icon="@Icons.Material.Filled.Email" Style="font-size:16px;" />
                                @_candidateProfile.Email
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(_candidateProfile.Phone))
                        {
                            <a href="tel:@_candidateProfile.Phone"
                               style="display:flex; align-items:center; gap:6px; font-size:13px;
                                                  color:#6366f1; text-decoration:none;">
                                <MudIcon Icon="@Icons.Material.Filled.Phone" Style="font-size:16px;" />
                                @_candidateProfile.Phone
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(_candidateProfile.Location))
                        {
                            <span style="display:flex; align-items:center; gap:6px;
                                                     font-size:13px; color:#6b7280;">
                                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Style="font-size:16px; color:#9ca3af;" />
                                @_candidateProfile.Location
                            </span>
                        }
                    </div>
                }
            </div>

            @* ── Profil candidat ── *@
            @if (_candidateProfile != null)
            {
                @* Despre *@
                @if (!string.IsNullOrWhiteSpace(_candidateProfile.Summary))
                {
                    <div style="background:#fff; border:1px solid #e5e7eb; border-radius:16px; padding:28px;">
                        <h2 style="font-size:14px; font-weight:700; color:#111827;
                                               margin:0 0 14px 0; padding-left:12px; border-left:3px solid #6366f1;">
                            Despre candidat
                        </h2>
                        <p style="font-size:14px; color:#374151; line-height:1.7; margin:0;">
                            @_candidateProfile.Summary
                        </p>
                    </div>
                }

                @* Experiență *@
                @if (_candidateProfile.Experiences?.Any() == true)
                {
                    <div style="background:#fff; border:1px solid #e5e7eb; border-radius:16px; padding:28px;">
                        <h2 style="font-size:14px; font-weight:700; color:#111827;
                                               margin:0 0 16px 0; padding-left:12px; border-left:3px solid #6366f1;">
                            Experiență
                        </h2>
                        <div style="display:flex; flex-direction:column; gap:14px;">
                            @foreach (var exp in _candidateProfile.Experiences.Take(4))
                            {
                                <div style="display:flex; gap:12px; align-items:flex-start;">
                                    <div style="width:36px; height:36px; min-width:36px; background:#f3f4f6;
                                                                border-radius:8px; display:flex; align-items:center;
                                                                justify-content:center;">
                                        <MudIcon Icon="@Icons.Material.Filled.Business"
                                                 Style="font-size:18px; color:#6b7280;" />
                                    </div>
                                    <div>
                                        <p style="font-size:14px; font-weight:700; color:#111827; margin:0 0 2px 0;">
                                            @exp.Position
                                        </p>
                                        <p style="font-size:13px; color:#6b7280; margin:0 0 2px 0;">
                                            @exp.CompanyName
                                        </p>
                                        <p style="font-size:12px; color:#9ca3af; margin:0;">
                                            @exp.StartDate.Year – @(exp.IsCurrent ? "Prezent" : exp.EndDate?.Year.ToString())
                                        </p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @* Competențe *@
                @if (_candidateProfile.Skills?.Any() == true)
                {
                    <div style="background:#fff; border:1px solid #e5e7eb; border-radius:16px; padding:28px;">
                        <h2 style="font-size:14px; font-weight:700; color:#111827;
                                               margin:0 0 16px 0; padding-left:12px; border-left:3px solid #6366f1;">
                            Competențe
                        </h2>
                        <div style="display:flex; gap:8px; flex-wrap:wrap;">
                            @foreach (var skill in _candidateProfile.Skills)
                            {
                                var isMatch = _jobSkillIds.Contains(skill.SkillId);
                                <span style="font-size:12px; font-weight:600; padding:6px 14px;
                                                             border-radius:20px;
                                                             background:@(isMatch ? "#d1fae5" : "#f3f4f6");
                                                             color:@(isMatch ? "#065f46" : "#6b7280");
                                                             border:1px solid @(isMatch ? "#6ee7b7" : "#e5e7eb");">
                                    @if (isMatch)
                                    {
                                        <span>✓ </span>
                                    }
                                    @skill.SkillName
                                </span>
                            }
                        </div>
                        @if (_matchPercent > 0)
                        {
                            <p style="font-size:12px; color:#9ca3af; margin:12px 0 0 0;">
                                @_candidateProfile.Skills.Count(s => _jobSkillIds.Contains(s.SkillId)) din
                                @_jobSkillIds.Count competențe cerute de job
                            </p>
                        }
                    </div>
                }
            }

            @* ── Scrisoare de intenție ── *@
            @if (!string.IsNullOrWhiteSpace(_application.CoverLetter))
            {
                <div style="background:#fff; border:1px solid #e5e7eb; border-radius:16px; padding:28px;">
                    <h2 style="font-size:14px; font-weight:700; color:#111827;
                                       margin:0 0 14px 0; padding-left:12px; border-left:3px solid #6366f1;">
                        Scrisoare de intenție
                    </h2>
                    <div style="background:#f5f3ff; border-radius:10px; padding:16px 20px;">
                        <p style="font-size:14px; color:#374151; margin:0; line-height:1.7;
                                          white-space:pre-line;">
                            @_application.CoverLetter
                        </p>
                    </div>
                </div>
            }

            @* ── Actualizare status ── *@
            <div style="background:#fff; border:1px solid #e5e7eb; border-radius:16px; padding:28px;">
                <h2 style="font-size:14px; font-weight:700; color:#111827;
                               margin:0 0 16px 0; padding-left:12px; border-left:3px solid #6366f1;">
                    Actualizare status
                </h2>
                <div style="display:flex; gap:8px; flex-wrap:wrap;">
                    @foreach (var (state, label) in _statusOptions)
                    {
                        var isActive = _application.Status == state;
                        <button @onclick="() => UpdateStatus(state)"
                                disabled="@(_updatingStatus || isActive)"
                                style="font-size:12px; font-weight:600; padding:8px 18px;
                                               border-radius:20px; cursor:pointer;
                                               border:2px solid @(isActive? GetBadgeFg(state) : "#e5e7eb");
                                               color:@(isActive? GetBadgeFg(state) : "#6b7280");
                                               background:@(isActive? GetBadgeBg(state) : "#fff");
                                               opacity:@(_updatingStatus ? "0.6" : "1");
                                               transition:all 0.15s;">
                            @label
                        </button>
                    }
                </div>

                @* Validare angajare *@
                @if (_application.Status == ApplicationState.Accepted)
                {
                    @if (_pendingConfirmation != null)
                    {
                        <div style="margin-top:20px; background:#fefce8; border:1px solid #fde68a;
                                                border-radius:12px; padding:20px;">
                            <p style="font-size:14px; font-weight:700; color:#92400e; margin:0 0 6px 0;">
                                ⏳ Candidatul a confirmat angajarea și așteaptă validarea ta.
                            </p>
                            <p style="font-size:13px; color:#78350f; margin:0 0 16px 0;">
                                Confirmat pe @_pendingConfirmation.ConfirmedAt.ToString("dd.MM.yyyy").
                                Validarea adaugă automat experiența în profilul candidatului.
                            </p>
                            <div style="display:flex; gap:10px;">
                                <MudButton Variant="Variant.Filled"
                                           OnClick="ValidateEmployment"
                                           Disabled="_validating"
                                           Style="background:#16a34a; color:#fff; border-radius:10px;
                                                              font-size:12px; font-weight:700; height:40px; padding:0 20px;">
                                    @(_validating ? "Se procesează..." : "✓ Validează angajarea")
                                </MudButton>
                                <MudButton Variant="Variant.Outlined"
                                           OnClick="RejectEmployment"
                                           Disabled="_validating"
                                           Style="border-color:#dc2626; color:#dc2626; border-radius:10px;
                                                              font-size:12px; font-weight:700; height:40px; padding:0 20px;">
                                    Respinge
                                </MudButton>
                            </div>
                        </div>
                    }
                    else if (_confirmationValidated)
                    {
                        <div style="margin-top:16px; background:#f0fdf4; border:1px solid #bbf7d0;
                                                border-radius:12px; padding:16px 20px;">
                            <p style="font-size:14px; font-weight:700; color:#15803d; margin:0;">
                                ✓ Angajarea validată. Experiența a fost adăugată în profilul candidatului.
                            </p>
                        </div>
                    }
                }
            </div>
        </div>

        @* ════════════════════════════════
           COLOANA DREAPTA — sidebar
        ════════════════════════════════ *@
        <div style="display:flex; flex-direction:column; gap:16px; position:sticky; top:24px;">

            @* ── Match score ── *@
            @if (_matchPercent > 0)
            {
                <div style="background:#fff; border:1px solid #e5e7eb; border-radius:16px;
                                    padding:24px; text-align:center;">
                    <p style="font-size:11px; font-weight:600; color:#9ca3af; text-transform:uppercase;
                                      letter-spacing:1px; margin:0 0 12px 0;">
                        Compatibilitate
                    </p>
                    <div style="width:80px; height:80px; border-radius:50%; margin:0 auto 12px auto;
                                        background:@GetMatchBg(_matchPercent);
                                        display:flex; align-items:center; justify-content:center;
                                        font-size:24px; font-weight:800; color:@GetMatchColor(_matchPercent);
                                        border:3px solid @GetMatchBorder(_matchPercent);">
                        @_matchPercent%
                    </div>
                    <p style="font-size:13px; color:#6b7280; margin:0;">
                        @GetMatchLabel(_matchPercent)
                    </p>
                </div>
            }

            @* ── Acțiuni rapide ── *@
            <div style="background:#fff; border:1px solid #e5e7eb; border-radius:16px; padding:24px;">
                <p style="font-size:12px; font-weight:700; color:#9ca3af; text-transform:uppercase;
                              letter-spacing:1px; margin:0 0 14px 0;">
                    Acțiuni
                </p>
                <div style="display:flex; flex-direction:column; gap:8px;">
                    <MudButton Variant="Variant.Filled"
                               OnClick="GoToMessages"
                               FullWidth="true"
                               Style="background:#6366f1; color:#fff; border-radius:10px;
                                          font-size:12px; font-weight:700; height:40px;">
                        Deschide conversația
                    </MudButton>
                    @if (!string.IsNullOrWhiteSpace(_candidateProfile?.LinkedIn))
                    {
                        <a href="@_candidateProfile.LinkedIn" target="_blank"
                           style="display:block; text-align:center; padding:10px;
                                          background:#f0eeff; border-radius:10px;
                                          font-size:12px; font-weight:700; color:#6366f1; text-decoration:none;">
                            Vezi profil LinkedIn
                        </a>
                    }
                </div>
            </div>

            @* ── Info aplicare ── *@
            <div style="background:#fff; border:1px solid #e5e7eb; border-radius:16px; padding:24px;">
                <p style="font-size:12px; font-weight:700; color:#9ca3af; text-transform:uppercase;
                              letter-spacing:1px; margin:0 0 14px 0;">
                    Detalii aplicare
                </p>
                <div style="display:flex; flex-direction:column; gap:10px;">
                    <div>
                        <p style="font-size:11px; color:#9ca3af; margin:0 0 2px 0;">Job</p>
                        <p style="font-size:13px; font-weight:600; color:#111827; margin:0;">
                            @_application.JobTitle
                        </p>
                    </div>
                    <div>
                        <p style="font-size:11px; color:#9ca3af; margin:0 0 2px 0;">Data aplicării</p>
                        <p style="font-size:13px; font-weight:600; color:#111827; margin:0;">
                            @_application.AppliedAt.ToString("dd MMMM yyyy")
                        </p>
                    </div>
                    <div>
                        <p style="font-size:11px; color:#9ca3af; margin:0 0 2px 0;">Status curent</p>
                        <span style="font-size:12px; font-weight:600; padding:4px 12px;
                                         border-radius:20px;
                                         background:@GetBadgeBg(_application.Status);
                                         color:@GetBadgeFg(_application.Status);">
                            @GetStatusText(_application.Status)
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    @@keyframes shimmer {
        0% {
            background-position: -800px 0;
        }

        100% {
            background-position: 800px 0;
        }
    }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private ApplicationDto? _application;
    private CandidateProfileDto? _candidateProfile;
    private HashSet<int> _jobSkillIds = new();
    private EmploymentConfirmationDto? _pendingConfirmation;

    private bool _loading = true;
    private bool _updatingStatus = false;
    private bool _validating = false;
    private bool _confirmationValidated = false;
    private int _matchPercent = 0;

    private readonly List<(ApplicationState State, string Label)> _statusOptions = new()
    {
        (ApplicationState.Pending,   "În așteptare"),
        (ApplicationState.InReview,  "În analiză"),
        (ApplicationState.Interview, "Interviu"),
        (ApplicationState.Accepted,  "Acceptat"),
        (ApplicationState.Rejected,  "Respins"),
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var appResponse = await Http.GetAsync($"api/applications/{Id}/detail");
            if (!appResponse.IsSuccessStatusCode) { _loading = false; return; }

            _application = await appResponse.Content.ReadFromJsonAsync<ApplicationDto>(
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            await LoadCandidateProfile();
            await LoadJobSkillsAndMatch();
            await LoadEmploymentConfirmation();
        }
        catch { }
        finally { _loading = false; }
    }

    private async Task LoadCandidateProfile()
    {
        if (_application == null) return;
        var r = await Http.GetAsync($"api/candidateprofile/by-id/{_application.CandidateProfileId}");
        if (r.IsSuccessStatusCode)
            _candidateProfile = await r.Content.ReadFromJsonAsync<CandidateProfileDto>(
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
    }

    private async Task LoadJobSkillsAndMatch()
    {
        if (_application == null) return;
        var r = await Http.GetAsync($"api/jobs/{_application.JobPostingId}/skills");
        if (!r.IsSuccessStatusCode) return;

        var jobSkills = await r.Content.ReadFromJsonAsync<List<JobSkillDto>>(
            new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        if (jobSkills == null || jobSkills.Count == 0) return;

        _jobSkillIds = jobSkills.Select(js => js.SkillId).ToHashSet();

        if (_candidateProfile?.Skills?.Any() == true)
        {
            var matched = _candidateProfile.Skills.Count(s => _jobSkillIds.Contains(s.SkillId));
            _matchPercent = (int)Math.Round(100.0 * matched / _jobSkillIds.Count);
        }
    }

    private async Task LoadEmploymentConfirmation()
    {
        if (_application == null) return;
        var r = await Http.GetAsync($"api/employment-confirmations/by-application/{Id}");
        if (!r.IsSuccessStatusCode) return;

        var conf = await r.Content.ReadFromJsonAsync<EmploymentConfirmationDto>(
            new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        if (conf == null) return;

        if (conf.Status == EmploymentConfirmationStatus.PendingValidation)
            _pendingConfirmation = conf;
        else if (conf.Status == EmploymentConfirmationStatus.Validated)
            _confirmationValidated = true;
    }

    private async Task UpdateStatus(ApplicationState newStatus)
    {
        if (_application == null || _application.Status == newStatus) return;
        _updatingStatus = true;
        try
        {
            var r = await Http.PutAsJsonAsync($"api/applications/{Id}/status", new { Status = (int)newStatus });
            if (r.IsSuccessStatusCode)
            {
                _application.Status = newStatus;
                Snackbar.Add($"Status actualizat: {GetStatusText(newStatus)}", Severity.Success);
            }
            else Snackbar.Add("Eroare la actualizarea statusului.", Severity.Error);
        }
        catch { Snackbar.Add("Eroare de conexiune.", Severity.Error); }
        finally { _updatingStatus = false; }
    }

    private async Task ValidateEmployment()
    {
        if (_pendingConfirmation == null) return;
        _validating = true;
        try
        {
            var r = await Http.PutAsJsonAsync(
                $"api/employment-confirmations/{_pendingConfirmation.Id}/validate",
                new { Approved = true });
            if (r.IsSuccessStatusCode)
            {
                _pendingConfirmation = null;
                _confirmationValidated = true;
                Snackbar.Add("Angajarea validată! Experiența adăugată în profil.", Severity.Success);
            }
            else Snackbar.Add("Eroare la validare.", Severity.Error);
        }
        catch { Snackbar.Add("Eroare de conexiune.", Severity.Error); }
        finally { _validating = false; }
    }

    private async Task RejectEmployment()
    {
        if (_pendingConfirmation == null) return;
        _validating = true;
        try
        {
            var r = await Http.PutAsJsonAsync(
                $"api/employment-confirmations/{_pendingConfirmation.Id}/validate",
                new { Approved = false });
            if (r.IsSuccessStatusCode) { _pendingConfirmation = null; Snackbar.Add("Confirmare respinsă.", Severity.Info); }
            else Snackbar.Add("Eroare.", Severity.Error);
        }
        catch { Snackbar.Add("Eroare de conexiune.", Severity.Error); }
        finally { _validating = false; }
    }

    private void GoToMessages() => Navigation.NavigateTo("/employer/messages");

    // ── Match helpers ─────────────────────────────────────────────────
    private static string GetMatchBg(int s) => s switch { >= 80 => "#d1fae5", >= 50 => "#fef9c3", >= 20 => "#ede9fe", _ => "#f3f4f6" };
    private static string GetMatchColor(int s) => s switch { >= 80 => "#065f46", >= 50 => "#92400e", >= 20 => "#4f46e5", _ => "#6b7280" };
    private static string GetMatchBorder(int s) => s switch { >= 80 => "#6ee7b7", >= 50 => "#fde68a", >= 20 => "#c4b5fd", _ => "#e5e7eb" };
    private static string GetMatchLabel(int s) => s switch { >= 80 => "Potrivire excelentă", >= 50 => "Potrivire bună", >= 20 => "Potrivire parțială", _ => "Potrivire scăzută" };

    // ── Status helpers ────────────────────────────────────────────────
    private static string GetStatusText(ApplicationState s) => s switch
    {
        ApplicationState.Pending => "În așteptare",
        ApplicationState.InReview => "În analiză",
        ApplicationState.Interview => "Interviu",
        ApplicationState.Accepted => "Acceptat",
        ApplicationState.Rejected => "Respins",
        ApplicationState.Withdrawn => "Retras",
        _ => s.ToString()
    };

    private static string GetBadgeBg(ApplicationState s) => s switch
    {
        ApplicationState.Accepted => "#d1fae5",
        ApplicationState.Rejected => "#fee2e2",
        ApplicationState.Interview => "#dbeafe",
        ApplicationState.InReview => "#fef9c3",
        ApplicationState.Withdrawn => "#f3f4f6",
        _ => "#ede9fe"
    };

    private static string GetBadgeFg(ApplicationState s) => s switch
    {
        ApplicationState.Accepted => "#065f46",
        ApplicationState.Rejected => "#b91c1c",
        ApplicationState.Interview => "#1d4ed8",
        ApplicationState.InReview => "#92400e",
        ApplicationState.Withdrawn => "#6b7280",
        _ => "#4f46e5"
    };
}
