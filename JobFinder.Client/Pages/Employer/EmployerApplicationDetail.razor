@page "/employer/applications/{Id:int}"
@layout EmployerLayout

@using JobFinder.Shared.DTOs.Application
@using JobFinder.Shared.DTOs.Applications
@using JobFinder.Shared.DTOs.Candidates
@using JobFinder.Shared.DTOs.Jobs
@using JobFinder.Shared.Enums
@using System.Net.Http.Json
@using System.Text.Json

@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Detalii aplicare - JobFinder</PageTitle>

<a href="/employer/jobs"
   style="font-size:12px; font-weight:600; letter-spacing:1px; text-transform:uppercase;
          color:#6b7280; text-decoration:none; display:inline-block; margin-bottom:24px;">
    ← Înapoi
</a>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Style="margin-top:16px;" />
}
else if (_application == null)
{
    <p style="font-size:14px; color:#6b7280; padding:32px 0;">Aplicarea nu a fost găsită.</p>
}
else
{
    @* ── Header ── *@
    <div style="display:flex; justify-content:space-between; align-items:flex-start;
                margin-top:16px; margin-bottom:8px; gap:16px;">
        <h1 style="font-size:24px; font-weight:700; color:#111827; margin:0;">
            @_application.CandidateFullName
        </h1>
        <StatusBadge Status="@GetStatusText(_application.Status)"
                     Variant="@GetStatusVariant(_application.Status)" />
    </div>
    <p style="font-size:14px; color:#6b7280; margin:0 0 8px 0;">
        A aplicat la <strong>@_application.JobTitle</strong>
        · @_application.AppliedAt.ToString("dd MMMM yyyy")
    </p>
    @if (_matchPercent > 0)
    {
        <p style="font-size:13px; color:#6366f1; font-weight:600; margin:0 0 24px 0;">
            @_matchPercent% compatibilitate cu jobul
        </p>
    }

    <div style="border-bottom:1px solid #e5e7eb; margin-bottom:32px;"></div>

    @* ── Profil candidat ── *@
    @if (_candidateProfile != null)
    {
        <section style="margin-bottom:32px;">
            <h2 style="font-size:14px; font-weight:700; color:#111827; margin-bottom:16px;">
                Profil candidat
            </h2>
            <div style="border:1px solid #e5e7eb; padding:20px;
                        display:flex; flex-direction:column; gap:12px;">

                @if (!string.IsNullOrWhiteSpace(_candidateProfile.Email))
                {
                    <p style="font-size:14px; margin:0;">
                        <span style="color:#6b7280;">Email: </span>@_candidateProfile.Email
                    </p>
                }
                @if (!string.IsNullOrWhiteSpace(_candidateProfile.Phone))
                {
                    <p style="font-size:14px; margin:0;">
                        <span style="color:#6b7280;">Telefon: </span>@_candidateProfile.Phone
                    </p>
                }
                @if (!string.IsNullOrWhiteSpace(_candidateProfile.Location))
                {
                    <p style="font-size:14px; margin:0;">
                        <span style="color:#6b7280;">Locație: </span>@_candidateProfile.Location
                    </p>
                }
                @if (!string.IsNullOrWhiteSpace(_candidateProfile.Summary))
                {
                    <p style="font-size:14px; margin:0; line-height:1.6;">
                        <span style="color:#6b7280;">Despre: </span>@_candidateProfile.Summary
                    </p>
                }

                @* Experiență ── *@
                @if (_candidateProfile.Experiences?.Any() == true)
                {
                    <div>
                        <p style="font-size:12px; font-weight:600; color:#6b7280;
                                  letter-spacing:1px; text-transform:uppercase; margin:0 0 8px 0;">
                            Experiență
                        </p>
                        @foreach (var exp in _candidateProfile.Experiences.Take(3))
                        {
                            <p style="font-size:14px; margin:0 0 4px 0;">
                                <strong>@exp.Position</strong> — @exp.CompanyName
                                <span style="color:#6b7280; font-size:12px;">
                                    (@exp.StartDate.Year – @(exp.IsCurrent ? "Prezent" : exp.EndDate?.Year.ToString()))
                                </span>
                            </p>
                        }
                    </div>
                }

                @* Skills ── *@
                @if (_candidateProfile.Skills?.Any() == true)
                {
                    <div style="display:flex; gap:6px; flex-wrap:wrap;">
                        @foreach (var skill in _candidateProfile.Skills)
                        {
                            var isMatch = _jobSkillIds.Contains(skill.SkillId);
                            <span style="font-size:11px; font-weight:600; padding:2px 8px;
                                         color:@(isMatch ? "#16a34a" : "#6b7280");
                                         border:1px solid @(isMatch ? "#bbf7d0" : "#e5e7eb");
                                         background:@(isMatch ? "#f0fdf4" : "transparent");">
                                @skill.SkillName
                            </span>
                        }
                    </div>
                }

                @* Link CV / profil public ── *@
                @if (!string.IsNullOrWhiteSpace(_candidateProfile.LinkedIn))
                {
                    <a href="@_candidateProfile.LinkedIn" target="_blank"
                       style="font-size:13px; color:#6366f1; text-decoration:none;">
                        Vezi profilul complet (LinkedIn) →
                    </a>
                }
            </div>
        </section>
    }

    @* Scrisoare de intenție ── *@
    @if (!string.IsNullOrWhiteSpace(_application.CoverLetter))
    {
        <section style="margin-bottom:32px;">
            <h2 style="font-size:14px; font-weight:700; color:#111827; margin-bottom:12px;">
                Scrisoare de intenție
            </h2>
            <div style="border:1px solid #e5e7eb; padding:16px; background:#fafafa;">
                <p style="font-size:14px; color:#374151; margin:0; line-height:1.7;
                          white-space:pre-line;">
                    @_application.CoverLetter
                </p>
            </div>
        </section>
    }

    @* ── Actualizare status ── *@
    <section style="margin-bottom:32px;">
        <h2 style="font-size:14px; font-weight:700; color:#111827; margin-bottom:16px;">
            Actualizare status
        </h2>
        <div style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:16px;">
            @foreach (var (state, label) in _statusOptions)
            {
                var isActive = _application.Status == state;
                <button @onclick="() => UpdateStatus(state)"
                        disabled="@(_updatingStatus || isActive)"
                        style="font-size:11px; font-weight:600; letter-spacing:1px;
                               text-transform:uppercase; padding:10px 18px; cursor:pointer;
                               border:1px solid @(isActive ? "#6366f1" : "#e5e7eb");
                               color:@(isActive ? "#6366f1" : "#6b7280");
                               background:@(isActive ? "#ede9fe" : "transparent");
                               opacity:@(_updatingStatus ? 0.6 : 1);
                               transition:all 0.15s;">
                    @label
                </button>
            }
        </div>

        @* Validare angajare ── *@
        @if (_application.Status == ApplicationState.Accepted)
        {
            @if (_pendingConfirmation != null)
            {
                <div style="border:1px solid #fde68a; background:#fefce8;
                            padding:16px 20px; margin-top:16px;">
                    <p style="font-size:14px; font-weight:600; color:#92400e; margin:0 0 8px 0;">
                        ⏳ Candidatul a confirmat angajarea și așteaptă validarea ta.
                    </p>
                    <p style="font-size:13px; color:#78350f; margin:0 0 12px 0;">
                        Confirmat pe @_pendingConfirmation.ConfirmedAt.ToString("dd.MM.yyyy").
                        Validarea adaugă automat experiența în profilul candidatului.
                    </p>
                    <div style="display:flex; gap:10px;">
                        <MudButton Variant="Variant.Filled"
                                   OnClick="ValidateEmployment"
                                   Disabled="_validating"
                                   Style="background:#16a34a; color:#fff; border-radius:0;
                                          font-size:11px; font-weight:600; letter-spacing:2px;
                                          text-transform:uppercase; padding:10px 20px;">
                            @(_validating ? "Se procesează..." : "✓ Validează angajarea")
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   OnClick="RejectEmployment"
                                   Disabled="_validating"
                                   Style="border-radius:0; border-color:#dc2626; color:#dc2626;
                                          font-size:11px; font-weight:600; letter-spacing:2px;
                                          text-transform:uppercase; padding:10px 20px;">
                            Respinge
                        </MudButton>
                    </div>
                </div>
            }
            else if (_confirmationValidated)
            {
                <div style="border:1px solid #bbf7d0; background:#f0fdf4;
                            padding:16px 20px; margin-top:16px;">
                    <p style="font-size:14px; font-weight:600; color:#15803d; margin:0;">
                        ✓ Angajarea a fost validată. Experiența a fost adăugată în profilul candidatului.
                    </p>
                </div>
            }
        }
    </section>

    <div style="border-bottom:1px solid #e5e7eb; margin-bottom:32px;"></div>

    @* ── Mesagerie ── *@
    <section>
        <h2 style="font-size:14px; font-weight:700; color:#111827; margin-bottom:16px;">
            Mesagerie
        </h2>
        <MudButton Variant="Variant.Outlined"
                   OnClick="GoToMessages"
                   Style="border-radius:0; border-color:#6366f1; color:#6366f1;
                          font-size:11px; font-weight:600; letter-spacing:2px;
                          text-transform:uppercase; padding:10px 20px;">
            Deschide conversația →
        </MudButton>
    </section>
}

@code {
    [Parameter] public int Id { get; set; }

    private ApplicationDto?      _application;
    private CandidateProfileDto? _candidateProfile;
    private HashSet<int>         _jobSkillIds = new();
    private EmploymentConfirmationDto? _pendingConfirmation;

    private bool _loading                = true;
    private bool _updatingStatus         = false;
    private bool _validating             = false;
    private bool _confirmationValidated  = false;
    private int  _matchPercent           = 0;

    private readonly List<(ApplicationState State, string Label)> _statusOptions = new()
    {
        (ApplicationState.Pending,   "În așteptare"),
        (ApplicationState.InReview,  "În analiză"),
        (ApplicationState.Interview, "Interviu"),
        (ApplicationState.Accepted,  "Acceptat"),
        (ApplicationState.Rejected,  "Respins"),
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var appResponse = await Http.GetAsync($"api/applications/{Id}/detail");
            if (!appResponse.IsSuccessStatusCode)
            {
                _loading = false;
                return;
            }

            _application = await appResponse.Content.ReadFromJsonAsync<ApplicationDto>(
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            await LoadCandidateProfile();
            await LoadJobSkillsAndMatch();
            await LoadEmploymentConfirmation();
        }
        catch
        {
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadCandidateProfile()
    {
        if (_application == null) return;

        // Endpoint: GET api/candidateprofile/by-id/{profileId}
        var response = await Http.GetAsync(
            $"api/candidateprofile/by-id/{_application.CandidateProfileId}");

        if (response.IsSuccessStatusCode)
        {
            _candidateProfile = await response.Content.ReadFromJsonAsync<CandidateProfileDto>(
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        }
    }

    private async Task LoadJobSkillsAndMatch()
    {
        if (_application == null) return;

        var response = await Http.GetAsync(
            $"api/jobs/{_application.JobPostingId}/skills");

        if (!response.IsSuccessStatusCode)
            return;

        var jobSkills = await response.Content.ReadFromJsonAsync<List<JobSkillDto>>(
            new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

        if (jobSkills == null || jobSkills.Count == 0)
            return;

        _jobSkillIds = jobSkills.Select(js => js.SkillId).ToHashSet();

        if (_candidateProfile?.Skills?.Any() == true)
        {
            var candidateSkillIds = _candidateProfile.Skills
                .Select(s => s.SkillId)
                .ToHashSet();

            var matched = candidateSkillIds.Intersect(_jobSkillIds).Count();
            var total   = _jobSkillIds.Count;

            _matchPercent = (int)Math.Round(100.0 * matched / total);
        }
    }

    private async Task LoadEmploymentConfirmation()
    {
        if (_application == null) return;

        var confirmResponse = await Http.GetAsync(
            $"api/employment-confirmations/by-application/{Id}");

        if (!confirmResponse.IsSuccessStatusCode)
            return;

        var conf = await confirmResponse.Content.ReadFromJsonAsync<EmploymentConfirmationDto>(
            new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

        if (conf == null) return;

        if (conf.Status == EmploymentConfirmationStatus.PendingValidation)
            _pendingConfirmation = conf;
        else if (conf.Status == EmploymentConfirmationStatus.Validated)
            _confirmationValidated = true;
    }

    private async Task UpdateStatus(ApplicationState newStatus)
    {
        if (_application == null || _application.Status == newStatus) return;

        _updatingStatus = true;
        try
        {
            var response = await Http.PutAsJsonAsync(
                $"api/applications/{Id}/status",
                new { Status = (int)newStatus });

            if (response.IsSuccessStatusCode)
            {
                _application.Status = newStatus;
                Snackbar.Add($"Status actualizat: {GetStatusText(newStatus)}", Severity.Success);
            }
            else
            {
                Snackbar.Add("Eroare la actualizarea statusului.", Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("Eroare de conexiune.", Severity.Error);
        }
        finally
        {
            _updatingStatus = false;
        }
    }

    private async Task ValidateEmployment()
    {
        if (_pendingConfirmation == null) return;
        _validating = true;
        try
        {
            var response = await Http.PutAsJsonAsync(
                $"api/employment-confirmations/{_pendingConfirmation.Id}/validate",
                new { Approved = true });

            if (response.IsSuccessStatusCode)
            {
                _pendingConfirmation   = null;
                _confirmationValidated = true;
                Snackbar.Add("Angajarea a fost validată! Experiența a fost adăugată în profilul candidatului.",
                    Severity.Success);
            }
            else
            {
                Snackbar.Add("Eroare la validare.", Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("Eroare de conexiune.", Severity.Error);
        }
        finally
        {
            _validating = false;
        }
    }

    private async Task RejectEmployment()
    {
        if (_pendingConfirmation == null) return;
        _validating = true;
        try
        {
            var response = await Http.PutAsJsonAsync(
                $"api/employment-confirmations/{_pendingConfirmation.Id}/validate",
                new { Approved = false });

            if (response.IsSuccessStatusCode)
            {
                _pendingConfirmation = null;
                Snackbar.Add("Confirmarea a fost respinsă.", Severity.Info);
            }
            else
            {
                Snackbar.Add("Eroare.", Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("Eroare de conexiune.", Severity.Error);
        }
        finally
        {
            _validating = false;
        }
    }

    private void GoToMessages()
        => Navigation.NavigateTo("/employer/messages");

    private static string GetStatusText(ApplicationState s) => s switch
    {
        ApplicationState.Pending   => "În așteptare",
        ApplicationState.InReview  => "În analiză",
        ApplicationState.Interview => "Interviu",
        ApplicationState.Accepted  => "Acceptat",
        ApplicationState.Rejected  => "Respins",
        ApplicationState.Withdrawn => "Retras",
        _ => s.ToString()
    };

    private static string GetStatusVariant(ApplicationState s) => s switch
    {
        ApplicationState.Pending   => "warning",
        ApplicationState.InReview  => "warning",
        ApplicationState.Interview => "default",
        ApplicationState.Accepted  => "success",
        ApplicationState.Rejected  => "destructive",
        ApplicationState.Withdrawn => "muted",
        _ => "default"
    };
}
