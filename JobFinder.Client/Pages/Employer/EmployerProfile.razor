@page "/employer/profile"
@layout EmployerLayout

@using JobFinder.Shared.DTOs.Employers
@using JobFinder.Shared.DTOs.Jobs
@using JobFinder.Shared.Enums
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms

@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Profil companie - JobFinder</PageTitle>

@if (_isLoading)
{
    <div style="text-align:center; padding:60px 0;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        <MudText Typo="Typo.body2" Style="color:#6b7280; margin-top:16px;">
            Se încarcă profilul...
        </MudText>
    </div>
}
else if (_isEditing)
{
    @* ════════════════════════════════════════════════════════
       EDIT MODE
    ════════════════════════════════════════════════════════ *@

    <div style="display:flex; justify-content:space-between;
                align-items:flex-start; margin-bottom:28px;">
        <div>
            <MudText Typo="Typo.h5"
                     Style="font-weight:700; color:#111827; margin-bottom:4px;">
                Editează profilul
            </MudText>
            <MudText Typo="Typo.body2" Style="color:#6b7280;">
                Modifică informațiile companiei și salvează.
            </MudText>
        </div>
    </div>

    @* ── Bara completitudine ── *@
    <MudPaper Elevation="0" Class="pa-4 mb-6"
              Style="border:1px solid #e5e7eb; background:#fafafa;">
        <div style="display:flex; justify-content:space-between;
                    align-items:center; margin-bottom:8px;">
            <MudText Typo="Typo.caption"
                     Style="font-weight:700; letter-spacing:1px;
                            text-transform:uppercase; color:#111827;">
                Completitudine profil
            </MudText>
            <MudText Typo="Typo.caption"
                     Style="font-weight:700; color:#6366f1;">
                @_completionPct%
            </MudText>
        </div>
        <MudProgressLinear Value="@_completionPct" Color="Color.Primary"
                           Style="height:4px; border-radius:0;" />
        <MudText Typo="Typo.caption"
                 Style="color:#9ca3af; margin-top:8px; display:block;">
            @GetCompletionHint()
        </MudText>
    </MudPaper>

    @* ── Secțiunea 1: Logo Upload ── *@
    <MudPaper Elevation="0" Class="mb-4" Style="border:1px solid #e5e7eb;">
        <div style="padding:14px 20px; border-bottom:1px solid #e5e7eb;">
            <span style="@SectionLabelStyle">Logo companie</span>
        </div>
        <div style="padding:20px;">
            <div style="display:flex; align-items:center; gap:20px;">
                @if (!string.IsNullOrWhiteSpace(_currentLogoUrl))
                {
                    <div style="width:80px; height:80px; border:2px solid #e5e7eb; overflow:hidden;">
                        <img src="@_currentLogoUrl" alt="Logo"
                             style="width:100%; height:100%; object-fit:cover;" />
                    </div>
                }
                else
                {
                    <MudAvatar Style="width:80px; height:80px; background:#ede9fe;
                                      border:2px solid #e5e7eb; font-size:24px;
                                      font-weight:700; color:#6366f1; border-radius:0;">
                        @LogoInitials
                    </MudAvatar>
                }
                <div>
                    <MudText Typo="Typo.body2"
                             Style="font-weight:600; color:#111827; margin-bottom:4px;">
                        @(_isUploadingLogo ? "Se încarcă..." : "Încarcă logo companie")
                    </MudText>
                    <MudText Typo="Typo.caption"
                             Style="color:#9ca3af; display:block; margin-bottom:8px;">
                        JPG, PNG sau WEBP — max 2MB
                    </MudText>
                    <label style="display:inline-block; cursor:pointer; background:#6366f1; color:#fff;
                                  font-size:11px; font-weight:600; letter-spacing:2px;
                                  text-transform:uppercase; padding:8px 16px; border-radius:0;">
                        Alege fișier
                        <InputFile OnChange="HandleLogoSelected" accept=".jpg,.jpeg,.png,.webp"
                                   style="display:none;" />
                    </label>
                </div>
            </div>
        </div>
    </MudPaper>

    @* ── Secțiunea 2: Identitate vizuală ── *@
    <MudPaper Elevation="0" Class="mb-4" Style="border:1px solid #e5e7eb;">
        <div style="padding:14px 20px; border-bottom:1px solid #e5e7eb;">
            <span style="@SectionLabelStyle">Identitate vizuală</span>
        </div>
        <div style="padding:20px;">
            <div style="display:grid; grid-template-columns:1fr 1fr;
                        gap:16px; margin-bottom:16px;">
                <div>
                    <label style="@FieldLabelStyle">Numele companiei *</label>
                    <MudTextField @bind-Value="_draft.CompanyName"
                                  Variant="Variant.Outlined" FullWidth="true"
                                  Margin="Margin.Dense" Style="border-radius:0;"
                                  Error="@(_showValidation && string.IsNullOrWhiteSpace(_draft.CompanyName))"
                                  ErrorText="Câmp obligatoriu" />
                </div>
                <div>
                    <label style="@FieldLabelStyle">CUI / Cod fiscal</label>
                    <MudTextField @bind-Value="_draft.FiscalCode"
                                  Variant="Variant.Outlined" FullWidth="true"
                                  Margin="Margin.Dense" Style="border-radius:0;"
                                  Placeholder="ex. RO12345678" />
                </div>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
                <div>
                    <label style="@FieldLabelStyle">Industrie</label>
                    <MudSelect @bind-Value="_draft.Industry"
                               Variant="Variant.Outlined" FullWidth="true"
                               Margin="Margin.Dense" Style="border-radius:0;"
                               Placeholder="Selectează industria">
                        @foreach (var ind in _industries)
                        {
                            <MudSelectItem Value="@ind">@ind</MudSelectItem>
                        }
                    </MudSelect>
                </div>
                <div>
                    <label style="@FieldLabelStyle">Dimensiune companie</label>
                    <MudSelect @bind-Value="_draft.CompanySize"
                               Variant="Variant.Outlined" FullWidth="true"
                               Margin="Margin.Dense" Style="border-radius:0;"
                               Placeholder="Nr. angajați">
                        <MudSelectItem Value="@("1-10")">1–10 angajați</MudSelectItem>
                        <MudSelectItem Value="@("11-50")">11–50 angajați</MudSelectItem>
                        <MudSelectItem Value="@("51-200")">51–200 angajați</MudSelectItem>
                        <MudSelectItem Value="@("201-500")">201–500 angajați</MudSelectItem>
                        <MudSelectItem Value="@("500+")">500+ angajați</MudSelectItem>
                    </MudSelect>
                </div>
            </div>

            <div>
                <label style="@FieldLabelStyle">Anul înființării</label>
                <MudTextField @bind-Value="_draft.FoundedYear" T="int?"
                              Variant="Variant.Outlined" FullWidth="true"
                              Margin="Margin.Dense" Style="border-radius:0; max-width:200px;"
                              Placeholder="ex. 2015" />
            </div>
        </div>
    </MudPaper>

    @* ── Secțiunea 3: Contact & Web ── *@
    <MudPaper Elevation="0" Class="mb-4" Style="border:1px solid #e5e7eb;">
        <div style="padding:14px 20px; border-bottom:1px solid #e5e7eb;">
            <span style="@SectionLabelStyle">Contact &amp; Web</span>
        </div>
        <div style="padding:20px;">
            <div style="display:grid; grid-template-columns:1fr 1fr;
                        gap:16px; margin-bottom:16px;">
                <div>
                    <label style="@FieldLabelStyle">Email contact</label>
                    <MudTextField @bind-Value="_draft.ContactEmail"
                                  Variant="Variant.Outlined" FullWidth="true"
                                  Margin="Margin.Dense" Style="border-radius:0;"
                                  Placeholder="hr@companie.ro" />
                </div>
                <div>
                    <label style="@FieldLabelStyle">Telefon contact</label>
                    <MudTextField @bind-Value="_draft.ContactPhone"
                                  Variant="Variant.Outlined" FullWidth="true"
                                  Margin="Margin.Dense" Style="border-radius:0;"
                                  Placeholder="+373 XXX XXX XX" />
                </div>
            </div>
            <div style="display:grid; grid-template-columns:1fr 1fr;
                        gap:16px; margin-bottom:16px;">
                <div>
                    <label style="@FieldLabelStyle">Website</label>
                    <MudTextField @bind-Value="_draft.Website"
                                  Variant="Variant.Outlined" FullWidth="true"
                                  Margin="Margin.Dense" Style="border-radius:0;"
                                  Placeholder="https://..." />
                </div>
                <div>
                    <label style="@FieldLabelStyle">LinkedIn companie</label>
                    <MudTextField @bind-Value="_draft.LinkedInUrl"
                                  Variant="Variant.Outlined" FullWidth="true"
                                  Margin="Margin.Dense" Style="border-radius:0;"
                                  Placeholder="https://linkedin.com/company/..." />
                </div>
            </div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                <div>
                    <label style="@FieldLabelStyle">Facebook</label>
                    <MudTextField @bind-Value="_draft.FacebookUrl"
                                  Variant="Variant.Outlined" FullWidth="true"
                                  Margin="Margin.Dense" Style="border-radius:0;"
                                  Placeholder="https://facebook.com/..." />
                </div>
                <div>
                    <label style="@FieldLabelStyle">Instagram</label>
                    <MudTextField @bind-Value="_draft.InstagramUrl"
                                  Variant="Variant.Outlined" FullWidth="true"
                                  Margin="Margin.Dense" Style="border-radius:0;"
                                  Placeholder="https://instagram.com/..." />
                </div>
            </div>
        </div>
    </MudPaper>

    @* ── Secțiunea 4: Locații ── *@
    <MudPaper Elevation="0" Class="mb-4" Style="border:1px solid #e5e7eb;">
        <div style="padding:14px 20px; border-bottom:1px solid #e5e7eb;">
            <span style="@SectionLabelStyle">Locații birouri</span>
        </div>
        <div style="padding:20px;">
            @if (_locations.Any())
            {
                <div style="display:flex; flex-direction:column;
                            gap:8px; margin-bottom:12px;">
                    @foreach (var loc in _locations)
                    {
                        <div style="display:flex; align-items:center; gap:8px;
                                    padding:8px 12px; background:#f9fafb;
                                    border:1px solid #e5e7eb;">
                            <span style="flex:1; font-size:13px; color:#111827;">
                                @loc.City, @loc.Country
                            </span>
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           Size="Size.Small"
                                           Style="color:#9ca3af;"
                                           OnClick="@(() => RemoveLocation(loc))" />
                        </div>
                    }
                </div>
            }
            else
            {
                <MudText Typo="Typo.caption"
                         Style="color:#9ca3af; display:block; margin-bottom:12px;">
                    Nicio locație adăugată încă.
                </MudText>
            }

            <div style="display:flex; gap:8px; align-items:flex-end;">
                <div style="flex:1;">
                    <label style="@FieldLabelStyle">Oraș</label>
                    <MudTextField @bind-Value="_newCity"
                                  Variant="Variant.Outlined" FullWidth="true"
                                  Margin="Margin.Dense" Style="border-radius:0;"
                                  Placeholder="ex. Cluj-Napoca" />
                </div>
                <div style="flex:1;">
                    <label style="@FieldLabelStyle">Țară</label>
                    <MudTextField @bind-Value="_newCountry"
                                  Variant="Variant.Outlined" FullWidth="true"
                                  Margin="Margin.Dense" Style="border-radius:0;"
                                  Placeholder="ex. România" />
                </div>
                <MudButton Variant="Variant.Filled"
                           OnClick="AddLocation"
                           Style="background:#6366f1; color:#fff; border-radius:0;
                                  font-size:11px; font-weight:600; letter-spacing:2px;
                                  text-transform:uppercase; padding:8px 16px;
                                  min-height:40px; margin-bottom:1px;">
                    + Adaugă
                </MudButton>
            </div>
        </div>
    </MudPaper>

    @* ── Secțiunea 5: Despre companie ── *@
    <MudPaper Elevation="0" Class="mb-4" Style="border:1px solid #e5e7eb;">
        <div style="padding:14px 20px; border-bottom:1px solid #e5e7eb;">
            <span style="@SectionLabelStyle">Despre companie</span>
        </div>
        <div style="padding:20px;">
            <div style="margin-bottom:16px;">
                <label style="@FieldLabelStyle">Titlu scurt (afișat în carduri job)</label>
                <MudTextField @bind-Value="_draft.ShortTitle"
                              Variant="Variant.Outlined" FullWidth="true"
                              Margin="Margin.Dense" Style="border-radius:0;"
                              Placeholder="ex. Soluții SaaS pentru piața europeană"
                              MaxLength="100" />
            </div>
            <div>
                <label style="@FieldLabelStyle">Descriere completă</label>
                <MudTextField @bind-Value="_draft.Description"
                              Lines="5" Variant="Variant.Outlined" FullWidth="true"
                              Margin="Margin.Dense" Style="border-radius:0;"
                              Placeholder="Descrie compania, valorile și cultura organizațională..." />
            </div>
        </div>
    </MudPaper>

    @* ── Secțiunea 6: Cultură organizațională ── *@
    <MudPaper Elevation="0" Class="mb-4" Style="border:1px solid #e5e7eb;">
        <div style="padding:14px 20px; border-bottom:1px solid #e5e7eb;">
            <span style="@SectionLabelStyle">Cultură organizațională</span>
        </div>
        <div style="padding:20px;">
            <div style="margin-bottom:16px;">
                <label style="@FieldLabelStyle">Misiune</label>
                <MudTextField @bind-Value="_draft.Mission"
                              Lines="3" Variant="Variant.Outlined" FullWidth="true"
                              Margin="Margin.Dense" Style="border-radius:0;"
                              Placeholder="Care este misiunea companiei?" />
            </div>
            <div style="margin-bottom:16px;">
                <label style="@FieldLabelStyle">Viziune</label>
                <MudTextField @bind-Value="_draft.Vision"
                              Lines="3" Variant="Variant.Outlined" FullWidth="true"
                              Margin="Margin.Dense" Style="border-radius:0;"
                              Placeholder="Care este viziunea companiei pe termen lung?" />
            </div>
            <div style="margin-bottom:16px;">
                <label style="@FieldLabelStyle">Valori</label>
                <MudTextField @bind-Value="_draft.Values"
                              Lines="3" Variant="Variant.Outlined" FullWidth="true"
                              Margin="Margin.Dense" Style="border-radius:0;"
                              Placeholder="Care sunt valorile de bază ale companiei?" />
            </div>
            <div>
                <label style="@FieldLabelStyle">Mediu de lucru</label>
                <MudTextField @bind-Value="_draft.WorkEnvironment"
                              Lines="3" Variant="Variant.Outlined" FullWidth="true"
                              Margin="Margin.Dense" Style="border-radius:0;"
                              Placeholder="Descrie mediul de lucru (birou, remote, flexibil, etc.)" />
            </div>
        </div>
    </MudPaper>

    @* ── Secțiunea 7: Beneficii angajați ── *@
    <MudPaper Elevation="0" Class="mb-4" Style="border:1px solid #e5e7eb;">
        <div style="padding:14px 20px; border-bottom:1px solid #e5e7eb;">
            <span style="@SectionLabelStyle">Beneficii angajați</span>
        </div>
        <div style="padding:20px;">
            @if (_draft.Benefits.Any())
            {
                <div style="display:flex; flex-wrap:wrap; gap:8px; margin-bottom:16px;">
                    @foreach (var benefit in _draft.Benefits)
                    {
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined"
                                 Style="border-radius:0; font-size:12px;"
                                 OnClose="@(() => RemoveBenefit(benefit))">
                            @benefit
                        </MudChip>
                    }
                </div>
            }

            <MudText Typo="Typo.caption"
                     Style="color:#9ca3af; display:block; margin-bottom:8px;">
                Selectează din sugestii sau adaugă beneficii personalizate:
            </MudText>
            <div style="display:flex; flex-wrap:wrap; gap:6px; margin-bottom:12px;">
                @foreach (var suggestion in _benefitSuggestions)
                {
                    @if (!_draft.Benefits.Contains(suggestion))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                   OnClick="@(() => AddBenefit(suggestion))"
                                   Style="border-radius:0; font-size:11px; text-transform:none;
                                          border-color:#d1d5db; color:#6b7280; padding:4px 10px;">
                            + @suggestion
                        </MudButton>
                    }
                }
            </div>
            <div style="display:flex; gap:8px; align-items:flex-end;">
                <div style="flex:1;">
                    <label style="@FieldLabelStyle">Beneficiu personalizat</label>
                    <MudTextField @bind-Value="_newBenefit"
                                  Variant="Variant.Outlined" FullWidth="true"
                                  Margin="Margin.Dense" Style="border-radius:0;"
                                  Placeholder="ex. Cafea gratuită" />
                </div>
                <MudButton Variant="Variant.Filled"
                           OnClick="AddCustomBenefit"
                           Style="background:#6366f1; color:#fff; border-radius:0;
                                  font-size:11px; font-weight:600; letter-spacing:2px;
                                  text-transform:uppercase; padding:8px 16px;
                                  min-height:40px; margin-bottom:1px;">
                    + Adaugă
                </MudButton>
            </div>
        </div>
    </MudPaper>

    @* ── Secțiunea 8: Proces de recrutare ── *@
    <MudPaper Elevation="0" Class="mb-6" Style="border:1px solid #e5e7eb;">
        <div style="padding:14px 20px; border-bottom:1px solid #e5e7eb;">
            <span style="@SectionLabelStyle">Proces de recrutare</span>
        </div>
        <div style="padding:20px;">
            @if (_draft.RecruitmentProcess.Any())
            {
                <div style="display:flex; flex-direction:column; gap:8px; margin-bottom:16px;">
                    @for (int i = 0; i < _draft.RecruitmentProcess.Count; i++)
                    {
                        var idx = i;
                        var step = _draft.RecruitmentProcess[idx];
                        <div style="display:flex; align-items:center; gap:12px;
                                    padding:12px 16px; background:#f9fafb;
                                    border:1px solid #e5e7eb;">
                            <span style="width:28px; height:28px; background:#6366f1; color:#fff;
                                         display:flex; align-items:center; justify-content:center;
                                         font-size:12px; font-weight:700; flex-shrink:0;">
                                @(idx + 1)
                            </span>
                            <div style="flex:1;">
                                <span style="font-size:13px; font-weight:600; color:#111827; display:block;">
                                    @step.StepName
                                </span>
                                @if (!string.IsNullOrWhiteSpace(step.Description))
                                {
                                    <span style="font-size:12px; color:#6b7280; display:block; margin-top:2px;">
                                        @step.Description
                                    </span>
                                }
                            </div>
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                           Size="Size.Small" Style="color:#9ca3af;"
                                           Disabled="@(idx == 0)"
                                           OnClick="@(() => MoveStepUp(idx))" />
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward"
                                           Size="Size.Small" Style="color:#9ca3af;"
                                           Disabled="@(idx == _draft.RecruitmentProcess.Count - 1)"
                                           OnClick="@(() => MoveStepDown(idx))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           Size="Size.Small" Style="color:#9ca3af;"
                                           OnClick="@(() => RemoveStep(idx))" />
                        </div>
                    }
                </div>
            }

            <MudText Typo="Typo.caption"
                     Style="color:#9ca3af; display:block; margin-bottom:8px;">
                Adaugă rapid din sugestii sau definește propriile etape:
            </MudText>
            <div style="display:flex; flex-wrap:wrap; gap:6px; margin-bottom:12px;">
                @foreach (var suggestion in _recruitmentStepSuggestions)
                {
                    @if (!_draft.RecruitmentProcess.Any(s => s.StepName == suggestion))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                   OnClick="@(() => AddQuickStep(suggestion))"
                                   Style="border-radius:0; font-size:11px; text-transform:none;
                                          border-color:#d1d5db; color:#6b7280; padding:4px 10px;">
                            + @suggestion
                        </MudButton>
                    }
                }
            </div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:8px;">
                <div>
                    <label style="@FieldLabelStyle">Nume etapă</label>
                    <MudTextField @bind-Value="_newStepName"
                                  Variant="Variant.Outlined" FullWidth="true"
                                  Margin="Margin.Dense" Style="border-radius:0;"
                                  Placeholder="ex. Interviu tehnic" />
                </div>
                <div>
                    <label style="@FieldLabelStyle">Descriere (opțional)</label>
                    <MudTextField @bind-Value="_newStepDesc"
                                  Variant="Variant.Outlined" FullWidth="true"
                                  Margin="Margin.Dense" Style="border-radius:0;"
                                  Placeholder="Detalii despre etapă..." />
                </div>
            </div>
            <MudButton Variant="Variant.Filled"
                       OnClick="AddStep"
                       Style="background:#6366f1; color:#fff; border-radius:0;
                              font-size:11px; font-weight:600; letter-spacing:2px;
                              text-transform:uppercase; padding:8px 16px;">
                + Adaugă etapă
            </MudButton>
        </div>
    </MudPaper>

    @* ── Eroare ── *@
    @if (!string.IsNullOrEmpty(_saveError))
    {
        <div style="background:#fef2f2; border:1px solid #fecaca;
                    padding:12px 16px; margin-bottom:16px;">
            <MudText Typo="Typo.caption" Style="color:#dc2626;">@_saveError</MudText>
        </div>
    }

    @* ── Butoane Edit Mode ── *@
    <div style="display:flex; justify-content:flex-end; gap:12px;">
        <MudButton Variant="Variant.Outlined"
                   OnClick="HandleCancel"
                   Disabled="_isSaving"
                   Style="border-radius:0; font-size:11px; font-weight:600;
                          letter-spacing:2px; text-transform:uppercase;
                          padding:10px 20px; border-color:#d1d5db; color:#6b7280;">
            Anulează
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   OnClick="HandleSave"
                   Disabled="_isSaving"
                   Style="background:#6366f1; color:#fff; border-radius:0;
                          font-size:11px; font-weight:600; letter-spacing:2px;
                          text-transform:uppercase; padding:10px 24px;">
            @(_isSaving ? "Se salvează..." : "Salvează profilul")
        </MudButton>
    </div>
}
else
{
    @* ════════════════════════════════════════════════════════
       VIEW MODE — Professional card-based layout
    ════════════════════════════════════════════════════════ *@

    @* Header cu buton Editează *@
    <div style="display:flex; justify-content:space-between;
                align-items:flex-start; margin-bottom:24px;">
        <div>
            <MudText Typo="Typo.h5"
                     Style="font-weight:700; color:#111827; margin-bottom:4px;">
                Profil companie
            </MudText>
            <MudText Typo="Typo.body2" Style="color:#6b7280;">
                Informațiile companiei tale vizibile candidaților.
            </MudText>
        </div>
        <MudButton Variant="Variant.Outlined"
                   OnClick="StartEdit"
                   Style="border-radius:0; font-size:11px; font-weight:600;
                          letter-spacing:2px; text-transform:uppercase;
                          padding:10px 20px; border-color:#6366f1; color:#6366f1;">
            Editează profilul
        </MudButton>
    </div>

    @* Badge verificare *@
    @if (_profileData?.IsVerified == true)
    {
        <div style="display:inline-flex; align-items:center; gap:6px;
                    background:#d1fae5; padding:4px 12px; margin-bottom:24px;">
            <span style="width:7px; height:7px; border-radius:50%;
                         background:#059669; display:inline-block;"></span>
            <span style="font-size:10px; font-weight:600; color:#065f46;
                         text-transform:uppercase; letter-spacing:1.5px;
                         font-family:'Roboto Mono',monospace;">
                Cont verificat
            </span>
        </div>
    }
    else
    {
        <div style="display:inline-flex; align-items:center; gap:6px;
                    background:#fef3c7; padding:4px 12px; margin-bottom:24px;">
            <span style="width:7px; height:7px; border-radius:50%;
                         background:#d97706; display:inline-block;"></span>
            <span style="font-size:10px; font-weight:600; color:#92400e;
                         text-transform:uppercase; letter-spacing:1.5px;
                         font-family:'Roboto Mono',monospace;">
                În așteptare verificare
            </span>
        </div>
    }

    @* ── Card principal: Header companie ── *@
    <MudPaper Elevation="0" Class="mb-4" Style="border:1px solid #e5e7eb;">
        <div style="padding:24px;">
            <div style="display:flex; align-items:center; gap:20px; margin-bottom:20px;">
                @if (!string.IsNullOrWhiteSpace(_profileData?.LogoUrl))
                {
                    <div style="width:72px; height:72px; border:2px solid #e5e7eb; overflow:hidden; flex-shrink:0;">
                        <img src="@_profileData.LogoUrl" alt="Logo"
                             style="width:100%; height:100%; object-fit:cover;" />
                    </div>
                }
                else
                {
                    <MudAvatar Style="width:72px; height:72px; background:#ede9fe;
                                      font-size:22px; font-weight:700;
                                      color:#6366f1; border-radius:0; flex-shrink:0;">
                        @LogoInitials
                    </MudAvatar>
                }
                <div>
                    <MudText Typo="Typo.h6"
                             Style="font-weight:700; color:#111827; margin-bottom:2px;">
                        @(_profileData?.CompanyName ?? "—")
                    </MudText>
                    @if (!string.IsNullOrWhiteSpace(_profileData?.ShortTitle))
                    {
                        <MudText Typo="Typo.body2" Style="color:#6b7280;">
                            @_profileData.ShortTitle
                        </MudText>
                    }
                    <div style="display:flex; flex-wrap:wrap; gap:12px; margin-top:8px;">
                        @if (!string.IsNullOrWhiteSpace(_profileData?.Industry))
                        {
                            <span style="font-size:11px; color:#6b7280; display:flex; align-items:center; gap:4px;">
                                <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" Style="color:#9ca3af;" />
                                @_profileData.Industry
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(_profileData?.CompanySize))
                        {
                            <span style="font-size:11px; color:#6b7280; display:flex; align-items:center; gap:4px;">
                                <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Style="color:#9ca3af;" />
                                @_profileData.CompanySize angajați
                            </span>
                        }
                        @if (_profileData?.FoundedYear != null)
                        {
                            <span style="font-size:11px; color:#6b7280; display:flex; align-items:center; gap:4px;">
                                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" Style="color:#9ca3af;" />
                                Fondată în @_profileData.FoundedYear
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(_profileData?.FiscalCode))
                        {
                            <span style="font-size:11px; color:#6b7280; display:flex; align-items:center; gap:4px;">
                                <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" Style="color:#9ca3af;" />
                                CUI: @_profileData.FiscalCode
                            </span>
                        }
                    </div>
                </div>
            </div>

            @* Links row *@
            <div style="display:flex; flex-wrap:wrap; gap:12px; padding-top:16px; border-top:1px solid #e5e7eb;">
                @if (!string.IsNullOrWhiteSpace(_profileData?.Website))
                {
                    <span style="font-size:12px; color:#6b7280; display:flex; align-items:center; gap:4px;">
                        <MudIcon Icon="@Icons.Material.Filled.Language" Size="Size.Small" Style="color:#9ca3af;" />
                        @_profileData.Website
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(_profileData?.ContactEmail))
                {
                    <span style="font-size:12px; color:#6b7280; display:flex; align-items:center; gap:4px;">
                        <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Style="color:#9ca3af;" />
                        @_profileData.ContactEmail
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(_profileData?.ContactPhone))
                {
                    <span style="font-size:12px; color:#6b7280; display:flex; align-items:center; gap:4px;">
                        <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Style="color:#9ca3af;" />
                        @_profileData.ContactPhone
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(_profileData?.LinkedInUrl))
                {
                    <span style="font-size:12px; color:#6b7280; display:flex; align-items:center; gap:4px;">
                        <MudIcon Icon="@Icons.Material.Filled.Link" Size="Size.Small" Style="color:#9ca3af;" />
                        LinkedIn
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(_profileData?.FacebookUrl))
                {
                    <span style="font-size:12px; color:#6b7280; display:flex; align-items:center; gap:4px;">
                        <MudIcon Icon="@Icons.Material.Filled.Link" Size="Size.Small" Style="color:#9ca3af;" />
                        Facebook
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(_profileData?.InstagramUrl))
                {
                    <span style="font-size:12px; color:#6b7280; display:flex; align-items:center; gap:4px;">
                        <MudIcon Icon="@Icons.Material.Filled.Link" Size="Size.Small" Style="color:#9ca3af;" />
                        Instagram
                    </span>
                }
            </div>
        </div>
    </MudPaper>

    @* ── Locații ── *@
    @if (_locations.Any())
    {
        <MudPaper Elevation="0" Class="mb-4" Style="border:1px solid #e5e7eb;">
            <div style="padding:14px 20px; border-bottom:1px solid #e5e7eb;">
                <span style="@SectionLabelStyle">Locații birouri</span>
            </div>
            <div style="padding:20px; display:flex; flex-wrap:wrap; gap:8px;">
                @foreach (var loc in _locations)
                {
                    <span style="font-size:12px; font-weight:600; color:#6b7280;
                                 border:1px solid #e5e7eb; padding:6px 14px;
                                 font-family:'Roboto Mono',monospace; display:flex; align-items:center; gap:6px;">
                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Style="color:#9ca3af;" />
                        @loc.City, @loc.Country
                    </span>
                }
            </div>
        </MudPaper>
    }

    @* ── Despre companie ── *@
    @if (!string.IsNullOrWhiteSpace(_profileData?.Description))
    {
        <MudPaper Elevation="0" Class="mb-4" Style="border:1px solid #e5e7eb;">
            <div style="padding:14px 20px; border-bottom:1px solid #e5e7eb;">
                <span style="@SectionLabelStyle">Despre companie</span>
            </div>
            <div style="padding:20px;">
                <MudText Typo="Typo.body2"
                         Style="color:#374151; line-height:1.75; white-space:pre-line;">
                    @_profileData.Description
                </MudText>
            </div>
        </MudPaper>
    }

    @* ── Cultură organizațională ── *@
    @if (HasCultureData())
    {
        <MudPaper Elevation="0" Class="mb-4" Style="border:1px solid #e5e7eb;">
            <div style="padding:14px 20px; border-bottom:1px solid #e5e7eb;">
                <span style="@SectionLabelStyle">Cultură organizațională</span>
            </div>
            <div style="padding:20px;">
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
                    @if (!string.IsNullOrWhiteSpace(_profileData?.Mission))
                    {
                        <div>
                            <span style="@FieldLabelStyle; color:#6366f1;">Misiune</span>
                            <MudText Typo="Typo.body2" Style="color:#374151; line-height:1.6; white-space:pre-line;">
                                @_profileData.Mission
                            </MudText>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_profileData?.Vision))
                    {
                        <div>
                            <span style="@FieldLabelStyle; color:#6366f1;">Viziune</span>
                            <MudText Typo="Typo.body2" Style="color:#374151; line-height:1.6; white-space:pre-line;">
                                @_profileData.Vision
                            </MudText>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_profileData?.Values))
                    {
                        <div>
                            <span style="@FieldLabelStyle; color:#6366f1;">Valori</span>
                            <MudText Typo="Typo.body2" Style="color:#374151; line-height:1.6; white-space:pre-line;">
                                @_profileData.Values
                            </MudText>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_profileData?.WorkEnvironment))
                    {
                        <div>
                            <span style="@FieldLabelStyle; color:#6366f1;">Mediu de lucru</span>
                            <MudText Typo="Typo.body2" Style="color:#374151; line-height:1.6; white-space:pre-line;">
                                @_profileData.WorkEnvironment
                            </MudText>
                        </div>
                    }
                </div>
            </div>
        </MudPaper>
    }

    @* ── Beneficii ── *@
    @if (_profileData?.Benefits != null && _profileData.Benefits.Any())
    {
        <MudPaper Elevation="0" Class="mb-4" Style="border:1px solid #e5e7eb;">
            <div style="padding:14px 20px; border-bottom:1px solid #e5e7eb;">
                <span style="@SectionLabelStyle">Beneficii angajați</span>
            </div>
            <div style="padding:20px; display:flex; flex-wrap:wrap; gap:8px;">
                @foreach (var benefit in _profileData.Benefits)
                {
                    <span style="font-size:12px; font-weight:500; color:#6366f1;
                                 background:#ede9fe; padding:6px 14px;
                                 border:1px solid #c4b5fd;">
                        @benefit
                    </span>
                }
            </div>
        </MudPaper>
    }

    @* ── Proces de recrutare ── *@
    @if (_profileData?.RecruitmentProcess != null && _profileData.RecruitmentProcess.Any())
    {
        <MudPaper Elevation="0" Class="mb-4" Style="border:1px solid #e5e7eb;">
            <div style="padding:14px 20px; border-bottom:1px solid #e5e7eb;">
                <span style="@SectionLabelStyle">Proces de recrutare</span>
            </div>
            <div style="padding:20px;">
                <div style="display:flex; flex-direction:column; gap:0;">
                    @for (int i = 0; i < _profileData.RecruitmentProcess.Count; i++)
                    {
                        var step = _profileData.RecruitmentProcess[i];
                        var isLast = i == _profileData.RecruitmentProcess.Count - 1;
                        <div style="display:flex; gap:16px;">
                            <div style="display:flex; flex-direction:column; align-items:center;">
                                <span style="width:32px; height:32px; background:#6366f1; color:#fff;
                                             display:flex; align-items:center; justify-content:center;
                                             font-size:13px; font-weight:700; flex-shrink:0;">
                                    @(i + 1)
                                </span>
                                @if (!isLast)
                                {
                                    <div style="width:2px; background:#e5e7eb; flex:1; min-height:24px;"></div>
                                }
                            </div>
                            <div style="padding-bottom:@(isLast ? "0" : "20px");">
                                <span style="font-size:14px; font-weight:600; color:#111827; display:block;">
                                    @step.StepName
                                </span>
                                @if (!string.IsNullOrWhiteSpace(step.Description))
                                {
                                    <span style="font-size:12px; color:#6b7280; display:block; margin-top:4px; line-height:1.5;">
                                        @step.Description
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </MudPaper>
    }

    @* ── Oferte de lucru ── *@
    <MudPaper Elevation="0" Class="mb-4" Style="border:1px solid #e5e7eb;">
        <div style="display:flex; justify-content:space-between; align-items:center;
                    padding:14px 20px; border-bottom:1px solid #e5e7eb;">
            <span style="@SectionLabelStyle">Oferte de lucru</span>
            <MudButton Href="/employer/jobs" Variant="Variant.Text"
                       Style="font-size:11px; font-weight:600; letter-spacing:1px;
                              text-transform:uppercase; color:#6366f1; padding:4px 12px;">
                Gestionează anunțuri →
            </MudButton>
        </div>
        <div style="padding:20px;">
            @if (_myJobs == null || !_myJobs.Any())
            {
                <div style="text-align:center; padding:24px 0;">
                    <MudIcon Icon="@Icons.Material.Filled.WorkOutline"
                             Style="font-size:40px; color:#d1d5db; margin-bottom:12px;" />
                    <MudText Typo="Typo.body2" Style="color:#9ca3af; margin-bottom:16px;">
                        Nu ai publicat nicio ofertă de lucru încă.
                    </MudText>
                    <MudButton Href="/employer/jobs/create" Variant="Variant.Filled"
                               Style="background:#6366f1; color:#fff; border-radius:0;
                                      font-size:11px; font-weight:600; letter-spacing:2px;
                                      text-transform:uppercase; padding:10px 24px;">
                        Publică primul anunț
                    </MudButton>
                </div>
            }
            else
            {
                <div style="display:flex; flex-direction:column; gap:12px;">
                    @foreach (var job in _myJobs.Take(5))
                    {
                        <div style="display:flex; justify-content:space-between; align-items:center;
                                    padding:14px 16px; background:#f9fafb; border:1px solid #e5e7eb;">
                            <div style="flex:1;">
                                <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
                                    <span style="font-size:14px; font-weight:600; color:#111827;">
                                        @job.Title
                                    </span>
                                    <span style="font-size:10px; font-weight:600; padding:2px 8px;
                                                 letter-spacing:1px; text-transform:uppercase;
                                                 font-family:'Roboto Mono',monospace;
                                                 @(job.Status == JobStatus.Published
                                                     ? "background:#d1fae5; color:#065f46;"
                                                     : job.Status == JobStatus.Draft
                                                         ? "background:#e5e7eb; color:#6b7280;"
                                                         : "background:#fef3c7; color:#92400e;")">
                                        @(job.Status switch
                                        {
                                            JobStatus.Published => "Activ",
                                            JobStatus.Draft => "Ciornă",
                                            JobStatus.Closed => "Închis",
                                            JobStatus.Expired => "Expirat",
                                            _ => "—"
                                        })
                                    </span>
                                </div>
                                <div style="display:flex; flex-wrap:wrap; gap:12px;">
                                    @if (!string.IsNullOrWhiteSpace(job.Location))
                                    {
                                        <span style="font-size:11px; color:#6b7280; display:flex; align-items:center; gap:3px;">
                                            <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Style="color:#9ca3af;font-size:14px;" />
                                            @job.Location
                                        </span>
                                    }
                                    <span style="font-size:11px; color:#6b7280;">
                                        @(job.JobType switch
                                        {
                                            JobType.Remote => "Remote",
                                            JobType.OnSite => "La birou",
                                            JobType.Hybrid => "Hibrid",
                                            _ => "—"
                                        })
                                    </span>
                                    <span style="font-size:11px; color:#6b7280;">
                                        @(job.EmploymentType switch
                                        {
                                            EmploymentType.FullTime => "Full-time",
                                            EmploymentType.PartTime => "Part-time",
                                            EmploymentType.Freelance => "Freelance",
                                            EmploymentType.Internship => "Internship",
                                            EmploymentType.Contract => "Contract",
                                            _ => "—"
                                        })
                                    </span>
                                    @if (job.SalaryFrom.HasValue || job.SalaryTo.HasValue)
                                    {
                                        <span style="font-size:11px; color:#6366f1; font-weight:600;">
                                            @if (job.SalaryFrom.HasValue && job.SalaryTo.HasValue)
                                            {
                                                @($"{job.SalaryFrom:N0} – {job.SalaryTo:N0} MDL")
                                            }
                                            else if (job.SalaryFrom.HasValue)
                                            {
                                                @($"de la {job.SalaryFrom:N0} MDL")
                                            }
                                            else
                                            {
                                                @($"până la {job.SalaryTo:N0} MDL")
                                            }
                                        </span>
                                    }
                                    else if (job.IsSalaryNegotiable)
                                    {
                                        <span style="font-size:11px; color:#6b7280; font-style:italic;">
                                            Salariu negociabil
                                        </span>
                                    }
                                </div>
                            </div>
                            <div style="display:flex; align-items:center; gap:4px; color:#9ca3af; font-size:11px;">
                                @if (job.PublishedAt.HasValue)
                                {
                                    <span>@job.PublishedAt.Value.ToString("dd.MM.yyyy")</span>
                                }
                            </div>
                        </div>
                    }
                </div>

                @if (_myJobs.Count > 5)
                {
                    <div style="text-align:center; margin-top:16px;">
                        <MudButton Href="/employer/jobs" Variant="Variant.Text"
                                   Style="font-size:11px; font-weight:600; letter-spacing:1px;
                                          text-transform:uppercase; color:#6366f1;">
                            Vezi toate cele @_myJobs.Count anunțuri →
                        </MudButton>
                    </div>
                }
            }
        </div>
    </MudPaper>

    @* Profil gol — îndemn completare *@
    @if (string.IsNullOrWhiteSpace(_profileData?.CompanyName))
    {
        <MudPaper Elevation="0" Class="pa-6"
                  Style="border:1px dashed #d1d5db; text-align:center;">
            <MudText Typo="Typo.body2"
                     Style="color:#6b7280; margin-bottom:16px;">
                Profilul companiei nu este completat încă.
                Apasă <strong>Editează profilul</strong> pentru a începe.
            </MudText>
        </MudPaper>
    }
}

@code {
    // ── State principal ────────────────────────────────────────────────
    private EmployerProfileDto?      _profileData;
    private UpdateEmployerProfileDto _draft      = new();
    private List<CompanyLocationDto> _locations  = new();

    private List<JobPostingDto>?    _myJobs;

    private bool   _isLoading      = true;
    private bool   _isEditing      = false;
    private bool   _isSaving       = false;
    private bool   _showValidation = false;
    private string _saveError      = "";
    private bool   _isUploadingLogo = false;
    private string? _currentLogoUrl;

    // locație nouă
    private string _newCity    = "";
    private string _newCountry = "";

    // beneficii
    private string _newBenefit = "";

    // pași recrutare
    private string _newStepName = "";
    private string _newStepDesc = "";

    // ── Computed ───────────────────────────────────────────────────────
    private string LogoInitials
    {
        get
        {
            var name = _draft.CompanyName ?? _profileData?.CompanyName ?? "?";
            return name.Length >= 2 ? name[..2].ToUpper() : name.ToUpper();
        }
    }
    private int _completionPct => ComputeCompletion();

    private string GetCompletionHint()
    {
        if (_completionPct < 20) return "Adaugă numele companiei pentru a începe.";
        if (_completionPct < 40) return "Adaugă industria și un website.";
        if (_completionPct < 60) return "Completează descrierea companiei.";
        if (_completionPct < 80) return "Adaugă cultura organizațională și beneficii.";
        if (_completionPct < 100) return "Adaugă locații și procesul de recrutare.";
        return "Profilul companiei este complet!";
    }

    private int ComputeCompletion()
    {
        int score = 0;
        if (!string.IsNullOrWhiteSpace(_draft.CompanyName))   score += 12;
        if (!string.IsNullOrWhiteSpace(_draft.Industry))      score += 8;
        if (!string.IsNullOrWhiteSpace(_draft.Website))       score += 8;
        if (!string.IsNullOrWhiteSpace(_draft.Description))   score += 12;
        if (!string.IsNullOrWhiteSpace(_draft.ShortTitle))    score += 5;
        if (!string.IsNullOrWhiteSpace(_draft.LinkedInUrl))   score += 5;
        if (_locations.Count > 0)                              score += 8;
        if (!string.IsNullOrWhiteSpace(_draft.ContactEmail))  score += 5;
        if (!string.IsNullOrWhiteSpace(_draft.ContactPhone))  score += 5;
        if (!string.IsNullOrWhiteSpace(_draft.Mission))       score += 8;
        if (!string.IsNullOrWhiteSpace(_draft.Vision))        score += 5;
        if (!string.IsNullOrWhiteSpace(_draft.Values))        score += 5;
        if (_draft.Benefits.Count > 0)                         score += 7;
        if (_draft.RecruitmentProcess.Count > 0)               score += 7;
        return Math.Min(score, 100);
    }

    private bool HasCultureData() =>
        !string.IsNullOrWhiteSpace(_profileData?.Mission) ||
        !string.IsNullOrWhiteSpace(_profileData?.Vision) ||
        !string.IsNullOrWhiteSpace(_profileData?.Values) ||
        !string.IsNullOrWhiteSpace(_profileData?.WorkEnvironment);

    // ── Stiluri constante ──────────────────────────────────────────────
    private const string SectionLabelStyle =
        "font-size:11px; font-weight:600; letter-spacing:2px; " +
        "text-transform:uppercase; color:#6b7280; " +
        "font-family:'Roboto Mono',monospace;";

    private const string FieldLabelStyle =
        "display:block; font-size:11px; font-weight:600; letter-spacing:2px; " +
        "text-transform:uppercase; color:#6b7280; margin-bottom:8px; " +
        "font-family:'Roboto Mono',monospace;";

    private readonly List<string> _industries = new()
    {
        "IT & Software", "Web Development", "Mobile Development", "Data & AI",
        "DevOps & Cloud", "Cybersecurity", "Management & Business", "Resurse umane",
        "Finanțe & Contabilitate", "Vânzări & Marketing", "Juridic & Administrație",
        "Educație & Cercetare", "Sănătate & Medicină", "Construcții & Imobiliare",
        "Producție & Inginerie", "Transport & Logistică", "Media & Design",
        "Turism & HoReCa", "Agricultură & Mediu", "Servicii & Altele"
    };

    private readonly List<string> _benefitSuggestions = new()
    {
        "Asigurare medicală", "Work from home / Remote", "Program flexibil",
        "Zile libere suplimentare", "Masă de prânz asigurată", "Tichete de masă",
        "Abonament fitness/sport", "Training și dezvoltare profesională",
        "Bonus de performanță", "Team building-uri", "Parcare gratuită",
        "Transport asigurat", "Echipament de lucru (laptop, etc.)"
    };

    private readonly List<string> _recruitmentStepSuggestions = new()
    {
        "Aplicare online", "Screening CV", "Interviu telefonic",
        "Interviu tehnic", "Test practic / Assessment", "Interviu final", "Ofertă"
    };

    // ── Lifecycle ──────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await LoadProfile();
        await LoadJobs();
    }

    // ── Load ───────────────────────────────────────────────────────────
    private async Task LoadJobs()
    {
        try
        {
            _myJobs = await Http.GetFromJsonAsync<List<JobPostingDto>>("api/employer/profile/jobs");
        }
        catch
        {
            _myJobs = new();
        }
    }

    private async Task LoadProfile()
    {
        try
        {
            _isLoading = true;
            var response = await Http.GetAsync("api/employer/profile");

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                _profileData = JsonSerializer.Deserialize<EmployerProfileDto>(json,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                if (_profileData != null)
                {
                    _locations = _profileData.Locations?.ToList() ?? new();
                    _currentLogoUrl = _profileData.LogoUrl;
                }
            }
            else
            {
                Snackbar.Add("Eroare la încărcarea profilului.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Eroare: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    // ── START EDIT ──────────────────────────────────────────────────────
    private void StartEdit()
    {
        _draft = new UpdateEmployerProfileDto
        {
            CompanyName   = _profileData?.CompanyName ?? "",
            Industry      = _profileData?.Industry,
            Website       = _profileData?.Website,
            Location      = _profileData?.Location,
            Description   = _profileData?.Description,
            ShortTitle    = _profileData?.ShortTitle,
            CompanySize   = _profileData?.CompanySize,
            LinkedInUrl   = _profileData?.LinkedInUrl,
            LogoUrl       = _profileData?.LogoUrl,
            FiscalCode    = _profileData?.FiscalCode,
            FoundedYear   = _profileData?.FoundedYear,
            Mission       = _profileData?.Mission,
            Vision        = _profileData?.Vision,
            Values        = _profileData?.Values,
            WorkEnvironment = _profileData?.WorkEnvironment,
            Benefits      = _profileData?.Benefits?.ToList() ?? new(),
            RecruitmentProcess = _profileData?.RecruitmentProcess?
                .Select(r => new RecruitmentStepDto { StepName = r.StepName, Description = r.Description })
                .ToList() ?? new(),
            FacebookUrl   = _profileData?.FacebookUrl,
            InstagramUrl  = _profileData?.InstagramUrl,
            ContactPhone  = _profileData?.ContactPhone,
            ContactEmail  = _profileData?.ContactEmail,
        };

        _currentLogoUrl = _profileData?.LogoUrl;
        _showValidation = false;
        _saveError      = "";
        _isEditing      = true;
    }

    // ── CANCEL ──────────────────────────────────────────────────────────
    private void HandleCancel()
    {
        _draft         = new UpdateEmployerProfileDto();
        _saveError     = "";
        _showValidation = false;
        _isEditing     = false;
    }

    // ── SAVE ────────────────────────────────────────────────────────────
    private async Task HandleSave()
    {
        _showValidation = true;
        _saveError = "";

        if (string.IsNullOrWhiteSpace(_draft.CompanyName))
        {
            _saveError = "Numele companiei este obligatoriu.";
            return;
        }

        _isSaving = true;
        try
        {
            var response = await Http.PutAsJsonAsync("api/employer/profile", _draft);

            if (response.IsSuccessStatusCode)
            {
                await LoadProfile();
                _isEditing = false;
                Snackbar.Add("Profil salvat cu succes!", Severity.Success);
            }
            else
            {
                string body = "";
                try { body = await response.Content.ReadAsStringAsync(); } catch { }

                if (!string.IsNullOrWhiteSpace(body))
                {
                    try
                    {
                        var err = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(
                            body, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                        _saveError = err?.ContainsKey("message") == true
                            ? err["message"].GetString() ?? "Eroare la salvare."
                            : "Eroare la salvare.";
                    }
                    catch { _saveError = $"Eroare server ({(int)response.StatusCode})."; }
                }
                else
                {
                    _saveError = $"Eroare server ({(int)response.StatusCode}).";
                }

                Snackbar.Add(_saveError, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _saveError = $"Eroare: {ex.Message}";
            Snackbar.Add(_saveError, Severity.Error);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    // ── Logo Upload ─────────────────────────────────────────────────────
    private async Task HandleLogoSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        if (file.Size > 2 * 1024 * 1024)
        {
            Snackbar.Add("Fișierul depășește limita de 2MB.", Severity.Warning);
            return;
        }

        _isUploadingLogo = true;
        StateHasChanged();

        try
        {
            using var content = new MultipartFormDataContent();
            using var stream = file.OpenReadStream(2 * 1024 * 1024);
            var streamContent = new StreamContent(stream);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(streamContent, "file", file.Name);

            var response = await Http.PostAsync("api/employer/profile/logo", content);

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var result = JsonSerializer.Deserialize<Dictionary<string, string>>(json,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                if (result != null && result.TryGetValue("logoUrl", out var logoUrl))
                {
                    _currentLogoUrl = logoUrl;
                    _draft.LogoUrl = logoUrl;
                }
                Snackbar.Add("Logo încărcat cu succes!", Severity.Success);
            }
            else
            {
                Snackbar.Add("Eroare la încărcarea logo-ului.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Eroare: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isUploadingLogo = false;
            StateHasChanged();
        }
    }

    // ── Locații ──────────────────────────────────────────────────────────
    private void AddLocation()
    {
        if (string.IsNullOrWhiteSpace(_newCity) ||
            string.IsNullOrWhiteSpace(_newCountry))
        {
            Snackbar.Add("Completează orașul și țara.", Severity.Warning);
            return;
        }
        _locations.Add(new CompanyLocationDto
        {
            City    = _newCity.Trim(),
            Country = _newCountry.Trim(),
            Address = ""
        });
        _newCity    = "";
        _newCountry = "";
    }

    private void RemoveLocation(CompanyLocationDto loc) =>
        _locations.Remove(loc);

    // ── Beneficii ───────────────────────────────────────────────────────
    private void AddBenefit(string benefit)
    {
        if (!_draft.Benefits.Contains(benefit))
            _draft.Benefits.Add(benefit);
    }

    private void AddCustomBenefit()
    {
        if (string.IsNullOrWhiteSpace(_newBenefit)) return;
        if (!_draft.Benefits.Contains(_newBenefit.Trim()))
            _draft.Benefits.Add(_newBenefit.Trim());
        _newBenefit = "";
    }

    private void RemoveBenefit(string benefit) =>
        _draft.Benefits.Remove(benefit);

    // ── Recruitment Steps ───────────────────────────────────────────────
    private void AddQuickStep(string stepName)
    {
        _draft.RecruitmentProcess.Add(new RecruitmentStepDto
        {
            StepName = stepName,
            Description = ""
        });
    }

    private void AddStep()
    {
        if (string.IsNullOrWhiteSpace(_newStepName))
        {
            Snackbar.Add("Introdu numele etapei.", Severity.Warning);
            return;
        }
        _draft.RecruitmentProcess.Add(new RecruitmentStepDto
        {
            StepName = _newStepName.Trim(),
            Description = _newStepDesc?.Trim() ?? ""
        });
        _newStepName = "";
        _newStepDesc = "";
    }

    private void RemoveStep(int index) =>
        _draft.RecruitmentProcess.RemoveAt(index);

    private void MoveStepUp(int index)
    {
        if (index <= 0) return;
        var item = _draft.RecruitmentProcess[index];
        _draft.RecruitmentProcess.RemoveAt(index);
        _draft.RecruitmentProcess.Insert(index - 1, item);
    }

    private void MoveStepDown(int index)
    {
        if (index >= _draft.RecruitmentProcess.Count - 1) return;
        var item = _draft.RecruitmentProcess[index];
        _draft.RecruitmentProcess.RemoveAt(index);
        _draft.RecruitmentProcess.Insert(index + 1, item);
    }

}
