@page "/employer/dashboard"
@layout EmployerLayout

@using JobFinder.Shared.DTOs.Application
@using JobFinder.Shared.DTOs.Jobs
@using JobFinder.Shared.DTOs.Applications
@using JobFinder.Shared.Enums
@using System.Net.Http.Json

@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Dashboard Angajator - JobFinder</PageTitle>

@* ── Titlu ── *@
<div style="margin-bottom:28px;">
    <h1 style="font-size:22px; font-weight:700; color:#111827; margin:0 0 4px 0;">
        Dashboard
    </h1>
   
</div>

@if (_loading)
{
    <div style="display:flex; flex-direction:column; gap:24px;">
        <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:16px;">
            @for (int i = 0; i < 4; i++)
            {
                <div style="height:90px; border-radius:12px;
                                    background:linear-gradient(90deg,#f3f4f6 25%,#e9eaec 50%,#f3f4f6 75%);
                                    background-size:800px 100%; animation:shimmer 1.4s infinite;"></div>
            }
        </div>
        <div style="height:200px; border-radius:16px;
                        background:linear-gradient(90deg,#f3f4f6 25%,#e9eaec 50%,#f3f4f6 75%);
                        background-size:800px 100%; animation:shimmer 1.4s infinite;"></div>
    </div>
}
else
{
    @* ════════════════════════════════
       STATISTICI — 4 carduri
    ════════════════════════════════ *@
    <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:24px;">

        <div style="background:#fff; border:1px solid #e5e7eb; border-radius:12px;
                        padding:20px 24px; display:flex; justify-content:space-between; align-items:center;">
            <div>
                <p style="font-size:11px; font-weight:600; color:#9ca3af; text-transform:uppercase;
                              letter-spacing:1px; margin:0 0 6px 0;">Anunțuri active</p>
                <p style="font-size:32px; font-weight:700; color:#111827; margin:0; line-height:1;">
                    @_stats.ActiveJobs
                </p>
            </div>
            <div style="width:44px; height:44px; background:#f0eeff; border-radius:10px;
                            display:flex; align-items:center; justify-content:center;">
                <MudIcon Icon="@Icons.Material.Filled.WorkOutline" Style="color:#6366f1; font-size:22px;" />
            </div>
        </div>

        <div style="background:#fff; border:1px solid #e5e7eb; border-radius:12px;
                        padding:20px 24px; display:flex; justify-content:space-between; align-items:center;">
            <div>
                <p style="font-size:11px; font-weight:600; color:#9ca3af; text-transform:uppercase;
                              letter-spacing:1px; margin:0 0 6px 0;">Total aplicări</p>
                <p style="font-size:32px; font-weight:700; color:#111827; margin:0; line-height:1;">
                    @_stats.TotalApplications
                </p>
            </div>
            <div style="width:44px; height:44px; background:#eff6ff; border-radius:10px;
                            display:flex; align-items:center; justify-content:center;">
                <MudIcon Icon="@Icons.Material.Filled.People" Style="color:#3b82f6; font-size:22px;" />
            </div>
        </div>

        <div style="background:#fff; border:1px solid #e5e7eb; border-radius:12px;
                        padding:20px 24px; display:flex; justify-content:space-between; align-items:center;">
            <div>
                <p style="font-size:11px; font-weight:600; color:#9ca3af; text-transform:uppercase;
                              letter-spacing:1px; margin:0 0 6px 0;">În analiză</p>
                <p style="font-size:32px; font-weight:700; color:#111827; margin:0; line-height:1;">
                    @_stats.InReview
                </p>
            </div>
            <div style="width:44px; height:44px; background:#fff7ed; border-radius:10px;
                            display:flex; align-items:center; justify-content:center;">
                <MudIcon Icon="@Icons.Material.Filled.HourglassEmpty" Style="color:#f97316; font-size:22px;" />
            </div>
        </div>

        <div style="background:#fff; border:1px solid #e5e7eb; border-radius:12px;
                        padding:20px 24px; display:flex; justify-content:space-between; align-items:center;">
            <div>
                <p style="font-size:11px; font-weight:600; color:#9ca3af; text-transform:uppercase;
                              letter-spacing:1px; margin:0 0 6px 0;">Candidați acceptați</p>
                <p style="font-size:32px; font-weight:700; color:#111827; margin:0; line-height:1;">
                    @_stats.Accepted
                </p>
            </div>
            <div style="width:44px; height:44px; background:#f0fdf4; border-radius:10px;
                            display:flex; align-items:center; justify-content:center;">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color:#22c55e; font-size:22px;" />
            </div>
        </div>
    </div>

    @* ════════════════════════════════
       BANNER CONFIRMĂRI ÎN AȘTEPTARE
    ════════════════════════════════ *@
    @if (_pendingConfirmations.Any())
    {
        <div style="background:linear-gradient(135deg,#f59e0b 0%,#fbbf24 100%);
                            border-radius:16px; padding:20px 28px; margin-bottom:24px;
                            display:flex; align-items:center; justify-content:space-between; gap:16px;">
            <div style="display:flex; align-items:center; gap:16px;">
                <div style="width:44px; height:44px; background:rgba(255,255,255,0.25);
                                    border-radius:10px; display:flex; align-items:center; justify-content:center;
                                    flex-shrink:0;">
                    <MudIcon Icon="@Icons.Material.Filled.NotificationImportant"
                             Style="color:#fff; font-size:22px;" />
                </div>
                <div>
                    <p style="font-size:15px; font-weight:700; color:#fff; margin:0 0 2px 0;">
                        @_pendingConfirmations.Count confirmare(i) în așteptare
                    </p>
                    <p style="font-size:13px; color:rgba(255,255,255,0.85); margin:0;">
                        Candidații au confirmat angajarea și așteaptă validarea ta.
                    </p>
                </div>
            </div>
            <a href="/employer/applications"
               style="display:inline-block; background:#fff; color:#92400e;
                              font-size:12px; font-weight:700; letter-spacing:1px; text-transform:uppercase;
                              padding:10px 20px; border-radius:8px; text-decoration:none; white-space:nowrap;
                              flex-shrink:0;">
                Validează →
            </a>
        </div>
    }

    @* ════════════════════════════════
       GRID — Anunțuri active + Aplicări recente
    ════════════════════════════════ *@
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">

        @* ── Anunțuri active ── *@
        <div style="background:#fff; border:1px solid #e5e7eb; border-radius:16px; padding:24px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
                <h2 style="font-size:16px; font-weight:700; color:#111827; margin:0;
                               padding-left:12px; border-left:3px solid #6366f1;">
                    Anunțuri active
                </h2>
                <a href="/employer/jobs"
                   style="font-size:12px; font-weight:600; color:#6366f1; text-decoration:none;">
                    Gestionează →
                </a>
            </div>

            @if (!_activeJobs.Any())
            {
                <div style="text-align:center; padding:32px 0;">
                    <MudIcon Icon="@Icons.Material.Filled.WorkOff"
                             Style="font-size:40px; color:#d1d5db; display:block; margin:0 auto 12px;" />
                    <p style="font-size:14px; color:#9ca3af; margin:0 0 14px 0;">
                        Nu ai niciun anunț activ.
                    </p>
                    <a href="/employer/jobs/create"
                       style="display:inline-block; background:#6366f1; color:#fff;
                                      text-decoration:none; font-size:12px; font-weight:700;
                                      letter-spacing:1px; text-transform:uppercase;
                                      padding:10px 20px; border-radius:8px;">
                        + Publică primul anunț
                    </a>
                </div>
            }
            else
            {
                @foreach (var job in _activeJobs)
                {
                    <a href="/employer/jobs/@job.Id/applications"
                       style="display:flex; align-items:center; justify-content:space-between;
                                          gap:12px; padding:12px 14px; border-radius:10px;
                                          text-decoration:none; color:inherit; margin-bottom:4px;
                                          transition:background 0.15s;"
                       onmouseover="this.style.background='#f9fafb'"
                       onmouseout="this.style.background='transparent'">
                        <div style="flex:1; min-width:0;">
                            <p style="font-size:14px; font-weight:600; color:#111827;
                                                  margin:0 0 2px 0; white-space:nowrap;
                                                  overflow:hidden; text-overflow:ellipsis;">
                                @job.Title
                            </p>
                            <p style="font-size:12px; color:#9ca3af; margin:0;">
                                @(_applicationCountByJob.TryGetValue(job.Id, out var cnt) ? cnt : 0) aplicări
                                @if (job.PublishedAt.HasValue)
                                {
                                    <span> · @job.PublishedAt.Value.ToString("dd.MM.yyyy")</span>
                                }
                            </p>
                        </div>
                        <span style="font-size:11px; font-weight:600; padding:4px 12px;
                                                 border-radius:20px; background:#d1fae5; color:#065f46;
                                                 white-space:nowrap; flex-shrink:0;">
                            Activ
                        </span>
                    </a>
                }
            }
        </div>

        @* ── Aplicări recente ── *@
        <div style="background:#fff; border:1px solid #e5e7eb; border-radius:16px; padding:24px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
                <h2 style="font-size:16px; font-weight:700; color:#111827; margin:0;
                               padding-left:12px; border-left:3px solid #6366f1;">
                    Aplicări recente
                </h2>
            </div>

            @if (!_recentApplications.Any())
            {
                <div style="text-align:center; padding:32px 0;">
                    <MudIcon Icon="@Icons.Material.Filled.Inbox"
                             Style="font-size:40px; color:#d1d5db; display:block; margin:0 auto 12px;" />
                    <p style="font-size:14px; color:#9ca3af; margin:0;">
                        Nu există aplicări noi.
                    </p>
                </div>
            }
            else
            {
                @foreach (var app in _recentApplications)
                {
                    <a href="/employer/applications/@app.Id"
                       style="display:flex; align-items:center; justify-content:space-between;
                                          gap:12px; padding:12px 14px; border-radius:10px;
                                          text-decoration:none; color:inherit; margin-bottom:4px;
                                          transition:background 0.15s;"
                       onmouseover="this.style.background='#f9fafb'"
                       onmouseout="this.style.background='transparent'">
                        <div style="display:flex; align-items:center; gap:10px; flex:1; min-width:0;">
                            <div style="width:36px; height:36px; min-width:36px; background:#f0eeff;
                                                    border-radius:8px; display:flex; align-items:center;
                                                    justify-content:center; font-size:12px; font-weight:700;
                                                    color:#6366f1;">
                                @(app.CandidateFullName?.Length >= 2
                                                    ? app.CandidateFullName[..2].ToUpper() : "?")
                </div>
                <div style="flex:1; min-width:0;">
                    <p style="font-size:14px; font-weight:600; color:#111827;
                                          margin:0 0 2px 0; white-space:nowrap;
                                          overflow:hidden; text-overflow:ellipsis;">
                        @app.CandidateFullName
                    </p>
                    <p style="font-size:12px; color:#9ca3af; margin:0; white-space:nowrap;
                                          overflow:hidden; text-overflow:ellipsis;">
                        @app.JobTitle · @app.AppliedAt.ToString("dd.MM")
                    </p>
                </div>
            </div>
            <span style="font-size:11px; font-weight:600; padding:4px 12px;
                                     border-radius:20px; white-space:nowrap; flex-shrink:0;
                                     background:@GetBadgeBg(app.Status);
                                     color:@GetBadgeFg(app.Status);">
                @GetStatusText(app.Status)
            </span>
        </a>
                }
            }
        </div>
    </div>

    @* ════════════════════════════════
       ACȚIUNI RAPIDE
    ════════════════════════════════ *@
    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-top:20px;">
        <a href="/employer/jobs/create"
           style="display:flex; align-items:center; gap:14px; background:#fff;
                      border:1px solid #e5e7eb; border-radius:12px; padding:18px 20px;
                      text-decoration:none; color:inherit; transition:border-color 0.15s, box-shadow 0.15s;"
           onmouseover="this.style.borderColor='#c7d2fe'; this.style.boxShadow='0 4px 16px rgba(99,102,241,0.08)'"
           onmouseout="this.style.borderColor='#e5e7eb'; this.style.boxShadow='none'">
            <div style="width:40px; height:40px; background:#f0eeff; border-radius:10px;
                            display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <MudIcon Icon="@Icons.Material.Filled.AddCircle" Style="color:#6366f1; font-size:22px;" />
            </div>
            <div>
                <p style="font-size:14px; font-weight:700; color:#111827; margin:0 0 2px 0;">
                    Anunț nou
                </p>
                <p style="font-size:12px; color:#9ca3af; margin:0;">Publică o ofertă de muncă</p>
            </div>
        </a>

        <a href="/employer/jobs"
           style="display:flex; align-items:center; gap:14px; background:#fff;
                      border:1px solid #e5e7eb; border-radius:12px; padding:18px 20px;
                      text-decoration:none; color:inherit; transition:border-color 0.15s, box-shadow 0.15s;"
           onmouseover="this.style.borderColor='#c7d2fe'; this.style.boxShadow='0 4px 16px rgba(99,102,241,0.08)'"
           onmouseout="this.style.borderColor='#e5e7eb'; this.style.boxShadow='none'">
            <div style="width:40px; height:40px; background:#eff6ff; border-radius:10px;
                            display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <MudIcon Icon="@Icons.Material.Filled.List" Style="color:#3b82f6; font-size:22px;" />
            </div>
            <div>
                <p style="font-size:14px; font-weight:700; color:#111827; margin:0 0 2px 0;">
                    Toate anunțurile
                </p>
                <p style="font-size:12px; color:#9ca3af; margin:0;">Gestionează ofertele tale</p>
            </div>
        </a>

        <a href="/employer/profile"
           style="display:flex; align-items:center; gap:14px; background:#fff;
                      border:1px solid #e5e7eb; border-radius:12px; padding:18px 20px;
                      text-decoration:none; color:inherit; transition:border-color 0.15s, box-shadow 0.15s;"
           onmouseover="this.style.borderColor='#c7d2fe'; this.style.boxShadow='0 4px 16px rgba(99,102,241,0.08)'"
           onmouseout="this.style.borderColor='#e5e7eb'; this.style.boxShadow='none'">
            <div style="width:40px; height:40px; background:#f0fdf4; border-radius:10px;
                            display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <MudIcon Icon="@Icons.Material.Filled.Business" Style="color:#22c55e; font-size:22px;" />
            </div>
            <div>
                <p style="font-size:14px; font-weight:700; color:#111827; margin:0 0 2px 0;">
                    Profilul companiei
                </p>
                <p style="font-size:12px; color:#9ca3af; margin:0;">Editează informațiile</p>
            </div>
        </a>
    </div>
}

<style>
    @@keyframes shimmer {
        0% {
            background-position: -800px 0;
        }

        100% {
            background-position: 800px 0;
        }
    }
</style>

@code {
    private bool _loading = true;

    private List<JobPostingDto> _activeJobs = new();
    private List<ApplicationDto> _recentApplications = new();
    private List<EmploymentConfirmationDto> _pendingConfirmations = new();
    private Dictionary<int, int> _applicationCountByJob = new();
    private DashboardStats _stats = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var jobsTask = Http.GetFromJsonAsync<List<JobPostingDto>>("api/employer/profile/jobs");
            var confirmTask = Http.GetFromJsonAsync<List<EmploymentConfirmationDto>>("api/employment-confirmations/pending");

            await Task.WhenAll(jobsTask, confirmTask);

            var allJobs = jobsTask.Result ?? new();
            _activeJobs = allJobs
                .Where(j => j.Status == JobStatus.Published)
                .OrderByDescending(j => j.PublishedAt)
                .Take(5)
                .ToList();

            _pendingConfirmations = confirmTask.Result ?? new();

            var appTasks = _activeJobs.Select(async job =>
            {
                try
                {
                    var apps = await Http.GetFromJsonAsync<List<ApplicationDto>>($"api/applications/job/{job.Id}");
                    return (job.Id, apps: apps ?? new());
                }
                catch { return (job.Id, apps: new List<ApplicationDto>()); }
            });

            var appResults = await Task.WhenAll(appTasks);

            var allApplications = new List<ApplicationDto>();
            foreach (var (jobId, apps) in appResults)
            {
                _applicationCountByJob[jobId] = apps.Count;
                allApplications.AddRange(apps);
            }

            _recentApplications = allApplications
                .OrderByDescending(a => a.AppliedAt)
                .Take(5)
                .ToList();

            _stats = new DashboardStats
            {
                ActiveJobs = allJobs.Count(j => j.Status == JobStatus.Published),
                TotalApplications = allApplications.Count,
                InReview = allApplications.Count(a => a.Status == ApplicationState.InReview),
                Accepted = allApplications.Count(a => a.Status == ApplicationState.Accepted),
            };
        }
        catch { }
        finally { _loading = false; }
    }

    private static string GetStatusText(ApplicationState s) => s switch
    {
        ApplicationState.Pending => "Nou",
        ApplicationState.InReview => "În analiză",
        ApplicationState.Interview => "Interviu",
        ApplicationState.Accepted => "Acceptat",
        ApplicationState.Rejected => "Respins",
        ApplicationState.Withdrawn => "Retras",
        _ => s.ToString()
    };

    private static string GetBadgeBg(ApplicationState s) => s switch
    {
        ApplicationState.Accepted => "#d1fae5",
        ApplicationState.Rejected => "#fee2e2",
        ApplicationState.Interview => "#dbeafe",
        ApplicationState.InReview => "#fef9c3",
        ApplicationState.Withdrawn => "#f3f4f6",
        _ => "#ede9fe"
    };

    private static string GetBadgeFg(ApplicationState s) => s switch
    {
        ApplicationState.Accepted => "#065f46",
        ApplicationState.Rejected => "#b91c1c",
        ApplicationState.Interview => "#1d4ed8",
        ApplicationState.InReview => "#92400e",
        ApplicationState.Withdrawn => "#6b7280",
        _ => "#4f46e5"
    };

    private class DashboardStats
    {
        public int ActiveJobs { get; set; }
        public int TotalApplications { get; set; }
        public int InReview { get; set; }
        public int Accepted { get; set; }
    }
}
