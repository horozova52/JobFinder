@page "/employer/dashboard"
@layout EmployerLayout

@using JobFinder.Shared.DTOs.Application
@using JobFinder.Shared.DTOs.Jobs
@using JobFinder.Shared.DTOs.Applications
@using JobFinder.Shared.Enums
@using System.Net.Http.Json
@using System.Text.Json

@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Dashboard Angajator - JobFinder</PageTitle>

<PageHeader Title="Dashboard"
            Description="Activitatea companiei tale pe platformă." />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @* ── Statistici ── *@
    <section style="margin-bottom:40px;">
        <h2 style="font-size:14px; font-weight:700; color:#111827; margin-bottom:16px;">
            Statistici
        </h2>
        <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:16px;">
            <div style="border:1px solid #e5e7eb; padding:20px;">
                <p style="font-size:28px; font-weight:700; color:#6366f1; margin:0 0 4px 0;">
                    @_stats.ActiveJobs
                </p>
                <p style="font-size:12px; color:#6b7280; margin:0;">Anunțuri active</p>
            </div>
            <div style="border:1px solid #e5e7eb; padding:20px;">
                <p style="font-size:28px; font-weight:700; color:#3b82f6; margin:0 0 4px 0;">
                    @_stats.TotalApplications
                </p>
                <p style="font-size:12px; color:#6b7280; margin:0;">Total aplicări</p>
            </div>
            <div style="border:1px solid #e5e7eb; padding:20px;">
                <p style="font-size:28px; font-weight:700; color:#f59e0b; margin:0 0 4px 0;">
                    @_stats.InReview
                </p>
                <p style="font-size:12px; color:#6b7280; margin:0;">În analiză</p>
            </div>
            <div style="border:1px solid #e5e7eb; padding:20px;">
                <p style="font-size:28px; font-weight:700; color:#16a34a; margin:0 0 4px 0;">
                    @_stats.Accepted
                </p>
                <p style="font-size:12px; color:#6b7280; margin:0;">Candidați acceptați</p>
            </div>
        </div>
    </section>

    @* ── Anunțuri active ── *@
    <section style="margin-bottom:40px;">
        <div style="display:flex; justify-content:space-between;
                    align-items:center; margin-bottom:16px;">
            <h2 style="font-size:14px; font-weight:700; color:#111827; margin:0;">
                Anunțuri active
            </h2>
            <a href="/employer/jobs"
               style="font-size:12px; font-weight:600; color:#6366f1;
                      text-decoration:none; letter-spacing:0.5px;">
                Gestionează →
            </a>
        </div>

        @if (!_activeJobs.Any())
        {
            <div style="border:1px dashed #e5e7eb; padding:32px; text-align:center;">
                <p style="font-size:14px; color:#6b7280; margin:0 0 12px 0;">
                    Nu ai niciun anunț activ.
                </p>
                <a href="/employer/jobs/create"
                   style="font-size:11px; font-weight:600; color:#6366f1;
                          text-decoration:none; letter-spacing:2px; text-transform:uppercase;">
                    Publică primul anunț →
                </a>
            </div>
        }
        else
        {
            @foreach (var job in _activeJobs)
            {
                <a href="/employer/jobs/@job.Id/applications"
                   style="display:block; border-bottom:1px solid #e5e7eb; padding:20px 16px;
                          margin:0 -16px; text-decoration:none; color:inherit; transition:background 0.15s;"
                   onmouseover="this.style.background='#f9fafb'"
                   onmouseout="this.style.background='transparent'">
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <div>
                            <h3 style="font-size:14px; font-weight:700; color:#111827; margin:0 0 4px 0;">
                                @job.Title
                            </h3>
                            <p style="font-size:13px; color:#6b7280; margin:0;">
                                @(_applicationCountByJob.TryGetValue(job.Id, out var cnt) ? cnt : 0) aplicări
                                @if (job.PublishedAt.HasValue)
                                {
                                    <span> · Publicat @job.PublishedAt.Value.ToString("dd.MM.yyyy")</span>
                                }
                            </p>
                        </div>
                        <StatusBadge Status="Activ" Variant="success" />
                    </div>
                </a>
            }
        }
    </section>

    @* ── Aplicări recente ── *@
    <section style="margin-bottom:40px;">
        <div style="display:flex; justify-content:space-between;
                    align-items:center; margin-bottom:16px;">
            <h2 style="font-size:14px; font-weight:700; color:#111827; margin:0;">
                Aplicări recente
            </h2>
        </div>

        @if (!_recentApplications.Any())
        {
            <p style="font-size:14px; color:#6b7280;">
                Nu există aplicări noi.
            </p>
        }
        else
        {
            @foreach (var app in _recentApplications)
            {
                <a href="/employer/applications/@app.Id"
                   style="display:block; border-bottom:1px solid #e5e7eb; padding:20px 16px;
                          margin:0 -16px; text-decoration:none; color:inherit; transition:background 0.15s;"
                   onmouseover="this.style.background='#f9fafb'"
                   onmouseout="this.style.background='transparent'">
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <div>
                            <h3 style="font-size:14px; font-weight:700; color:#111827; margin:0 0 4px 0;">
                                @app.CandidateFullName
                            </h3>
                            <p style="font-size:13px; color:#6b7280; margin:0;">
                                A aplicat la @app.JobTitle
                                · @app.AppliedAt.ToString("dd.MM.yyyy")
                            </p>
                        </div>
                        <StatusBadge Status="@GetStatusText(app.Status)"
                                     Variant="@GetStatusVariant(app.Status)" />
                    </div>
                </a>
            }
        }
    </section>

    @* ── Confirmări angajare în așteptare ── *@
    @if (_pendingConfirmations.Any())
    {
        <section style="margin-bottom:40px;">
            <h2 style="font-size:14px; font-weight:700; color:#111827; margin-bottom:16px;">
                Confirmări angajare în așteptare
            </h2>
            <div style="border:1px solid #fde68a; background:#fefce8; padding:16px 20px;">
                <p style="font-size:13px; font-weight:600; color:#92400e; margin:0 0 12px 0;">
                    @_pendingConfirmations.Count candidat(i) au confirmat angajarea și așteaptă validarea ta.
                </p>
                @foreach (var conf in _pendingConfirmations)
                {
                    <div style="display:flex; justify-content:space-between;
                                align-items:center; padding:8px 0;
                                border-top:1px solid #fde68a;">
                        <div>
                            <p style="font-size:14px; font-weight:600; color:#111827; margin:0 0 2px 0;">
                                @conf.CandidateFullName
                            </p>
                            <p style="font-size:12px; color:#78350f; margin:0;">
                                @conf.JobTitle · Confirmat pe @conf.ConfirmedAt.ToString("dd.MM.yyyy")
                            </p>
                        </div>
                        <a href="/employer/applications/@conf.ApplicationId"
                           style="font-size:11px; font-weight:600; color:#6366f1;
                                  text-decoration:none; letter-spacing:1px; text-transform:uppercase;">
                            Validează →
                        </a>
                    </div>
                }
            </div>
        </section>
    }
}

@code {
    private bool _loading = true;

    private List<JobPostingDto>     _activeJobs            = new();
    private List<ApplicationDto>    _recentApplications    = new();
    private List<EmploymentConfirmationDto> _pendingConfirmations = new();
    private Dictionary<int, int>    _applicationCountByJob = new();

    private DashboardStats _stats = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // 1. Joburile angajatorului
            var jobsTask = Http.GetFromJsonAsync<List<JobPostingDto>>(
                "api/employer/profile/jobs");

            // 2. Confirmări în așteptare
            var confirmTask = Http.GetFromJsonAsync<List<EmploymentConfirmationDto>>(
                "api/employment-confirmations/pending");

            await Task.WhenAll(jobsTask, confirmTask);

            var allJobs = jobsTask.Result ?? new();
            _activeJobs = allJobs
                .Where(j => j.Status == JobStatus.Published)
                .OrderByDescending(j => j.PublishedAt)
                .Take(5)
                .ToList();

            _pendingConfirmations = confirmTask.Result ?? new();

            // 3. Aplicările pentru fiecare job activ — în paralel
            var appTasks = _activeJobs.Select(async job =>
            {
                try
                {
                    var apps = await Http.GetFromJsonAsync<List<ApplicationDto>>(
                        $"api/applications/job/{job.Id}");
                    return (job.Id, apps: apps ?? new());
                }
                catch { return (job.Id, apps: new List<ApplicationDto>()); }
            });

            var appResults = await Task.WhenAll(appTasks);

            var allApplications = new List<ApplicationDto>();
            foreach (var (jobId, apps) in appResults)
            {
                _applicationCountByJob[jobId] = apps.Count;
                allApplications.AddRange(apps);
            }

            // Aplicări recente — ultimele 5
            _recentApplications = allApplications
                .OrderByDescending(a => a.AppliedAt)
                .Take(5)
                .ToList();

            // Statistici
            _stats = new DashboardStats
            {
                ActiveJobs        = allJobs.Count(j => j.Status == JobStatus.Published),
                TotalApplications = allApplications.Count,
                InReview          = allApplications.Count(a =>
                    a.Status == ApplicationState.InReview),
                Accepted          = allApplications.Count(a =>
                    a.Status == ApplicationState.Accepted),
            };
        }
        catch { }
        finally { _loading = false; }
    }

    private static string GetStatusText(ApplicationState s) => s switch
    {
        ApplicationState.Pending   => "Nou",
        ApplicationState.InReview  => "În analiză",
        ApplicationState.Interview => "Interviu",
        ApplicationState.Accepted  => "Acceptat",
        ApplicationState.Rejected  => "Respins",
        ApplicationState.Withdrawn => "Retras",
        _ => s.ToString()
    };

    private static string GetStatusVariant(ApplicationState s) => s switch
    {
        ApplicationState.Pending   => "default",
        ApplicationState.InReview  => "warning",
        ApplicationState.Interview => "default",
        ApplicationState.Accepted  => "success",
        ApplicationState.Rejected  => "destructive",
        ApplicationState.Withdrawn => "muted",
        _ => "default"
    };

    private class DashboardStats
    {
        public int ActiveJobs        { get; set; }
        public int TotalApplications { get; set; }
        public int InReview          { get; set; }
        public int Accepted          { get; set; }
    }
}