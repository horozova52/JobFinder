@page "/admin/employer-verification"
@layout AdminLayout

@using JobFinder.Shared.DTOs.Admin
@using System.Net.Http.Json

@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Verificare angajatori — JobFinder</PageTitle>

<PageHeader Title="Verificare angajatori"
            Description="Verifică și aprobă conturile angajatorilor noi." />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary"
                       Style="margin-bottom:24px;" />
}
else
{
    <!-- Statistici -->
    <div style="display:grid; grid-template-columns:repeat(3,1fr);
                gap:16px; margin-bottom:32px;">
        <div style="border:1px solid #e5e7eb; padding:16px;">
            <p style="font-size:22px; font-weight:700; color:#d97706; margin:0 0 4px 0;">
                @_pending.Count
            </p>
            <p style="font-size:11px; font-weight:600; color:#9ca3af;
                      letter-spacing:1px; text-transform:uppercase; margin:0;">
                În așteptare
            </p>
        </div>
        <div style="border:1px solid #e5e7eb; padding:16px;">
            <p style="font-size:22px; font-weight:700; color:#059669; margin:0 0 4px 0;">
                @_approvedCount
            </p>
            <p style="font-size:11px; font-weight:600; color:#9ca3af;
                      letter-spacing:1px; text-transform:uppercase; margin:0;">
                Aprobați
            </p>
        </div>
        <div style="border:1px solid #e5e7eb; padding:16px;">
            <p style="font-size:22px; font-weight:700; color:#dc2626; margin:0 0 4px 0;">
                @_rejectedCount
            </p>
            <p style="font-size:11px; font-weight:600; color:#9ca3af;
                      letter-spacing:1px; text-transform:uppercase; margin:0;">
                Respinși în sesiune
            </p>
        </div>
    </div>

    @if (_pending.Count == 0)
    {
        <div style="border:1px solid #d1fae5; background:#f0fdf4;
                    padding:20px; text-align:center;">
            <p style="font-size:14px; color:#065f46; margin:0; font-weight:600;">
                ✓ Niciun angajator în așteptare de verificare.
            </p>
        </div>
    }

    @foreach (var emp in _pending)
    {
        <div style="border-bottom:1px solid #e5e7eb; padding:20px 0;">

            <!-- Header rând -->
            <div style="display:flex; justify-content:space-between;
                        align-items:flex-start; cursor:pointer;"
                 @onclick="() => ToggleExpand(emp.Id)">
                <div>
                    <div style="display:flex; align-items:center; gap:12px; margin-bottom:4px;">
                        <h3 style="font-size:14px; font-weight:700; color:#111827; margin:0;">
                            @emp.CompanyName
                        </h3>
                        <span style="font-size:10px; font-weight:600; padding:2px 8px;
                                     background:#fef9c3; color:#854d0e;
                                     border:1px solid #fde68a; letter-spacing:1px;
                                     text-transform:uppercase; font-family:'Roboto Mono',monospace;">
                            În așteptare
                        </span>
                    </div>
                    <p style="font-size:13px; color:#6b7280; margin:0;">
                        @emp.ContactEmail
                        @if (!string.IsNullOrEmpty(emp.FiscalCode))
                        {
                            <span> · CUI: @emp.FiscalCode</span>
                        }
                        @if (!string.IsNullOrEmpty(emp.Industry))
                        {
                            <span> · @emp.Industry</span>
                        }
                    </p>
                </div>
                <span style="font-size:12px; color:#9ca3af; margin-top:4px;">
                    @(_expandedId == emp.Id ? "▲" : "▼")
                </span>
            </div>

            <!-- Detalii expandate -->
            @if (_expandedId == emp.Id)
            {
                <div style="margin-top:16px; display:flex; flex-direction:column; gap:16px;">

                    <!-- Info companie -->
                    <div style="border:1px solid #e5e7eb; padding:16px;
                                background:#fafafa; display:flex; flex-direction:column; gap:8px;">
                        @if (!string.IsNullOrEmpty(emp.Website))
                        {
                            <p style="font-size:14px; margin:0;">
                                <span style="color:#9ca3af;">Website: </span>@emp.Website
                            </p>
                        }
                        @if (!string.IsNullOrEmpty(emp.Description))
                        {
                            <p style="font-size:14px; margin:0;">
                                <span style="color:#9ca3af;">Descriere: </span>@emp.Description
                            </p>
                        }
                        @if (string.IsNullOrEmpty(emp.Website) &&
                             string.IsNullOrEmpty(emp.Description))
                        {
                            <p style="font-size:13px; color:#9ca3af; margin:0; font-style:italic;">
                                Nicio informație suplimentară furnizată.
                            </p>
                        }
                    </div>

                    <!-- Butoane acțiune -->
                    <div style="display:flex; gap:12px; align-items:flex-end;">
                        <button @onclick="() => Approve(emp)"
                                disabled="@_processing"
                                style="background:#16a34a; color:#fff; border:none;
                                       padding:10px 24px; font-size:11px; font-weight:600;
                                       letter-spacing:2px; text-transform:uppercase;
                                       cursor:pointer;">
                            ✓ Aprobă
                        </button>
                        <input @bind="_rejectReasons[emp.Id]"
                               placeholder="Motiv respingere (opțional)..."
                               style="flex:1; border:1px solid #e5e7eb; background:#fff;
                                      padding:10px 16px; font-size:14px; outline:none;" />
                        <button @onclick="() => Reject(emp)"
                                disabled="@_processing"
                                style="background:#dc2626; color:#fff; border:none;
                                       padding:10px 24px; font-size:11px; font-weight:600;
                                       letter-spacing:2px; text-transform:uppercase;
                                       cursor:pointer;">
                            ✗ Respinge
                        </button>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Angajatori procesați în sesiune -->
    @if (_processed.Count > 0)
    {
        <div style="margin-top:32px;">
            <h2 style="font-size:14px; font-weight:700; color:#9ca3af;
                       letter-spacing:1px; text-transform:uppercase; margin-bottom:16px;">
                Procesați în această sesiune
            </h2>
            @foreach (var item in _processed)
            {
                <div style="border-bottom:1px solid #e5e7eb; padding:14px 0;
                            display:flex; justify-content:space-between; align-items:center;">
                    <p style="font-size:14px; font-weight:600; color:#6b7280; margin:0;">
                        @item.Employer.CompanyName
                    </p>
                    <span style="font-size:10px; font-weight:600; padding:3px 10px;
                                 letter-spacing:1px; text-transform:uppercase;
                                 font-family:'Roboto Mono',monospace;
                                 background:@(item.Approved ? "#d1fae5" : "#fee2e2");
                                 color:@(item.Approved ? "#065f46" : "#b91c1c");
                                 border:1px solid @(item.Approved ? "#6ee7b7" : "#fca5a5");">
                        @(item.Approved ? "Aprobat" : "Respins")
                    </span>
                </div>
            }
        </div>
    }
}

@code {
    private List<AdminEmployerVerificationDto> _pending    = new();
    private List<(AdminEmployerVerificationDto Employer, bool Approved)> _processed = new();
    private Dictionary<int, string> _rejectReasons = new();

    private bool _loading    = true;
    private bool _processing = false;
    private int? _expandedId;

    private int _approvedCount => _processed.Count(p => p.Approved);
    private int _rejectedCount => _processed.Count(p => !p.Approved);

    protected override async Task OnInitializedAsync()
    {
        await LoadPending();
    }

    private async Task LoadPending()
    {
        try
        {
            _loading = true;
            var result = await Http.GetFromJsonAsync<List<AdminEmployerVerificationDto>>(
                "api/admin/employer-verifications");
            if (result != null)
            {
                _pending = result;
                foreach (var emp in _pending)
                    _rejectReasons[emp.Id] = "";
            }
        }
        finally { _loading = false; }
    }

    private void ToggleExpand(int id) =>
        _expandedId = _expandedId == id ? null : id;

    private async Task Approve(AdminEmployerVerificationDto emp)
    {
        _processing = true;
        try
        {
            var resp = await Http.PutAsJsonAsync(
                $"api/admin/employer-verifications/{emp.Id}/approve", new { });

            if (resp.IsSuccessStatusCode)
            {
                _pending.Remove(emp);
                _processed.Add((emp, true));
                _expandedId = null;
                Snackbar.Add($"{emp.CompanyName} a fost aprobat.", Severity.Success);
                StateHasChanged();
            }
            else Snackbar.Add("Eroare la aprobare.", Severity.Error);
        }
        finally { _processing = false; }
    }

    private async Task Reject(AdminEmployerVerificationDto emp)
    {
        _processing = true;
        try
        {
            var reason = _rejectReasons.ContainsKey(emp.Id)
                ? _rejectReasons[emp.Id] : "";

            var resp = await Http.PutAsJsonAsync(
                $"api/admin/employer-verifications/{emp.Id}/reject",
                new { Reason = reason });

            if (resp.IsSuccessStatusCode)
            {
                _pending.Remove(emp);
                _processed.Add((emp, false));
                _expandedId = null;
                Snackbar.Add($"{emp.CompanyName} a fost respins.", Severity.Warning);
                StateHasChanged();
            }
            else Snackbar.Add("Eroare la respingere.", Severity.Error);
        }
        finally { _processing = false; }
    }
}