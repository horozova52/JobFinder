@page "/admin/settings"
@layout AdminLayout

@using System.Net.Http.Json
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Configurări - JobFinder</PageTitle>

<PageHeader Title="Configurări platformă"
            Description="Administrarea securității și politicilor sistemului." />

<!-- Securitate și acces -->
<section style="margin-bottom:40px;">
    <h2 style="font-size:11px; font-weight:700; color:#6b7280; letter-spacing:2px;
               text-transform:uppercase; margin-bottom:16px;
               font-family:'Roboto Mono',monospace;">
        Securitate și acces
    </h2>
    <div style="border:1px solid #e5e7eb;">
        @foreach (var item in _securityItems)
        {
            <div style="display:flex; justify-content:space-between; align-items:center;
                        padding:18px 20px; border-bottom:1px solid #e5e7eb;">
                <div>
                    <p style="font-size:14px; font-weight:600; color:#111827; margin:0 0 3px 0;">
                        @item.Title
                    </p>
                    <p style="font-size:12px; color:#6b7280; margin:0;">@item.Description</p>
                </div>
                <span style="font-size:10px; font-weight:600; padding:4px 12px;
                             background:#d1fae5; color:#065f46; border:1px solid #6ee7b7;
                             letter-spacing:1px; text-transform:uppercase;
                             font-family:'Roboto Mono',monospace; white-space:nowrap;">
                    Activ
                </span>
            </div>
        }
    </div>
</section>

<!-- Statistici sistem live -->
<section style="margin-bottom:40px;">
    <h2 style="font-size:11px; font-weight:700; color:#6b7280; letter-spacing:2px;
               text-transform:uppercase; margin-bottom:16px;
               font-family:'Roboto Mono',monospace;">
        Statistici sistem
    </h2>
    @if (_loadingStats)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:16px;">
            <div style="border:1px solid #e5e7eb; padding:20px;">
                <p style="font-size:24px; font-weight:700; color:#6366f1; margin:0 0 4px 0;">
                    @_stats.TotalUsers
                </p>
                <p style="font-size:11px; color:#9ca3af; text-transform:uppercase;
                          letter-spacing:1px; font-weight:600; margin:0;">
                    Utilizatori înregistrați
                </p>
            </div>
            <div style="border:1px solid #e5e7eb; padding:20px;">
                <p style="font-size:24px; font-weight:700; color:#059669; margin:0 0 4px 0;">
                    @_stats.ActiveJobs
                </p>
                <p style="font-size:11px; color:#9ca3af; text-transform:uppercase;
                          letter-spacing:1px; font-weight:600; margin:0;">
                    Anunțuri active
                </p>
            </div>
            <div style="border:1px solid @(_stats.PendingVerif > 0 ? "#fbbf24" : "#e5e7eb");
                        padding:20px;
                        background:@(_stats.PendingVerif > 0 ? "#fffbeb" : "white");">
                <p style="font-size:24px; font-weight:700;
                          color:@(_stats.PendingVerif > 0 ? "#d97706" : "#6366f1");
                          margin:0 0 4px 0;">
                    @_stats.PendingVerif
                </p>
                <p style="font-size:11px; color:#9ca3af; text-transform:uppercase;
                          letter-spacing:1px; font-weight:600; margin:0;">
                    Angajatori în așteptare
                </p>
            </div>
        </div>
    }
</section>

<!-- Informații tehnice -->
<section style="margin-bottom:40px;">
    <h2 style="font-size:11px; font-weight:700; color:#6b7280; letter-spacing:2px;
               text-transform:uppercase; margin-bottom:16px;
               font-family:'Roboto Mono',monospace;">
        Informații sistem
    </h2>
    <div style="border:1px solid #e5e7eb;">
        @foreach (var info in _techInfo)
        {
            <div style="display:flex; justify-content:space-between; align-items:center;
                        padding:14px 20px; border-bottom:1px solid #e5e7eb;">
                <p style="font-size:13px; color:#6b7280; margin:0;">@info.Key</p>
                <p style="font-size:13px; font-weight:600; color:#111827; margin:0;
                          font-family:'Roboto Mono',monospace;">
                    @info.Value
                </p>
            </div>
        }
    </div>
</section>

<!-- GDPR -->
<section>
    <h2 style="font-size:11px; font-weight:700; color:#6b7280; letter-spacing:2px;
               text-transform:uppercase; margin-bottom:16px;
               font-family:'Roboto Mono',monospace;">
        Conformitate GDPR
    </h2>
    <div style="border:1px solid #e5e7eb; padding:20px;">
        <p style="font-size:14px; color:#374151; line-height:1.75; margin:0;">
            Platforma respectă prevederile <strong>Legii nr. 133/2011</strong> privind
            protecția datelor personale și principiile
            <strong>Regulamentului (UE) 2016/679 (GDPR)</strong>.
            Datele utilizatorilor sunt stocate criptat, accesul este restricționat
            pe baza rolurilor, iar comunicațiile sunt securizate prin HTTPS.
            Fiecare utilizator are acces exclusiv la datele asociate rolului său.
        </p>
    </div>
</section>

@code {
    private bool _loadingStats = true;
    private (int TotalUsers, int ActiveJobs, int PendingVerif) _stats;

    private readonly List<(string Title, string Description)> _securityItems = new()
    {
        ("Verificare angajatori obligatorie",
         "Angajatorii noi trebuie aprobați de admin înainte să publice anunțuri."),
        ("Autentificare bazată pe cookie-uri",
         "Sesiunile sunt gestionate prin cookie-uri HttpOnly securizate."),
        ("Protecție CSRF",
         "Tokenuri antiforgery pentru toate operațiile de scriere."),
        ("Control acces bazat pe roluri (RBAC)",
         "Roluri distincte: Candidate, Employer, Admin — cu permisiuni strict delimitate."),
        ("Hashing parole",
         "Parolele sunt stocate folosind algoritmi de hashing cu salt (ASP.NET Core Identity)."),
        ("Comunicații HTTPS",
         "Tot traficul dintre client și server este criptat prin HTTPS."),
    };

    private readonly List<(string Key, string Value)> _techInfo = new()
    {
        ("Backend",          "ASP.NET Core 9"),
        ("Frontend",         "Blazor WebAssembly"),
        ("Baza de date",     "SQL Server + EF Core 9"),
        ("Autentificare",    "ASP.NET Core Identity"),
        ("Mesagerie",        "SignalR"),
        ("Arhitectura",      "Clean Architecture + CQRS + MediatR"),
        ("ORM",              "Entity Framework Core 9"),
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<StatsResponse>("api/admin/stats");
            if (result != null)
                _stats = (result.TotalUsers, result.ActiveJobs, result.PendingVerif);
        }
        finally { _loadingStats = false; }
    }

    private class StatsResponse
    {
        public int TotalUsers   { get; set; }
        public int ActiveJobs   { get; set; }
        public int PendingVerif { get; set; }
    }
}
